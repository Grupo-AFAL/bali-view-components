<!DOCTYPE html>
<html data-theme="<%= bali_theme %>">
  <head>
    <% content_for(:title) { "#{t('app.name')} Admin" } %>
    <%= render "layouts/head" %>
  </head>
  <%= render Bali::AppLayout::Component.new(fixed_sidebar: true, flash: flash) do |layout| %>
    <% layout.with_sidebar do %>
      <%= render 'layouts/admin_sidebar' %>
    <% end %>

    <% layout.with_topbar do %>
      <%= render 'layouts/admin_topbar' %>
    <% end %>

    <% layout.with_body do %>
      <%= yield %>
    <% end %>
  <% end %>

  <%# On every admin page because `drawer-broadcast.cy.js` needs it beside AppLayout's drawer.
      It talks to this app's stand-ins for Opina unless OPINA_URL names a running one. %>
  <%= render Bali::FeedbackWidget::Component.new(
    project_slug: "bali-demo",
    opina_url: ENV.fetch("OPINA_URL") { request.base_url },
    secret: "dev-shared-secret",
    user_id: 1,
    email: "demo@example.com"
  ) %>
</html>
