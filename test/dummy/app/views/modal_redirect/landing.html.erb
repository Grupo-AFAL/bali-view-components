<%# Where the redirect lands. The marker is what the spec asserts the document
    actually became, rather than trusting the URL alone. %>
<div class="p-8 space-y-4" id="modal-redirect-landing">
  <h1 class="text-2xl font-bold">Modal redirect landing</h1>

  <%= render Bali::Link::Component.new(
        name: 'User details',
        href: '/drawers/user_details',
        drawer: true,
        id: 'landing-drawer-trigger') %>
</div>
