<%# Close modal by replacing with empty modal %>
<%= turbo_stream.replace 'main-modal' do %>
  <%= render Bali::Modal::Component.new(active: false, id: 'main-modal') %>
<% end %>

<%# Update the characters list %>
<%= turbo_stream.replace 'characters-list' do %>
  <%= render partial: 'movies/characters_list', locals: { movie: @movie, characters: @movie.characters.reload.positioned } %>
<% end %>

<%# Show success notification %>
<%= turbo_stream.prepend 'flash-messages' do %>
  <%= render Bali::Toast::Component.new(color: :success, class: 'mb-4') do %>
    Character "<%= @character.name %>" added successfully!
  <% end %>
<% end %>
