<%# The per-kind detail a host writes in place of Bali's generic one: `item` is the
    Bali::Inbox::Item, `item.record` the Task. %>
<div class="dummy-task-detail flex flex-col gap-3">
  <p class="text-sm text-base-content/70"><%= item.record.project.name %></p>
  <h2 class="text-lg font-semibold"><%= item.title %></h2>
  <% if item.record.description.present? %>
    <p><%= item.record.description %></p>
  <% end %>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="text-base-content/70">Status</dt><dd><%= item.record.status.humanize %></dd>
    <dt class="text-base-content/70">Priority</dt><dd><%= item.record.priority.humanize %></dd>
  </dl>
</div>
