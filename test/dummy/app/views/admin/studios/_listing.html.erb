<%# The listing, shared by index.html.erb and by the create/update streams: the drawer
    replaces EXACTLY this node, so both branches have to produce the same DOM.

    The DataTable goes in bare: the surface travels with its content slot. %>
<%= render Bali::DataTable::Component.new(
  filter_form: @filter_form,
  url: admin_studios_path,
  pagy: @pagy,
  item_name: t('studios.title').downcase
) do |data_table| %>
  <%# `search:` travels the same path in both filter modes. %>
  <% data_table.with_simple_filters(search: { placeholder: t('studios.search_placeholder') }) %>

  <%# Saved views: NAMED filter combinations. Without `url:` it points at the mounted
      engine's routes (/bali); the store and the owner come from the FilterForm.

      CAREFUL (#823): here the view saves the grouping, the columns and the quick search, but
      NOT the narrowing done by the simple filters — `current_view_payload` does not represent
      them. Left in on purpose: it is the surface the simplified index has to exercise, and
      hiding it would go back to covering up the defect instead of fixing it. %>
  <% data_table.with_saved_views %>

  <%# The indexes start at 0 because this table is NOT `selectable:` — in /admin/movies index
      0 is the selection column the component paints, which is why it starts at 1 there. The
      actions one is left out on purpose: hiding it leaves the rows without their ⋯. %>
  <% data_table.with_column_selector do |cs| %>
    <% cs.with_column(index: 0, label: t('studios.columns.name')) %>
    <% cs.with_column(index: 1, label: t('studios.columns.country')) %>
    <% cs.with_column(index: 2, label: t('studios.columns.status')) %>
    <% cs.with_column(index: 3, label: t('studios.columns.size')) %>
    <% cs.with_column(index: 4, label: t('studios.columns.founded')) %>
  <% end %>

  <% data_table.with_table do %>
    <%# `table` and not `t`: the block variable shadows the i18n helper, and the six
        `t(...)` calls in here survive only because they carry parentheses.

        `group_counts` is what makes the group header show the GLOBAL total over the
        filtered set, and not just what landed on this page. %>
    <%= render Bali::Table::Component.new(form: @filter_form,
                                          group_counts: @filter_form.group_counts) do |table| %>
      <% table.with_header(name: t('studios.columns.name'), sort: :name) %>
      <% table.with_header(name: t('studios.columns.country'), sort: :country) %>
      <% table.with_header(name: t('studios.columns.status'), sort: :status) %>
      <% table.with_header(name: t('studios.columns.size'), sort: :size) %>
      <% table.with_header(name: t('studios.columns.founded'), sort: :founded_year) %>
      <%# `class: 'text-right'` and not `align:`, which the component does not declare and
          comes out as the obsolete HTML attribute `<th align="right">`. %>
      <% table.with_header(name: t('studios.columns.actions'), class: 'text-right') %>

      <% @studios.each do |studio| %>
        <%# `group_value_for` returns the band's RAW key —the one that has to match
            `group_counts`— and `nil` when the grouping is off OR suspended. %>
        <% table.with_row(group: @filter_form.group_value_for(studio)) do %>
          <td class="font-medium">
            <%= render Bali::Link::Component.new(
              name: studio.name,
              href: admin_studio_path(studio),
              data: { action: 'modal#open', modal_size: 'lg' }
            ) %>
          </td>
          <%# `Studio` only validates `name`, and the drawer on this same page allows creating
              one with no country and no status: a bare `.humanize` left the index at 500
              (#834). A missing value is painted as a dash — that IS the data, not an empty tag. %>
          <td>
            <% if studio.country.present? %>
              <%= render Bali::Tag::Component.new(text: studio.country, size: :sm, style: :outline) %>
            <% else %>
              <span class="text-base-content/40">&mdash;</span>
            <% end %>
          </td>
          <td>
            <% if studio.status.present? %>
              <%= render Bali::Tag::Component.new(
                text: studio.status.humanize,
                color: studio.status_color,
                size: :sm
              ) %>
            <% else %>
              <span class="text-base-content/40">&mdash;</span>
            <% end %>
          </td>
          <td><%= studio.size&.humanize %></td>
          <td><%= studio.founded_year %></td>
          <td>
            <div class="flex justify-end">
              <%= render Bali::ActionsDropdown::Component.new(align: :end, popover: true) do |dropdown| %>
                <% dropdown.with_item(name: t('studios.actions.view'), href: admin_studio_path(studio), icon: 'eye', data: { action: 'modal#open', modal_size: 'lg' }) %>
                <% dropdown.with_item(name: t('studios.actions.edit'), href: edit_admin_studio_path(studio), icon: 'pencil', data: { action: 'drawer#open', drawer_size: 'lg' }) %>
                <% dropdown.with_item(
                  name: t('studios.actions.delete'),
                  href: admin_studio_path(studio),
                  icon: 'trash-2',
                  method: :delete,
                  data: { turbo_confirm: t('studios.confirm_delete', name: studio.name) },
                  class: 'text-error'
                ) %>
              <% end %>
            </div>
          </td>
        <% end %>
      <% end %>

      <%# The component's EmptyState already tells "No Records" from "No Results" depending
          on whether there are active filters; the only thing it is missing is where to go
          when the table is genuinely empty. %>
      <% table.with_new_record_link(
        name: t('studios.new_studio'),
        href: new_admin_studio_path,
        modal: false,
        data: { action: 'drawer#open', drawer_size: 'lg' }
      ) %>
    <% end %>
  <% end %>
<% end %>
