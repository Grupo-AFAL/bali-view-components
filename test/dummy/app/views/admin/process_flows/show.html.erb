<%# The reference host page of Bali::BpmnEditor: the page header and its
    actions belong to the host, the editor below is one render call. %>
<% content_for :head do %>
  <%= react_island_meta_tags('bpmn-editor', js: 'bpmn-editor-island.js', css: 'bpmn-editor-island.css') %>
<% end %>
<%= render Bali::PageHeader::Component.new(title: @flow.name) do %>
  <%= render Bali::Link::Component.new(name: "Full page", href: edit_admin_process_flow_path(@flow), variant: :ghost, size: :sm) %>
<% end %>
<%= render Bali::BpmnEditor::Component.new(
      data: @flow.to_diagram,
      editable: true,
      palette: :analytic,
      urls: {
        save: admin_process_flow_diagram_path(@flow),
        diagram: admin_process_flow_diagram_path(@flow),
        finalize: admin_process_flow_finalization_path(@flow),
        references: admin_process_flow_references_path(@flow),
        new_reference: new_admin_process_flow_reference_path(@flow),
        lane_assignees: admin_process_flow_lane_assignees_path(@flow),
        new_lane_assignee: new_admin_process_flow_lane_assignee_path(@flow)
      },
      id: dom_id(@flow, :bpmn)) %>
