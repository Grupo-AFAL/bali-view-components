<%# La referencia del índice SIMPLIFICADO: misma línea de diseño que /admin/movies, y la
    única diferencia deliberada es el tipo de filtro — `with_simple_filters` acá,
    `with_filters_panel` allá. Todo lo demás (subtítulo, tamaño del botón primario, export
    en el ⋯, empty state, columnas ordenables) tiene que coincidir, o las dos páginas
    enseñan dos convenciones distintas para lo mismo. %>
<%= render Bali::IndexPage::Component.new(
  title: t('studios.title'),
  subtitle: t('studios.subtitle'),
  breadcrumbs: [
    { name: t('navbar.dashboard'), href: root_path, icon: 'home' },
    { name: t('studios.title') }
  ]
) do |page| %>
  <%# Sin `size:`: el ⋯ del PageHeader dejó de ser `btn-sm` para igualar altura con la
      acción primaria, así que achicar la primaria devuelve el desfase que eso resolvió. %>
  <% page.with_action do %>
    <%= render Bali::Link::Component.new(
      name: t('studios.new_studio'),
      href: new_studio_path,
      variant: :primary,
      icon: 'plus',
      data: { action: 'drawer#open', drawer_size: 'lg' }
    ) %>
  <% end %>

  <%# `formats: [:csv]` y no los tres del default: el controller solo responde CSV, y un
      item que devuelve 406 en una página de referencia enseña la trampa en vez del arreglo. %>
  <% page.with_export(url: studios_path, formats: [:csv]) %>

  <% page.with_body do %>
    <%= render 'listing' %>
  <% end %>
<% end %>
