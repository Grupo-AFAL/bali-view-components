<%# El listado, compartido por index.html.erb y por los streams de create/update: el drawer
    reemplaza EXACTAMENTE este nodo, así que las dos ramas tienen que producir el mismo DOM.

    El DataTable entra pelado: la superficie viaja con su slot de contenido. %>
<%= render Bali::DataTable::Component.new(
  filter_form: @filter_form,
  url: studios_path,
  pagy: @pagy,
  item_name: t('studios.title').downcase
) do |data_table| %>
  <%# El `search:` viaja por el mismo camino en los dos modos de filtro. %>
  <% data_table.with_simple_filters(search: { placeholder: t('studios.search_placeholder') }) %>

  <% data_table.with_table do %>
    <%# `table` y no `t`: la variable del bloque sombrea al helper de i18n, y las seis
        llamadas a `t(...)` de acá adentro sobreviven solo porque llevan paréntesis. %>
    <%= render Bali::Table::Component.new(form: @filter_form) do |table| %>
      <% table.with_header(name: t('studios.columns.name'), sort: :name) %>
      <% table.with_header(name: t('studios.columns.country'), sort: :country) %>
      <% table.with_header(name: t('studios.columns.status'), sort: :status) %>
      <% table.with_header(name: t('studios.columns.size'), sort: :size) %>
      <% table.with_header(name: t('studios.columns.founded'), sort: :founded_year) %>
      <%# `class: 'text-right'` y no `align:`, que el componente no declara y sale como el
          atributo HTML obsoleto `<th align="right">`. %>
      <% table.with_header(name: t('studios.columns.actions'), class: 'text-right') %>

      <% @studios.each do |studio| %>
        <% table.with_row do %>
          <td class="font-medium">
            <%= render Bali::Link::Component.new(
              name: studio.name,
              href: studio_path(studio),
              data: { action: 'modal#open', modal_size: 'lg' }
            ) %>
          </td>
          <td>
            <%= render Bali::Tag::Component.new(text: studio.country, size: :sm, style: :outline) %>
          </td>
          <td>
            <%= render Bali::Tag::Component.new(
              text: studio.status.humanize,
              color: studio.status_color,
              size: :sm
            ) %>
          </td>
          <td><%= studio.size&.humanize %></td>
          <td><%= studio.founded_year %></td>
          <td>
            <div class="flex justify-end">
              <%= render Bali::ActionsDropdown::Component.new(align: :end, popover: true) do |dropdown| %>
                <% dropdown.with_item(name: t('studios.actions.view'), href: studio_path(studio), icon: 'eye', data: { action: 'modal#open', modal_size: 'lg' }) %>
                <% dropdown.with_item(name: t('studios.actions.edit'), href: edit_studio_path(studio), icon: 'pencil', data: { action: 'drawer#open', drawer_size: 'lg' }) %>
                <% dropdown.with_item(
                  name: t('studios.actions.delete'),
                  href: studio_path(studio),
                  icon: 'trash',
                  method: :delete,
                  data: { turbo_confirm: t('studios.confirm_delete', name: studio.name) },
                  class: 'text-error'
                ) %>
              <% end %>
            </div>
          </td>
        <% end %>
      <% end %>

      <%# El EmptyState del componente ya distingue "sin registros" de "sin resultados"
          según haya filtros activos; lo único que le falta es a dónde ir cuando la tabla
          está vacía de verdad. %>
      <% table.with_new_record_link(
        name: t('studios.new_studio'),
        href: new_studio_path,
        modal: false,
        data: { action: 'drawer#open', drawer_size: 'lg' }
      ) %>
    <% end %>
  <% end %>
<% end %>
