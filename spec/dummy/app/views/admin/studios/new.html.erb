<%# El mismo render sirve la página completa y el drawer: FormPage autodetecta el contexto y
    se queda sin Card, sin breadcrumbs y sin botón de volver cuando la trae el drawer. %>
<%= render Bali::FormPage::Component.new(
  title: t('studios.form.new_title'),
  breadcrumbs: [
    { name: t('navbar.dashboard'), href: admin_root_path, icon_name: 'home' },
    { name: t('studios.title'), href: admin_studios_path },
    { name: t('studios.form.new_breadcrumb') }
  ],
  back: { href: admin_studios_path }
) do |page| %>
  <% page.with_body do %>
    <%= render 'form', studio: @studio, drawer: page.drawer? %>
  <% end %>
<% end %>
