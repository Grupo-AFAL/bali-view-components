<%# La composición canónica del listado, compartida por index.html.erb y
    index.turbo_stream.erb. El stream reemplaza EXACTAMENTE este nodo (el que lleva el
    controlador de selección), así que las dos ramas tienen que producir el mismo DOM;
    cuando eran dos copias, divergían en silencio.

    El DataTable entra pelado: la superficie viaja con su slot de contenido. %>
<%= render Bali::DataTable::Component.new(
  filter_form: @filter_form,
  url: admin_movies_path,
  pagy: @pagy,
  item_name: t('movies.title').downcase,
  display_mode: params[:view]
) do |data_table| %>

  <%# Filtros + búsqueda: todo se auto-configura desde @filter_form %>
  <% data_table.with_filters_panel(
    available_attributes: movie_filter_attributes,
    search: { placeholder: t('movies.search_placeholder') }
  ) %>

  <%# Cada vista declara su `value:` (lo que viaja en ?view=) y el DataTable arma el href
      preservando filtros, orden, agrupación y la vista guardada aplicada. %>
  <% data_table.with_view_switch do |switch| %>
    <% switch.with_view(name: t('movies.views.table'), icon: 'list', value: :table) %>
    <% switch.with_view(name: t('movies.views.cards'), icon: 'grid-2x2', value: :grid) %>
    <% switch.with_view(name: t('movies.views.calendar'), icon: 'calendar', value: :calendar) %>
  <% end %>

  <%# Vistas guardadas: combinaciones de filtros CON NOMBRE. Sin `url:` apunta a las rutas
      del engine montado (/bali), que es la adopción de una línea que documenta la guía; el
      store y el dueño los trae el FilterForm. %>
  <% data_table.with_saved_views %>

  <%# El selector de columnas solo tiene sentido sobre la tabla: las tarjetas y el
      calendario no tienen columnas que esconder. La 0 es la de selección, que pinta el
      propio componente, por eso la lista arranca en 1. %>
  <% if data_table.display_mode == :table %>
    <% data_table.with_column_selector do |cs| %>
      <% cs.with_column(index: 1, label: t('movies.columns.name')) %>
      <% cs.with_column(index: 2, label: t('movies.columns.genre')) %>
      <% cs.with_column(index: 3, label: t('movies.columns.status')) %>
      <% cs.with_column(index: 4, label: t('movies.columns.studio')) %>
      <% cs.with_column(index: 5, label: t('movies.columns.indie')) %>
      <% cs.with_column(index: 6, label: t('movies.columns.created')) %>
    <% end %>
  <% end %>

  <%# Fila contextual que reemplaza la toolbar mientras haya selección. `bulk_action` viaja
      en el query string porque cada acción es su propio form y su único hidden es
      `selected_ids`. %>
  <% data_table.with_bulk_actions do |bulk| %>
    <% bulk.with_action(label: t('movies.bulk_actions.mark_done'),
                        href: admin_movies_bulk_actions_path(bulk_action: 'mark_done'),
                        variant: :success) %>
    <% bulk.with_action(label: t('movies.bulk_actions.mark_draft'),
                        href: admin_movies_bulk_actions_path(bulk_action: 'mark_draft'),
                        variant: :warning) %>
    <% bulk.with_action(label: t('movies.bulk_actions.delete'),
                        href: admin_movies_bulk_actions_path(bulk_action: 'delete'),
                        variant: :error) %>
  <% end %>

  <%# UNA sola banda de contenido: declarar dos levanta DuplicateContent. %>
  <% case data_table.display_mode %>
  <% when :grid %>
    <%# Sin superficie: las tarjetas YA son la superficie. %>
    <% data_table.with_grid do %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @movies.each do |movie| %>
          <%= render Bali::Card::Component.new(style: :bordered, class: 'hover:shadow-md transition-shadow') do |card| %>
            <% card.with_title(movie.name, class: 'text-base') %>
            <div class="flex flex-wrap gap-2">
              <%= render Bali::Tag::Component.new(text: movie.genre, style: :outline, size: :sm) %>
              <%= render Bali::Tag::Component.new(text: movie.status.humanize,
                                                  color: movie.status_color, size: :sm) %>
              <% if movie.indie %>
                <%= render Bali::Tag::Component.new(text: t('movies.columns.indie'),
                                                    color: :secondary, size: :sm) %>
              <% end %>
            </div>
            <p class="text-sm text-base-content/60"><%= movie.studio&.name || '—' %></p>
            <% card.with_action(href: admin_movie_path(movie), class: 'btn-ghost btn-sm') do %>
              <%= t('movies.actions.view') %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% when :calendar %>
    <%# El tercer modo es justo para lo que existe `with_content`: una superficie que el
        DataTable no conoce. Un Calendar trae su propia card Y su propio scroll horizontal,
        así que no le pide ninguna de las dos al slot — al revés que `with_table`, que pide
        las dos. Que las dos perillas sean independientes es la razón de que el slot
        genérico las reciba por separado.

        El header entra sin `route_path:`: pinta el mes y ningún prev/next, porque navegar
        de mes metería un segundo query string compitiendo con el que ya son los filtros,
        el orden y el propio view switch. %>
    <% data_table.with_content(surface: false) do %>
      <%= render Bali::Calendar::Component.new(
        events: @movies,
        start_attribute: :production_starts_on,
        end_attribute: :production_ends_on,
        start_date: Date.current,
        period: :month,
        show_date: true,
        template: 'movies/calendar_day'
      ) do |calendar| %>
        <% calendar.with_header(period_switch: false) %>
      <% end %>
    <% end %>
  <% else %>
    <%# La superficie y el scroll horizontal los trae with_table. %>
    <% data_table.with_table do %>
      <%# `group_counts` es lo que hace que el encabezado de grupo muestre el total GLOBAL
          sobre el set filtrado, no solo lo que entró en la página. %>
      <%= render Bali::Table::Component.new(form: @filter_form, selectable: true,
                                            group_counts: @filter_form.group_counts) do |table| %>
        <% table.with_header(name: t('movies.columns.name'), sort: :name) %>
        <% table.with_header(name: t('movies.columns.genre'), sort: :genre) %>
        <% table.with_header(name: t('movies.columns.status'), sort: :status) %>
        <%# `studio_name` es el camino Ransack por la asociación (`belongs_to :studio`), no
            el alias `tenant`, que Ransack no puede ver. %>
        <% table.with_header(name: t('movies.columns.studio'), sort: :studio_name) %>
        <% table.with_header(name: t('movies.columns.indie'), sort: :indie, class: 'text-center') %>
        <% table.with_header(name: t('movies.columns.created'), sort: :created_at) %>
        <%# La columna de acciones va nombrada y alineada con `class:`. Un `<th>` vacío deja la
            columna sin nombre accesible, y `align:` no existe en el componente: sale como el
            atributo HTML obsoleto `<th align="right">`. %>
        <% table.with_header(name: t('movies.columns.actions'), class: 'text-right w-12') %>

        <% @movies.each do |movie| %>
          <%# `select_label:` da contexto de registro al checkbox de la fila: sin él, N filas
              dan N controles con el mismo nombre accesible. El valor del grupo tiene que
              coincidir con una clave de group_counts; nil cuando la agrupación está apagada
              O suspendida (de ahí `group_by_applied` y no `group_by`). %>
          <% applied_group = @filter_form.group_by_applied %>
          <% table.with_row(record_id: movie.id, select_label: movie.name,
                            group: applied_group && movie.public_send(applied_group)) do %>
            <td class="font-medium">
              <%= render Bali::Link::Component.new(name: movie.name, href: admin_movie_path(movie)) %>
            </td>
            <td>
              <%= render Bali::Tag::Component.new(text: movie.genre, style: :outline, size: :sm) %>
            </td>
            <td>
              <%= render Bali::Tag::Component.new(text: movie.status.humanize,
                                                  color: movie.status_color, size: :sm) %>
            </td>
            <td class="text-sm text-base-content/70"><%= movie.studio&.name || '—' %></td>
            <td class="text-center">
              <%= render Bali::BooleanIcon::Component.new(value: movie.indie) %>
            </td>
            <td class="text-sm text-base-content/70">
              <%= render Bali::Timeago::Component.new(movie.created_at, add_suffix: true) %>
            </td>
            <td>
              <div class="flex justify-end">
                <%= render Bali::ActionsDropdown::Component.new(align: :end, popover: true) do |dropdown| %>
                  <% dropdown.with_item(href: admin_movie_path(movie), icon: 'eye') { t('movies.actions.view') } %>
                  <% dropdown.with_item(href: edit_admin_movie_path(movie), icon: 'pencil') { t('movies.actions.edit') } %>
                  <%# Borrar sin confirmar es lo que la página de referencia NO puede enseñar. %>
                  <% dropdown.with_item(
                    href: admin_movie_path(movie),
                    method: :delete,
                    icon: 'trash',
                    data: { turbo_confirm: t('movies.show.confirm_delete', name: movie.name) },
                    class: 'text-error'
                  ) { t('movies.actions.delete') } %>
                <% end %>
              </div>
            </td>
          <% end %>
        <% end %>

        <%# El EmptyState del componente ya distingue "sin registros" de "sin resultados" según
            haya filtros activos; el Alert que estaba acá se saltaba esa distinción y dejaba el
            mismo texto en los dos casos. Lo único que le falta es a dónde ir. %>
        <% table.with_new_record_link(name: t('movies.new_movie'), href: new_admin_movie_path, modal: false) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
