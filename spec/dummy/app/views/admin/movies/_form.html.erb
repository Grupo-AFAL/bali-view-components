<%# Admin Movie Form - Reference Implementation for Bali FormBuilder %>
<%# Showcases: FormBuilder fields, submit_group, BlockEditor (JSON round-trip), DirectUpload %>

<%# Form Progress Stepper %>
<%= render Bali::Stepper::Component.new(current: 0, color: :primary, class: 'mb-8 w-full') do |stepper| %>
  <% stepper.with_step(title: t('movies.form.stepper.basic_info')) %>
  <% stepper.with_step(title: t('movies.form.stepper.poster')) %>
  <% stepper.with_step(title: t('movies.form.stepper.details')) %>
  <% stepper.with_step(title: t('movies.form.stepper.settings')) %>
<% end %>

<%= form_with model: [:admin, movie], builder: Bali::FormBuilder, class: 'space-y-8' do |f| %>
  <%# Los errores del modelo, arriba y una sola vez. Sin esto un 422 sólo los pinta campo por
      campo, y en un formulario de cuatro secciones la primera pantalla no dice que algo falló. %>
  <%= f.error_summary %>

  <%# Las cuatro Cards son deliberadas, y por eso el FormPage entra con `card: false`: esto es
      un catálogo de cuatro secciones con su Stepper, no la superficie única que FormPage arma
      por default. /studios es la otra forma, la corta, y sí usa el default. Dos largos
      distintos, dos formas legítimas. %>
  <%# Section 1: Basic Information %>
  <%= render Bali::Card::Component.new(style: :bordered) do %>
    <h3 class="card-title text-lg mb-4">
      <%= render Bali::Icon::Component.new('film', class: 'mr-2') %>
      <%= t('movies.form.basic_info') %>
    </h3>

    <%= render Bali::Columns::Component.new(cols: 1, cols_md: 2, gap: :lg) do %>
      <%# Text Field %>
      <%= f.text_group :name, label: t('movies.form.movie_title'), required: true, placeholder: t('movies.form.enter_title') %>

      <%# Select Field - Genre %>
      <% genres = Movie::GENRES.map { |g| [g, g] } %>
      <%= f.select_group :genre, genres, include_blank: t('movies.form.select_genre'), html: { label: t('movies.form.genre') } %>

      <%# Select Field - Studio %>
      <% studios = Tenant.order(:name).pluck(:name, :id) %>
      <%= f.select_group :tenant_id, studios, include_blank: t('movies.form.select_studio'), html: { label: t('movies.form.studio') } %>

      <%# Radio Field - Status %>
      <% statuses = Movie.statuses.keys.map { |s| [s.humanize, s] } %>
      <%= f.radio_group :status, statuses, label: t('movies.form.status'), html: { orientation: :horizontal, color: :primary } %>
    <% end %>

    <%# Switch Field - Indie %>
    <div class="mt-4">
      <%= f.switch_group :indie, text: t('movies.form.indie_film'), color: :primary %>
    </div>
  <% end %>

  <%# Section 2: Movie Details %>
  <%= render Bali::Card::Component.new(style: :bordered) do %>
    <h3 class="card-title text-lg mb-4">
      <%= render Bali::Icon::Component.new('file-text', class: 'mr-2') %>
      <%= t('movies.form.movie_details') %>
    </h3>

    <%# Text Area %>
    <%= f.text_area_group :synopsis, label: t('movies.form.synopsis'), rows: 4, placeholder: t('movies.form.enter_synopsis'), char_counter: { max: 500 }, help: t('movies.form.synopsis_help') %>

    <%# Block Editor - Rich Description with JSON round-trip.
        Por el FormBuilder y no por el componente: `block_editor_group` arma el `<legend>`, el
        `input_name` y el valor inicial desde el modelo. La etiqueta escrita a mano que estaba
        acá era el único control del formulario de referencia sin su grupo.
        `size: :sm` viaja del helper al componente — la vía que #1076 destapó. %>
    <div class="mt-4">
      <%= f.block_editor_group :rich_description,
            label: t('movies.form.rich_description'),
            format: :json,
            editable: true,
            size: :sm,
            placeholder: t('movies.form.enter_rich_description') %>
    </div>

    <%= render Bali::Columns::Component.new(cols: 1, cols_md: 2, gap: :lg, class: 'mt-4') do %>
      <%# Date Field %>
      <%= f.date_group :release_date, label: t('movies.form.release_date') %>

      <%# Number Field (Currency) %>
      <%= f.currency_group :budget, label: t('movies.form.budget'), currency: 'USD', placeholder: '0.00' %>

      <%# Email Field %>
      <%= f.email_group :contact_email, label: t('movies.form.contact_email'), placeholder: 'producer@studio.com' %>

      <%# URL Field %>
      <%= f.url_group :website_url, label: t('movies.form.website_url'), placeholder: 'https://moviewebsite.com' %>
    <% end %>
  <% end %>

  <%# Section 3: Media Upload (DirectUpload Demo) %>
  <%= render Bali::Card::Component.new(style: :bordered) do %>
    <h3 class="card-title text-lg mb-4">
      <%= render Bali::Icon::Component.new('image', class: 'mr-2') %>
      <%= t('movies.form.movie_poster') %>
    </h3>

    <%= render Bali::Alert::Component.new(color: :info, class: 'mb-4') do %>
      <%= t('movies.form.direct_upload_info') %>
    <% end %>

    <%# Igual que el editor: por el grupo del FormBuilder, que es el que trae el `<legend>` y
        los mensajes de error del campo. %>
    <%= f.direct_upload_group :poster,
          label: t('movies.form.movie_poster'),
          accept: 'image/*',
          max_file_size: 5,
          drop_zone: true,
          auto_upload: true %>
  <% end %>

  <%# Section 4: Additional Settings %>
  <%= render Bali::Card::Component.new(style: :bordered) do %>
    <h3 class="card-title text-lg mb-4">
      <%= render Bali::Icon::Component.new('settings', class: 'mr-2') %>
      <%= t('movies.form.additional_settings') %>
    </h3>

    <%= render Bali::Columns::Component.new(cols: 1, cols_md: 2, gap: :lg) do %>
      <%# Time Zone Select %>
      <%= f.time_zone_select_group :time_zone, nil, include_blank: t('movies.form.select_timezone'), html: { label: t('movies.form.timezone') } %>

      <%# Rating (Number with step) %>
      <%= f.number_group :rating, label: t('movies.form.initial_rating'), min: 0, max: 10, step: 0.5, placeholder: '0.0' %>
    <% end %>

    <%# Info Message %>
    <div class="mt-4">
      <%= render Bali::Alert::Component.new(color: :info) do %>
        <%= t('movies.form.required_fields_note') %>
      <% end %>
    </div>
  <% end %>

  <%# Form Actions - Using submit_group for reference implementation %>
  <%= f.submit_group(
    movie.persisted? ? t('movies.form.update_movie') : t('movies.form.create_movie'),
    cancel_path: admin_movies_path,
    variant: :primary
  ) %>
<% end %>
