<%# Admin Movies Index - Showcases: IndexPage, DataTable, Filters, Table, Tag, BooleanIcon, ActionsDropdown, Link %>

<%= render Bali::IndexPage::Component.new(
  title: t('movies.title'),
  subtitle: t('movies.subtitle'),
  breadcrumbs: [
    { name: t('navbar.dashboard'), href: admin_root_path, icon: 'home' },
    { name: t('movies.title') }
  ]
) do |page| %>
  <% page.with_action do %>
    <%= render Bali::Link::Component.new(
      name: t('movies.new_movie'),
      href: new_admin_movie_path,
      variant: :primary,
      icon: 'plus'
    ) %>
  <% end %>

  <%# El export vive en el ⋯ del PageHeader y no en la toolbar: exportar es una acción SOBRE
      la página, no un control de cómo se ve el listado. El link arrastra el recorte activo,
      por eso el item dice "lo filtrado". %>
  <%# `formats: [:csv]` y no los tres por default: este controller solo responde CSV, y un
      item que devuelve 406 en la página de referencia enseña la trampa en vez del arreglo. %>
  <% page.with_export(url: admin_movies_path, formats: [:csv]) %>

  <%# El ⋯ existe para que el export tenga vecinos: sin una segunda acción, la página no
      enseña que ahí cae todo lo que actúa SOBRE el listado y no sobre cómo se ve. %>
  <% page.with_secondary_action(name: t('movies.secondary_actions.import'),
                                icon: 'upload',
                                href: new_admin_movie_path) %>

  <%# El DataTable entra pelado: la superficie viaja con su slot de contenido. %>
  <% page.with_body do %>
    <%= render 'listing' %>
  <% end %>
<% end %>
