<!DOCTYPE html>
<html data-theme="light">
  <head>
    <% content_for(:title) { "Kitchen Sink Demo" } %>
    <%= render "layouts/head" %>
  </head>
  <%# `:wide` and not `:contained`: the layout's container is what decides the page width,
      not the page component — all five inherit `max_width: :full`, so a cap here clips every
      one of them from the outside and without the view asking for it. It is also what makes
      /studios and /admin/studios measure the same, sitting as they do in different layouts.
      A page that does want a cap asks for it with
      `content_for(:body_container) { "contained" }`. %>
  <%= render Bali::AppLayout::Component.new(
    flash: flash,
    body_container: content_for?(:body_container) ? content_for(:body_container).strip.to_sym : :wide,
    class: "bg-base-200",
    data: { controller: "theme-switcher" }
  ) do |layout| %>
    <% layout.with_navbar do %>
      <%= render 'layouts/navbar' %>
    <% end %>

    <% layout.with_body do %>
      <%= yield %>
    <% end %>
  <% end %>
</html>
