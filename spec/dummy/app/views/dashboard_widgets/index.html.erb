<%# The real widget dashboard demo — wired to DashboardWidgetsController and
    real models, unlike the Lookbook preview's stub. Press Edit to rearrange,
    resize or remove a card; reload to see it stick. %>
<%= render Bali::PageHeader::Component.new(
  title: t('dashboard_widgets.title'),
  subtitle: t('dashboard_widgets.subtitle')
) %>

<div class="mt-6">
  <%= render Bali::WidgetGrid::Component.new(
        url: dashboard_widgets_path, add_path: dashboard_widgets_picker_path) do |grid| %>
    <%# A PLACEMENT is a widget at a size — the arrangement's own pairing, which
        the card is told rather than the widget carrying. %>
    <% @layout.widgets.each do |placement| %>
      <% grid.with_widget(placement.widget, size: placement.size) %>
    <% end %>
  <% end %>
</div>
