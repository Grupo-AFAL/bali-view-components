<%# Every AUTHORIZED widget (`@offering`), not just the ones currently on the
    dashboard (`@layout.visible_keys`) — that is what makes this a picker
    rather than just the grid's own arrangement. Submitting writes membership
    through `Layout#choose`, which appends a re-added widget at the end and
    keeps a survivor's stored size — see the controller and
    `DashboardWidget::Store#choose` for why. %>
<%= render Bali::PageHeader::Component.new(
  title: t('.title'),
  subtitle: t('.subtitle'),
  back: { href: dashboard_widgets_path }
) %>

<div class="mt-6 max-w-2xl mx-auto">
  <%= render Bali::Card::Component.new(style: :bordered) do %>
    <%= form_with url: dashboard_widgets_picker_path, method: :patch do |f| %>
      <%= render Bali::List::Component.new do |list| %>
        <% @offering.each do |widget| %>
          <% checked = @layout.visible_keys.include?(widget.key) %>
          <% list.with_item do |item| %>
            <% item.with_title do %>
              <%= label_tag "widget_#{widget.key}",
                    class: 'flex items-center gap-3 font-semibold cursor-pointer' do %>
                <%= check_box_tag 'widget_keys[]', widget.key, checked,
                      id: "widget_#{widget.key}", class: 'checkbox checkbox-primary' %>
                <%= widget.title %>
              <% end %>
            <% end %>
            <% item.with_subtitle(widget.description) %>
          <% end %>
        <% end %>
      <% end %>

      <%# No stored rows is indistinguishable from "never chose" — `Layout#widgets`
          falls back to the whole offering — so unticking everything restores the
          defaults rather than emptying the dashboard. Say so, because the gesture
          reads the other way. %>
      <div class="flex items-center justify-between gap-4 mt-4">
        <p class="text-sm text-base-content/60"><%= t('.unchecking_all') %></p>
        <%= render Bali::Button::Component.new(name: t('.save'), variant: :primary, type: :submit) %>
      </div>
    <% end %>
  <% end %>

  <% if @layout.customized? %>
    <div class="flex justify-end mt-4">
      <%= form_with url: reset_dashboard_widgets_path, method: :delete,
            data: { turbo_confirm: t('.restore_confirm') } do %>
        <%= render Bali::Button::Component.new(
              name: t('.restore_defaults'), variant: :ghost, icon: 'rotate-ccw', type: :submit) %>
      <% end %>
    </div>
  <% end %>
</div>
