<%# OVERRIDES Bali's own `show`, which this app would otherwise get for free —
    see `app/views/bali/dashboard_widgets/show.html.erb`. The demo wants a header
    explaining itself; everything below the header is what the default renders.

    The picker at `edit` is NOT overridden, so that page is Bali's. %>
<%= render Bali::PageHeader::Component.new(
  title: t('dashboard_widgets.title'),
  subtitle: t('dashboard_widgets.subtitle')
) %>

<div class="mt-6">
  <%= render Bali::WidgetGrid::Component.new(
        url: url_for(action: :arrange), add_path: url_for(action: :edit),
        refresh_url: url_for(action: :refresh)) do |grid| %>
    <%# A PLACEMENT is a widget at a size — the arrangement's own pairing, which
        the card is told rather than the widget carrying. %>
    <% widget_store.widgets.each do |placement| %>
      <% grid.with_widget(placement.widget, size: placement.size) %>
    <% end %>
  <% end %>
</div>
