<%# El target es la identidad del listado (la misma que el DataTable resuelve desde
    storage_id): un id derivado de otra fórmula no encuentra el nodo y el stream se aplica
    sobre la nada, sin excepción ni log. El cuerpo es el MISMO partial que el html.erb, así
    que los dos caminos no pueden divergir. %>
<%= turbo_stream.replace @filter_form.storage_id do %>
  <%= render 'listing' %>
<% end %>
