<%# Two regions, two params. Deliberately plain markup: this exercises the
    controller on its own, without a widget grid around it. %>
<div class="p-8 space-y-8">
  <% [
       { id: 'alpha', param: 'editing_alpha' },
       { id: 'beta', param: 'editing_beta' }
     ].each do |region| %>
    <section id="region-<%= region[:id] %>"
             data-controller="edit-mode"
             data-edit-mode-editing-class="editing"
             data-edit-mode-param-value="<%= region[:param] %>"
             data-edit-mode-on-text-value="Editing <%= region[:id] %>"
             data-edit-mode-off-text-value="Done editing <%= region[:id] %>"
             data-action="keydown@window->edit-mode#keydown"
             class="rounded-box border border-base-300 p-4">
      <h2 class="font-bold"><%= region[:id].capitalize %></h2>

      <span data-edit-mode-target="enter">
        <%= render Bali::Button::Component.new(
              name: "Edit #{region[:id]}", size: :sm,
              data: { action: 'edit-mode#enter' }) %>
      </span>
      <span data-edit-mode-target="leave" hidden>
        <%= render Bali::Button::Component.new(
              name: "Done #{region[:id]}", variant: :primary, size: :sm,
              data: { action: 'edit-mode#leave' }) %>
      </span>

      <p role="status" aria-live="polite" class="sr-only"
         data-edit-mode-target="announcer"></p>

      <div data-edit-mode-target="inert" class="mt-4">
        <%= render Bali::Link::Component.new(name: "A link inside #{region[:id]}", href: '/') %>
      </div>
    </section>
  <% end %>
</div>
