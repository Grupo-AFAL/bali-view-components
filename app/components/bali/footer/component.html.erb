<%= tag.footer(**html_options) do %>
  <div class="container mx-auto max-w-6xl">
    <%# daisyUI's `.footer-center` alone is `grid-auto-flow: column dense`, every section side by
        side at any width; only `.footer-horizontal.footer-center` stacks them. %>
    <div class="footer <%= center? ? 'footer-horizontal footer-center' : 'sm:footer-horizontal' %>">
      <%= brand if brand? %>
      <% sections.each do |section| %>
        <%= section %>
      <% end %>
      <%= content %>
    </div>
    <%= bottom if bottom? %>
  </div>
<% end %>
