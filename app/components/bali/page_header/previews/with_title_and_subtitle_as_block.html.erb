<%# The block is the CONTENT of the heading, not a replacement for it. A heading %>
<%# of your own inside nests one heading in another, and the parser splits that %>
<%# into an empty heading plus yours. %>
<%= render Bali::PageHeader::Component.new do |c| %>
  <% c.with_title do %>
    <%= render Bali::Icon::Component.new('film', class: 'w-6 h-6 align-middle') %>
    <%= title %>
  <% end %>
  <% c.with_subtitle do %>
    <%= subtitle %> — <%= link_to 'view history', '#', class: 'link' %>
  <% end %>
  <%= render Bali::Button::Component.new(name: 'Right action', href: '#', variant: :secondary) %>
<% end %>
