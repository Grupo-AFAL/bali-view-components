<% right_content = content %>
<%= render level_component do |c| %>
  <%= c.with_left(class: left_classes) do |level| %>
    <% if render_back_button? %>
      <% level.with_item do %>
        <%= render Bali::Link::Component.new(icon: 'arrow-left', **back_button_options) %>
      <% end %>
    <% end %>
    <% if render_title_block? %>
      <% level.with_item(class: 'max-sm:w-full min-w-0') do %>
        <div class="<%= TITLE_BLOCK_CLASSES %>">
          <%= title_row %>
          <%= subtitle_element %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <% if right_content.present? %>
    <% c.with_right(class: 'max-sm:w-full') do %>
      <%= right_content %>
    <% end %>
  <% end %>
<% end %>
