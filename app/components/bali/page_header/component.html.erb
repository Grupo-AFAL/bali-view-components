<% right_content = content %>
<%= render level_component do |c| %>
  <%= c.with_left(class: 'max-sm:w-full') do |level| %>
    <% if render_back_button? %>
      <% level.with_item do %>
        <%= render Bali::Link::Component.new(icon_name: 'arrow-left', **back_button_options) %>
      <% end %>
    <% end %>
    <% level.with_item do %>
      <div>
        <%= title || tag.h3(@title, class: title_classes) %>
        <%= subtitle || tag.h6(@subtitle, class: subtitle_classes) %>
      </div>
    <% end %>
  <% end %>
  <% if right_content.present? %>
    <% c.with_right(class: 'max-sm:w-full') do %>
      <%= right_content %>
    <% end %>
  <% end %>
<% end %>
