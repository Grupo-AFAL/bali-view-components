<div class="flex flex-col gap-6 max-w-2xl">
  <%= render Bali::Card::Component.new do %>
    <%= render Bali::BlockEditor::Component.new(
      id: 'empty-editor',
      editable: true,
      placeholder: 'Start typing...'
    ) %>
  <% end %>

  <%= render Bali::Card::Component.new do %>
    <%= render Bali::BlockEditor::Component.new(
      id: 'content-editor',
      initial_content: content.to_json,
      editable: true
    ) %>
  <% end %>
</div>
