<% if disabled? %>
  <div class="border border-dashed border-error text-error text-sm rounded-box p-4">
    <p class="font-semibold"><%= t('.disabled_title') %></p>
    <p>
      <%= t('.disabled_help_html',
            setting: tag.code('config.block_editor_enabled = true'),
            initializer: tag.code('config/initializers/bali.rb'),
            docs: tag.code('docs/api/block-editor.md')) %>
    </p>
  </div>
<% else %>
  <%= tag.div(**options) do %>
    <div data-block-editor-target="editor" class="block-editor-content"></div>

    <% if show_export_buttons? %>
      <div class="flex justify-end mt-2 gap-2">
        <% if export_pdf? %>
          <button type="button"
                  class="btn btn-sm btn-ghost gap-1"
                  data-action="block-editor#exportPdf">
            <%= render Bali::Icon::Component.new('file-text', size: :small) %>
            <%= t('.export_pdf') %>
          </button>
        <% end %>
        <% if export_docx? %>
          <button type="button"
                  class="btn btn-sm btn-ghost gap-1"
                  data-action="block-editor#exportDocx">
            <%= render Bali::Icon::Component.new('file-down', size: :small) %>
            <%= t('.export_docx') %>
          </button>
        <% end %>
      </div>
    <% end %>

    <% if editable? && input_name.present? %>
      <input type="hidden"
             data-block-editor-target="output"
             name="<%= input_name %>"
             value="<%= hidden_input_value %>" />
    <% end %>
  <% end %>
<% end %>
