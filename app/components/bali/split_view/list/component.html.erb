<%# The surface is a bordered Card because that is what the listing is in both
    implementations this was generalised from, and `body_class: "p-0"` because a
    row's own padding is what makes the selection bar reach the edge. %>
<%= render Bali::Card::Component.new(style: :bordered, body_class: "p-0 overflow-hidden") do %>
  <%= tag.div(**container_attributes) do %>
    <% if header.present? || count.present? %>
      <div class="split-view-list-header <%= HEADER_CLASSES %>">
        <% if header.present? %><span><%= header %></span><% end %>
        <% if count.present? %>
          <span class="text-base-content/50 font-normal" data-testid="list-count"><%= count %></span>
        <% end %>
      </div>
    <% end %>

    <% if filters.any? %>
      <div class="split-view-list-filters" data-testid="list-filters">
        <% filters.each do |filter| %>
          <%= filter %>
        <% end %>
      </div>
    <% end %>

    <%= tag.div(**scroll_attributes) do %>
      <div data-split-view-list-target="rows">
        <% items.each do |item| %>
          <%= item %>
        <% end %>
      </div>

      <% if items.none? && empty_state? %>
        <%= empty_state %>
      <% end %>

      <% if infinite_scroll? %>
        <%# The sentinel lives inside the scroll area because that is what scrolls;
            an observer rooted on the viewport would never fire for a list that
            scrolls internally. Hidden until the controller connects, so a reader
            without JavaScript never sees a spinner that will not resolve. %>
        <div data-split-view-list-target="sentinel" class="split-view-sentinel" hidden>
          <span data-split-view-list-target="loader" class="split-view-sentinel-loader">
            <%= render Bali::Loader::Component.new(size: :sm) %>
          </span>
          <span data-split-view-list-target="end" class="split-view-sentinel-end" hidden>
            <%= t("bali_view.split_view.end_of_list") %>
          </span>
          <span data-split-view-list-target="error" class="split-view-sentinel-error" hidden>
            <%= t("bali_view.split_view.load_error") %>
            <%= render Bali::Button::Component.new(
              name: t("bali_view.split_view.retry"),
              variant: :ghost, size: :xs,
              data: { action: "split-view-list#retry" }
            ) %>
          </span>
        </div>
      <% end %>
    <% end %>

    <% if paginated? %>
      <%# Progressive enhancement: these are the controls a reader without JavaScript
          pages with. The controller hides them on connect and takes over. %>
      <div data-split-view-list-target="pagination" class="px-4">
        <%= render Bali::PaginationFooter::Component.new(
          pagy: pagy, item_name: item_name, data: { turbo_frame: "_top" }
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
