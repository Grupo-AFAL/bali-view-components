<%# `tag.turbo_frame` and not `turbo_frame_tag`: turbo-rails is a development
    dependency here, not a runtime one, so the component builds the element
    itself instead of reaching for a helper a host may not have loaded. %>
<%= tag.div(**container_attributes) do %>
  <%# `frame_value`: the controller lives on the master and the frame is its SIBLING, so a
      Stimulus target cannot reach it — the id is the only way to name it (#1012). %>
  <div class="split-view-master" data-controller="split-view"
       data-split-view-frame-value="<%= frame_id %>">
    <%= list? ? list : master %>
  </div>

  <% if collapsible? %>
    <%# The pane around the frame carries what Turbo must not replace: «Close»
        (from `lg` up) and «Back» (below it, where the detail covers the master). %>
    <section class="split-view-detail-pane" data-split-view-collapse-target="pane" aria-label="<%= t("bali_view.split_view.detail") %>">
      <div class="split-view-detail-bar">
        <%= render Bali::Button::Component.new(name: "← #{t('bali_view.split_view.back')}", variant: :ghost, size: :sm,
              class: "lg:hidden", data: { action: "split-view-collapse#close", testid: "split-view-back" }) %>
        <%= render Bali::Button::Component.new(name: t("bali_view.split_view.close"), variant: :ghost, size: :sm,
              class: "hidden lg:inline-flex", data: { action: "split-view-collapse#close", testid: "split-view-close" }) %>
      </div>
      <%# While the frame fetches (`data-split-load` on the pane, collapse.js).
          The region is always there: what appears inside it is announced. %>
      <div class="split-view-load-status" role="status">
        <div class="split-view-loading" data-split-view-collapse-target="loading" hidden>
          <% if loading? %>
            <%= loading %>
          <% else %>
            <div class="split-view-loading-card">
              <svg class="split-view-spinner" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.2" stroke-width="3" />
                <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
              </svg>
              <span class="text-sm text-base-content/70"><%= t("bali_view.split_view.loading") %></span>
            </div>
          <% end %>
        </div>
      </div>
      <div class="split-view-load-error" data-split-view-collapse-target="error" role="alert" hidden>
        <p class="text-sm"><%= t("bali_view.split_view.detail_error") %></p>
        <%= render Bali::Button::Component.new(name: t("bali_view.split_view.retry"), style: :outline, size: :sm,
              data: { action: "split-view-collapse#retry", testid: "split-view-retry" }) %>
      </div>
      <%= tag.turbo_frame(**frame_attributes) do %>
        <% if detail? %>
          <%= detail %>
        <% elsif empty_detail? %>
          <%# Marked, so the collapse controller does not take it for a detail. %>
          <div data-split-view-empty><%= empty_detail %></div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <%= tag.turbo_frame(**frame_attributes) do %>
      <%= detail? ? detail : empty_detail %>
    <% end %>
  <% end %>
<% end %>
