<%# Rows link back to THIS preview, so the response a click fetches is this same
    template, as on a real screen: the selection comes from `?selected=` because
    a preview method has no `params`, and the template runs inside the request.

    The list is uncapped (`max_height: "none"`): the page scrolls, not the list,
    so stacked below `lg` the detail starts far below a phone's first screen, and
    from `lg` up the page is still tall enough for a scroll to have somewhere to go.

    That same scroll carries an unpinned detail off the top of a wide screen, and a
    click far down the list would then change a pane nobody can see: measured at
    1280x800, scrolled 600px, the tenth row's detail landed at y=-584. Hence
    `lg:sticky lg:top-4` on the frame. %>
<% movies = Movie.includes(:studio).order(:name) %>
<% selected = Movie.find_by(id: request.query_parameters["selected"]) %>
<%= render Bali::SplitView::Component.new(
  frame_id: "split-view-detail",
  frame_options: { class: "lg:sticky lg:top-4", autoscroll: true, data: { autoscroll_block: "start" } }
) do |split| %>
  <% split.with_list(header: "Catalog", count: movies.size, selected: selected&.id,
                     item_name: "movies", max_height: "none") do |list| %>
    <% movies.each do |movie| %>
      <% list.with_item(id: movie.id, href: "#{request.path}?selected=#{movie.id}",
                        title: movie.name, subtitle: movie.studio&.name) do |row| %>
        <% row.with_tag(text: movie.genre, color: :info) %>
      <% end %>
    <% end %>
  <% end %>

  <% if selected %>
    <% split.with_detail do %>
      <%# Turbo scrolls the frame's FIRST CHILD into view, so this marker decides
          where the scroll lands. `lg:hidden` is what keeps a wide screen still:
          an element with no box is never scrolled to. The pin does not make it
          redundant: a visible marker stays put only while the pin's top equals
          its `scroll-mt-4`, and a pin at 80px moved the page 64px. %>
      <div class="scroll-mt-4 lg:hidden" data-testid="detail-scroll-target"></div>
      <%= render Bali::Card::Component.new(style: :bordered) do |card| %>
        <% card.with_title(selected.name, class: "text-lg", data: { testid: "detail-title" }) %>
        <%= render Bali::DescriptionList::Component.new(columns: 2) do |items| %>
          <% items.with_item(label: "Genre", value: selected.genre) %>
          <% items.with_item(label: "Studio", value: selected.studio&.name) %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <% split.with_empty_detail do %>
      <%= render Bali::EmptyState::Component.new(
        title: "Select a movie",
        description: "Pick a row to see its details here.",
        icon: "inbox"
      ) %>
    <% end %>
  <% end %>
<% end %>
