<% notes = { proposed: nil, approved: nil, published: 'publicación #12', current: nil } %>

<div class="space-y-8">
  <div>
    <h3 class="text-sm font-semibold mb-2">All four steps pass a block and decide inside it</h3>
    <%= render Bali::Stepper::Component.new(current: 2) do |c| %>
      <% c.with_step(title: 'Propuesto') do %>
        <% if notes[:proposed].present? %>
          <span class="text-xs opacity-60"><%= notes[:proposed] %></span>
        <% end %>
      <% end %>
      <% c.with_step(title: 'Aprobado') do %>
        <% if notes[:approved].present? %>
          <span class="text-xs opacity-60"><%= notes[:approved] %></span>
        <% end %>
      <% end %>
      <% c.with_step(title: 'Publicado') do %>
        <% if notes[:published].present? %>
          <span class="text-xs opacity-60"><%= notes[:published] %></span>
        <% end %>
      <% end %>
      <% c.with_step(title: 'Vigente') do %>
        <% if notes[:current].present? %>
          <span class="text-xs opacity-60"><%= notes[:current] %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div>
    <h3 class="text-sm font-semibold mb-2">The same outcome written by hand: a block only on the step that has a detail</h3>
    <%= render Bali::Stepper::Component.new(current: 2) do |c| %>
      <% c.with_step(title: 'Propuesto') %>
      <% c.with_step(title: 'Aprobado') %>
      <% c.with_step(title: 'Publicado') do %>
        <span class="text-xs opacity-60">publicación #12</span>
      <% end %>
      <% c.with_step(title: 'Vigente') %>
    <% end %>
  </div>
</div>
