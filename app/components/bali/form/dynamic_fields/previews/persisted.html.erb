<%# Rows the server already knows about: `fields_for` emits their `[id]` hidden
    field, which is what tells the controller to hide and flag the row instead
    of dropping it, so the server still learns which record to destroy. The
    `default` preview is the other half of the pair — an unsaved record, whose
    rows leave the DOM outright. %>
<div class="p-4 max-w-2xl">
  <h3 class="text-lg font-semibold mb-4">Saved Characters</h3>

  <%= form_with model: model, url: '/lookbook', builder: Bali::FormBuilder do |f| %>
    <%= f.dynamic_fields_group :characters,
        label: 'Characters',
        button_text: 'Add Character' %>

    <div class="mt-4">
      <%= f.submit 'Save Movie', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
