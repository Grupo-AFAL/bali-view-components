<div class="w-60 border border-base-300 rounded-box p-3">
  <%= form_with(model: model, url: '/', builder: Bali::FormBuilder) do |form| %>
    <%= form.file_group :files,
          accept: '.jpg, .jpeg, .png, .gif, .pdf',
          choose_file_text: 'Seleccionar archivo',
          non_selected_text: 'Ningun archivo seleccionado' %>
  <% end %>
</div>
