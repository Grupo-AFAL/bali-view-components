<%= render Bali::ShowPage::Component.new(
  title: 'The Matrix',
  subtitle: 'Released 1999',
  context: context,
  breadcrumbs: [
    { name: 'Dashboard', href: '/lookbook', icon: 'home' },
    { name: 'Movies', href: '/lookbook' },
    { name: 'The Matrix' }
  ],
  back: { href: '/lookbook' }
) do |page| %>
  <% page.with_title_tag do %>
    <%= render Bali::Tag::Component.new(text: 'Released', color: :success, size: :sm) %>
  <% end %>

  <% page.with_action do %>
    <%= render Bali::Link::Component.new(name: 'Edit', href: '/lookbook', variant: :primary, size: :sm) %>
  <% end %>

  <% page.with_body do %>
    <%= render Bali::Card::Component.new(style: :bordered) do %>
      <%= render Bali::Columns::Component.new(cols: 1, cols_md: 2, gap: :lg) do %>
        <%= render Bali::LabelValue::Component.new(label: 'Director', value: 'The Wachowskis') %>
        <%= render Bali::LabelValue::Component.new(label: 'Genre', value: 'Sci-Fi') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
