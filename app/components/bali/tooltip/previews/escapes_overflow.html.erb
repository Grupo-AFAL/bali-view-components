<div class="flex justify-center items-center gap-16 p-16">
  <div class="relative w-40 h-20 overflow-hidden border border-base-300 rounded flex items-center justify-center">
    <%= render Bali::Tooltip::Component.new(placement: :top) do |c| %>
      <% c.with_trigger do %>
        <span class="btn btn-sm btn-primary">Escapes (default)</span>
      <% end %>
      <p>The default (`append_to: :body`) portals the balloon out of the overflow-hidden container.</p>
    <% end %>
  </div>

  <div class="relative w-40 h-20 overflow-hidden border border-base-300 rounded flex items-center justify-center">
    <%= render Bali::Tooltip::Component.new(placement: :top, append_to: :parent) do |c| %>
      <% c.with_trigger do %>
        <span class="btn btn-sm">Clipped (:parent)</span>
      <% end %>
      <p>Opting into `append_to: :parent` keeps the balloon in place — and clipped here.</p>
    <% end %>
  </div>
</div>
