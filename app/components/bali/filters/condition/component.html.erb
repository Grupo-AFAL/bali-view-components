<div class="condition flex-1 relative sm:static flex flex-col sm:flex-row gap-2 pr-8 sm:pr-0 items-stretch sm:items-start"
     data-controller="condition"
     data-condition-group-index-value="<%= group_index %>"
     data-condition-index-value="<%= condition_index %>"
     data-condition-locale-value="<%= I18n.locale %>"
     data-condition-translations-value="<%= translations_json %>"
     data-filter-group-target="condition">

  <%# Attribute selector - narrow; long labels truncate with ellipsis so the value gets space %>
  <div class="w-full sm:w-36 sm:shrink-0">
    <select class="select select-bordered select-sm w-full truncate"
            aria-label="<%= t('bali_view.filters.aria_labels.field') %>"
            data-action="condition#attributeChanged"
            data-condition-target="attribute">
      <option value="">
        <%= t('bali_view.filters.select_field') %>
      </option>
      <% available_attributes.each do |attr| %>
        <option value="<%= attr[:key] %>"
                data-type="<%= attr[:type] %>"
                data-options="<%= (attr[:options] || []).to_json %>"
                data-operators="<%= Bali::Filters::Operators.for_type(attr[:type]).to_json %>"
                <%= 'selected' if attr[:key].to_s == attribute %>>
          <%= attr[:label] %>
        </option>
      <% end %>
    </select>
  </div>

  <%# Operator selector - kept narrow; long labels ("es exactamente") truncate with ellipsis %>
  <div class="w-full sm:w-28 sm:shrink-0">
    <select class="select select-bordered select-sm w-full truncate"
            aria-label="<%= t('bali_view.filters.aria_labels.operator') %>"
            data-action="condition#operatorChanged"
            data-condition-target="operator">
      <% operators_for_current_type.each do |op| %>
        <option value="<%= op[:value] %>"
                data-multiple="<%= op[:multiple] || false %>"
                data-range="<%= op[:range] || false %>"
                <%= 'selected' if op[:value] == operator %>>
          <%= op[:label] %>
        </option>
      <% end %>
    </select>
  </div>

  <%# Value input plus its "ignored" note - takes remaining space. The note is a SIBLING of
      the container rather than a child of it: condition_controller.js rebuilds the
      container's innerHTML whenever the operator asks for a different widget, and that
      would take the note with it. %>
  <div class="flex-1 min-w-0">
    <%# Each widget is named by aria-label, as is each one condition_controller.js builds in
        its place (`valueAriaLabel`): SlimSelect names its combobox from the <select>'s
        aria-label or aria-labelledby alone, and datepicker-controller.js carries it to the
        input flatpickr shows in its place. The multi-select trigger is the exception: an
        aria-label would hide the choices it lists. %>
    <div data-condition-target="valueContainer">
      <% case attribute_type.to_sym %>
      <% when :select %>
        <% if multiple_operator? %>
          <%# Multi-select dropdown for "is any of" / "is not any of" %>
          <div class="relative w-full"
               data-controller="multi-select"
               data-multi-select-translations-value="<%= multi_select_translations_json %>"
               data-condition-target="value">
            <%# A div with role=button does not fire click on Enter/Space the way a real
                <button> does: the keyboard needs actions of its own (#1028). It discloses a
                panel of checkboxes, so it says aria-expanded: aria-haspopup="listbox" would
                announce a list of role=option that is not there. %>
            <div tabindex="0"
                 role="button"
                 aria-expanded="false"
                 class="select select-bordered select-sm w-full flex items-center cursor-pointer"
                 data-action="click->multi-select#toggle keydown.enter->multi-select#toggle:prevent keydown.space->multi-select#toggle:prevent"
                 data-multi-select-target="trigger">
              <span class="flex-1 truncate text-left" data-multi-select-target="label">
                <%= t('bali_view.filters.select_values') %>
              </span>
            </div>
            <%# condition_controller.js#buildMultiSelectInput builds this same widget, attribute for
                attribute, and its classes are generated only because they are written here:
                change both. The edge is /20, not a panel's /15: the list hangs over the filter
                group's 8% tint, where /15 read 1.148:1 on afal. %>
            <div class="absolute left-0 top-full hidden z-[var(--bali-z-dropdown)] mt-1 p-2 shadow-lg bg-base-100 border border-base-content/20 rounded-lg w-full max-h-60 overflow-y-auto"
                 data-multi-select-target="dropdown">
              <% attribute_options.each do |opt| %>
                <% opt_label, opt_value = opt.is_a?(Array) ? opt : [opt, opt] %>
                <% checked = Array(value).map(&:to_s).include?(opt_value.to_s) %>
                <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-base-content/8 cursor-pointer">
                  <input type="checkbox"
                         class="checkbox checkbox-sm checkbox-primary"
                         name="<%= field_name %>[]"
                         value="<%= opt_value %>"
                         data-label="<%= opt_label %>"
                         data-action="multi-select#updateSelection"
                         <%= 'checked' if checked %>>
                  <span class="text-sm"><%= opt_label %></span>
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <%# Single searchable select for "is" / "is not" (SlimSelect).
              slim-select-sm matches the select-sm height of the field/operator selects. %>
          <div class="w-full slim-select-sm" data-controller="slim-select"
               data-slim-select-placeholder-value="<%= t('bali_view.filters.select_value') %>"
               data-slim-select-search-placeholder-value="<%= t('bali_view.filters.search') %>"
               data-slim-select-no-results-text-value="<%= t('bali_view.form_builder.slim_select.no_results') %>"
               data-slim-select-deselect-text-value="<%= t('bali_view.form_builder.slim_select.deselect') %>"
               data-slim-select-remove-text-value="<%= t('bali_view.form_builder.slim_select.remove') %>"
               data-slim-select-results-count-text-value="<%= t('bali_view.form_builder.slim_select.results_count') %>">
            <select class="select select-bordered select-sm w-full"
                    name="<%= field_name %>"
                    aria-label="<%= value_aria_label %>"
                    data-slim-select-target="select"
                    data-condition-target="value">
              <option value="">
                <%= t('bali_view.filters.select_value') %>
              </option>
              <% attribute_options.each do |opt| %>
                <% opt_label, opt_value = opt.is_a?(Array) ? opt : [opt, opt] %>
                <option value="<%= opt_value %>" <%= 'selected' if opt_value.to_s == value.to_s %>>
                  <%= opt_label %>
                </option>
              <% end %>
            </select>
          </div>
        <% end %>

      <% when :boolean %>
        <select class="select select-bordered select-sm w-full"
                name="<%= field_name %>"
                aria-label="<%= value_aria_label %>"
                data-condition-target="value">
          <option value="">
            <%= t('bali_view.filters.boolean.any') %>
          </option>
          <option value="true" <%= 'selected' if value.to_s == 'true' %>>
            <%= t('bali_view.filters.boolean.yes') %>
          </option>
          <option value="false" <%= 'selected' if value.to_s == 'false' %>>
            <%= t('bali_view.filters.boolean.no') %>
          </option>
        </select>

      <% when :date, :datetime %>
        <% if range_operator? %>
          <%# condition_controller.js#syncRangeDates sends bare dates, which
              Bali::FilterForm::WholeDayCasting reads as whole days: a time shown here would not
              travel (#1282). %>
          <div class="w-full" data-condition-target="value">
            <input type="text"
                   class="input input-bordered input-sm w-full"
                   placeholder="<%= t('bali_view.filters.select_date_range') %>"
                   aria-label="<%= value_aria_label %>"
                   data-controller="datepicker"
                   data-datepicker-locale-value="<%= I18n.locale %>"
                   data-datepicker-mode-value="range"
                   data-datepicker-alt-format-value="<%= short_date_format %>"
                   data-datepicker-alt-input-class-value="input input-bordered input-sm w-full"
                   data-datepicker-default-dates-value="<%= [range_values[:start], range_values[:end]].compact.to_json %>"
                   data-action="change->condition#syncRangeDates"
                   data-condition-target="rangeInput">
            <%# Hidden fields for Ransack gteq/lteq params %>
            <input type="hidden"
                   name="<%= range_field_names[:start] %>"
                   value="<%= range_values[:start] %>"
                   data-condition-target="rangeStart">
            <input type="hidden"
                   name="<%= range_field_names[:end] %>"
                   value="<%= range_values[:end] %>"
                   data-condition-target="rangeEnd">
          </div>
        <% elsif attribute_type.to_sym == :date %>
          <%# Single date picker using Flatpickr %>
          <input type="text"
                 class="input input-bordered input-sm w-full"
                 name="<%= field_name %>"
                 value="<%= value %>"
                 placeholder="<%= t('bali_view.filters.select_date') %>"
                 aria-label="<%= value_aria_label %>"
                 data-controller="datepicker"
                 data-datepicker-locale-value="<%= I18n.locale %>"
                 data-datepicker-mode-value="single"
                 data-datepicker-alt-format-value="<%= short_date_format %>"
                 data-datepicker-alt-input-class-value="input input-bordered input-sm w-full"
                 data-condition-target="value">
        <% else %>
          <%# Single datetime picker using Flatpickr %>
          <input type="text"
                 class="input input-bordered input-sm w-full"
                 name="<%= field_name %>"
                 value="<%= value %>"
                 placeholder="<%= t('bali_view.filters.select_datetime') %>"
                 aria-label="<%= value_aria_label %>"
                 data-controller="datepicker"
                 data-datepicker-locale-value="<%= I18n.locale %>"
                 data-datepicker-mode-value="single"
                 data-datepicker-enable-time-value="true"
                 data-datepicker-alt-format-value="<%= short_datetime_format %>"
                 data-datepicker-alt-input-class-value="input input-bordered input-sm w-full"
                 data-condition-target="value">
        <% end %>

      <% when :number %>
        <input type="number"
               class="input input-bordered input-sm w-full"
               name="<%= field_name %>"
               value="<%= value %>"
               step="any"
               placeholder="0"
               aria-label="<%= value_aria_label %>"
               data-condition-target="value">

      <% else %>
        <input type="text"
               class="input input-bordered input-sm w-full"
               name="<%= field_name %>"
               value="<%= value %>"
               placeholder="<%= t('bali_view.filters.enter_value') %>"
               aria-label="<%= value_aria_label %>"
               data-condition-target="value">
      <% end %>
    </div>

    <%# A condition with an attribute and no value cannot travel: a blank Ransack
        predicate is discarded server-side without a word and the list comes back
        unfiltered. Shown only once the row has been checked (Apply, or a widget swap
        that dropped the value), never while it is still being filled in. %>
    <p class="filters-condition-hint mt-1 items-center gap-1 text-xs text-soft-warning"
       role="status"
       data-condition-target="hint">
      <%= render Bali::Icon::Component.new('alert', class: 'w-3 h-3 shrink-0') %>
      <%= t('bali_view.filters.incomplete_condition') %>
    </p>
  </div>

  <%# Remove condition button - absolute top-right on mobile, inline on desktop %>
  <div class="absolute top-0 right-0 sm:relative sm:top-auto sm:right-auto flex-shrink-0">
    <button type="button"
            class="btn btn-ghost btn-sm btn-circle text-base-content/60 hover:text-soft-error hover:bg-error/10"
            data-action="condition#remove"
            aria-label="<%= t('bali_view.filters.remove_condition') %>"
            title="<%= t('bali_view.filters.remove_condition') %>">
      <%= render Bali::Icon::Component.new('times', class: 'w-4 h-4') %>
    </button>
  </div>

  <%# Hidden fields to track attribute and operator for form building %>
  <input type="hidden"
         data-condition-target="attributeHidden"
         value="<%= attribute %>">
  <input type="hidden"
         data-condition-target="operatorHidden"
         value="<%= operator %>">
</div>
