<div id="<%= id %>"
     class="filters"
     data-controller="filters"
     data-filters-url-value="<%= url %>"
     data-filters-attributes-value="<%= attributes_json %>"
     data-filters-apply-mode-value="<%= apply_mode %>"
     data-filters-max-groups-value="<%= max_groups %>"
     data-filters-popover-value="<%= popover %>"
     data-filters-translations-value="<%= translations_json %>"
     data-turbo-permanent>

  <% if popover %>
    <%# Popover mode: search input + trigger button + dropdown %>
    <div class="flex items-center gap-2 sm:gap-3">
      <% if search_enabled? %>
        <%# Quick search input with clear button %>
        <%= form_with url: url, method: :get, class: 'flex-1 min-w-0 sm:flex-initial', data: { turbo_stream: turbo_stream, turbo_action: 'replace', filters_target: 'searchForm' } do %>
          <%= preserved_params_hidden_fields %>
          <%# Los filtros ACTIVOS viajan como hidden fields: sin esto, buscar re-enviaba solo
              q[...search...] y el server tomaba "attributes vacíos" como estado nuevo — borraba
              los filtros aplicados (y, con persistencia, también los guardados). %>
          <%= active_filter_hidden_fields %>
          <%# `min-w-0` en los tres niveles: `sm:w-64` es el ancho que la búsqueda QUIERE, no
              un piso. Sin esto no podía encogerse, y en una toolbar apretada (un DataTable
              con sidebar) el campo se pintaba fuera de su caja, encima de los controles de
              al lado, en vez de cederles ancho. %>
          <div class="join focus-within:ring-2 focus-within:ring-primary/20 rounded-lg w-full sm:w-auto min-w-0">
            <label class="input input-bordered input-sm join-item w-full sm:w-64 min-w-0 flex items-center gap-2">
              <input type="text"
                     name="<%= search_field_name %>"
                     value="<%= search_value %>"
                     placeholder="<%= search_placeholder %>"
                     class="grow min-w-0 bg-transparent outline-none"
                     data-filters-target="searchInput"
                     data-action="input->filters#toggleSearchClear">
              <%# Clear button - shown when search has value %>
              <button type="button"
                      class="cursor-pointer p-0 w-4 h-4 flex items-center justify-center text-base-content/40 hover:text-base-content/70 <%= 'hidden' if search_value.blank? %>"
                      data-filters-target="searchClearButton"
                      data-action="click->filters#clearSearch"
                aria-label="<%= t('bali_view.filters.clear_search') %>">
                <%= render Bali::Icon::Component.new('x', class: 'w-4 h-4') %>
              </button>
            </label>
            <button type="submit" class="btn btn-primary btn-sm join-item" data-action="click->filters#submitSearch">
              <%= render Bali::Icon::Component.new('search', class: 'w-4 h-4') %>
            </button>
          </div>
        <% end %>
      <% end %>

      <%# Trigger button with persistence indicator %>
      <div class="flex items-center gap-1">
        <div class="relative" data-filters-target="dropdown">
          <button type="button"
                  class="btn btn-outline btn-sm gap-2"
                  data-action="click->filters#toggleDropdown">
            <%= render Bali::Icon::Component.new('filter', class: 'w-4 h-4') %>
            <span class="hidden sm:inline"><%= button_text %></span>
            <% if active_filters? %>
              <span class="badge badge-primary badge-sm"><%= active_filter_count %></span>
            <% end %>
          </button>

          <%# Dropdown content - hidden by default, shown via JS %>
          <div class="hidden z-50
                      max-sm:fixed max-sm:top-0 max-sm:right-0 max-sm:bottom-0 max-sm:left-0
                      sm:absolute sm:top-full sm:left-0 sm:mt-2"
             data-filters-target="dropdownContent">
            <div class="bg-base-100 max-sm:flex max-sm:flex-col max-sm:h-full
                        sm:shadow-xl sm:rounded-box sm:border sm:border-base-200 sm:w-[40rem] sm:max-w-[calc(100vw-2rem)]">

            <%# Mobile header with close button %>
            <div class="max-sm:flex items-center justify-between p-4 border-b border-base-200 sm:hidden">
              <h3 class="text-lg font-semibold flex items-center gap-2">
                <%= render Bali::Icon::Component.new('filter', class: 'w-5 h-5') %>
                <%= t('bali_view.filters.title') %>
              </h3>
              <button type="button" class="btn btn-ghost btn-sm btn-circle" data-action="filters#toggleDropdown" aria-label="Close">
                <%= render Bali::Icon::Component.new('x', class: 'w-5 h-5') %>
              </button>
            </div>

            <%= form_with url: url, method: :get,
                data: {
                  filters_target: 'form',
                  turbo_stream: turbo_stream,
                  turbo_action: 'replace'
                },
                class: 'w-full max-sm:flex max-sm:flex-col max-sm:flex-1 max-sm:min-h-0' do |f| %>
              <%= preserved_params_hidden_fields %>
              <div class="p-4 space-y-4 max-sm:flex-1 max-sm:overflow-y-auto">
                <%# Filter groups container - no header for compact layout %>
                <div data-filters-target="groupsContainer" class="space-y-4">
                  <% filter_groups.each_with_index do |group, group_idx| %>
                    <% if group_idx > 0 %>
                      <%# Group combinator divider (AND/OR toggle between groups) %>
                      <div class="flex items-center justify-center gap-2 my-2">
                        <div class="flex-1 border-t border-base-300"></div>
                        <input type="hidden" name="q[m]" value="<%= combinator %>" data-filters-target="groupCombinator">
                        <div class="join" data-filters-target="groupCombinatorToggle">
                          <button type="button"
                                class="join-item btn btn-xs w-10 <%= combinator == 'and' ? 'btn-primary' : 'btn-outline' %>"
                                data-action="filters#setGroupCombinator"
                                data-combinator="and">
                            <%= t('bali_view.filters.combinators.and') %>
                          </button>
                          <button type="button"
                                class="join-item btn btn-xs w-10 <%= combinator == 'or' ? 'btn-primary' : 'btn-outline' %>"
                                data-action="filters#setGroupCombinator"
                                data-combinator="or">
                            <%= t('bali_view.filters.combinators.or') %>
                          </button>
                        </div>
                        <div class="flex-1 border-t border-base-300"></div>
                      </div>
                    <% end %>

                    <%= render Bali::Filters::FilterGroup::Component.new(
                        group: group,
                        index: group_idx,
                        available_attributes: available_attributes,
                        removable: filter_groups.size > 1
                      ) %>
                  <% end %>
                </div>
              </div>

              <%# Footer - sticky on mobile, inline on desktop %>
              <div class="max-sm:flex max-sm:flex-col sm:flex sm:flex-row justify-between max-sm:items-stretch sm:items-center gap-3 p-4 border-t border-base-200 max-sm:shrink-0 bg-base-100">
                <%# Apply + Reset: primary actions first on mobile %>
                <div class="flex items-center gap-2 order-1 sm:order-3">
                  <button type="button"
                        class="btn btn-ghost btn-sm flex-1 sm:flex-initial"
                        data-action="filters#reset">
                    <%= t('bali_view.filters.reset') %>
                  </button>
                  <button type="submit"
                        class="btn btn-primary btn-sm flex-1 sm:flex-initial"
                        data-action="filters#apply">
                    <%= render Bali::Icon::Component.new('check', class: 'w-4 h-4') %>
                    <%= t('bali_view.filters.apply') %>
                  </button>
                </div>

                <%# Add group + Clear: secondary actions on mobile %>
                <div class="flex items-center justify-between sm:justify-start gap-2 order-2 sm:order-1">
                  <button type="button"
                        class="btn btn-ghost btn-sm text-primary gap-1"
                        data-action="filters#addGroup"
                        data-filters-target="addGroupButton">
                    <%= render Bali::Icon::Component.new('plus', class: 'w-4 h-4') %>
                    <%= t('bali_view.filters.add_group') %>
                  </button>
                  <% if persistence_available? && persist_enabled? %>
                    <span class="text-xs text-base-content/50 flex items-center gap-1">
                      <%= render Bali::Icon::Component.new('bookmark-check', class: 'w-3 h-3') %>
                      <%= t('bali_view.filters.auto_saved') %>
                    </span>
                  <% end %>
                  <button type="button"
                        class="btn btn-ghost btn-xs text-error"
                        data-action="filters#clearAll"
                        data-filters-target="clearButton">
                    <%= t('bali_view.filters.clear_all') %>
                  </button>
                </div>
              </div>
            <% end %>
            </div>
          </div>
        </div>

        <%# Persistence toggle (bookmark icon). Dentro de un DataTable el marcador lo pinta la
            toolbar como control propio y acá llega apagado: dos controladores
            `filter-persistence` sobre el mismo storage_id se pisan el localStorage. %>
        <% if persistence_toggle? %>
          <%= render Bali::Filters::PersistenceToggle::Component.new(
                storage_id: storage_id, enabled: persist_enabled?) %>
        <% end %>
      </div>

    </div>

    <%# Applied filter tags (below search row) %>
    <% if applied_tags? %>
      <div class="mt-2">
        <%= applied_tags %>
      </div>
    <% end %>

  <% else %>
    <%# Inline mode: original layout %>
    <% if applied_tags? %>
      <div class="mb-4">
        <%= applied_tags %>
      </div>
    <% end %>

    <%= form_with url: url, method: :get,
          data: {
            filters_target: 'form',
            turbo_stream: turbo_stream,
            turbo_action: 'replace'
          },
          class: 'w-full' do |f| %>
      <%= preserved_params_hidden_fields %>
      <%= render Bali::Card::Component.new(style: :bordered, body_class: 'p-4 sm:p-6 space-y-4') do %>
        <%# Header %>
        <div class="flex justify-between items-center">
          <h3 class="font-semibold text-lg flex items-center gap-2">
            <%= render Bali::Icon::Component.new('filter', class: 'w-5 h-5') %>
            <%= t('bali_view.filters.title') %>
          </h3>
          <button type="button"
                    class="btn btn-ghost btn-sm text-error"
                    data-action="filters#clearAll"
                    data-filters-target="clearButton">
            <%= t('bali_view.filters.clear_all') %>
          </button>
        </div>

        <div class="divider my-0"></div>

        <%# Filter groups container %>
        <div data-filters-target="groupsContainer" class="space-y-4">
          <% filter_groups.each_with_index do |group, group_idx| %>
            <% if group_idx > 0 %>
              <%# Group combinator divider (AND/OR toggle between groups) %>
              <div class="flex items-center justify-center gap-2 my-2">
                <div class="flex-1 border-t border-base-300"></div>
                <input type="hidden" name="q[m]" value="<%= combinator %>" data-filters-target="groupCombinator">
                <div class="join" data-filters-target="groupCombinatorToggle">
                  <button type="button"
                                class="join-item btn btn-xs w-10 <%= combinator == 'and' ? 'btn-primary' : 'btn-outline' %>"
                                data-action="filters#setGroupCombinator"
                                data-combinator="and">
                    <%= t('bali_view.filters.combinators.and') %>
                  </button>
                  <button type="button"
                                class="join-item btn btn-xs w-10 <%= combinator == 'or' ? 'btn-primary' : 'btn-outline' %>"
                                data-action="filters#setGroupCombinator"
                                data-combinator="or">
                    <%= t('bali_view.filters.combinators.or') %>
                  </button>
                </div>
                <div class="flex-1 border-t border-base-300"></div>
              </div>
            <% end %>

            <%= render Bali::Filters::FilterGroup::Component.new(
                        group: group,
                        index: group_idx,
                        available_attributes: available_attributes,
                        removable: filter_groups.size > 1
                      ) %>
          <% end %>
        </div>

        <%# Add group button %>
        <button type="button"
                  class="btn btn-ghost btn-sm gap-2 w-full sm:w-auto text-primary hover:bg-primary/10"
                  data-action="filters#addGroup"
                  data-filters-target="addGroupButton">
          <%= render Bali::Icon::Component.new('plus', class: 'w-4 h-4') %>
          <%= t('bali_view.filters.add_group') %>
        </button>

        <div class="divider my-0"></div>

        <%# Actions %>
        <div class="flex flex-col sm:flex-row justify-end gap-2">
          <button type="button"
                    class="btn btn-ghost order-2 sm:order-1"
                    data-action="filters#reset">
            <%= t('bali_view.filters.reset') %>
          </button>
          <button type="submit"
                    class="btn btn-primary order-1 sm:order-2"
                    data-action="filters#apply"
                    data-filters-target="applyButton">
            <%= render Bali::Icon::Component.new('check', class: 'w-4 h-4') %>
            <%= t('bali_view.filters.apply_filters') %>
          </button>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# Template for new filter group (used by Stimulus) %>
  <template data-filters-target="groupTemplate">
    <%= render Bali::Filters::FilterGroup::Component.new(
          group: { combinator: 'or', conditions: [{ attribute: '', operator: 'cont', value: '' }] },
          index: '__GROUP_INDEX__',
          available_attributes: available_attributes,
          removable: true
        ) %>
  </template>
</div>
