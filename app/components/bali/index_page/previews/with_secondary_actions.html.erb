<%= render Bali::IndexPage::Component.new(
  title: 'Session calendars',
  subtitle: 'Board and committee sessions by year',
  breadcrumbs: [
    { name: 'Dashboard', href: '/lookbook', icon: 'home' },
    { name: 'Session calendars' }
  ],
  secondary_actions_width: secondary_actions_width,
  secondary_actions_label: secondary_actions_label
) do |page| %>
  <% page.with_action do %>
    <%= render Bali::Link::Component.new(name: 'Plan 2027', href: '#', variant: :primary, icon: 'calendar-days') %>
  <% end %>
  <% page.with_secondary_action(name: 'View approval flow', href: '#', icon: 'eye') %>
  <% page.with_secondary_action(name: 'Publish 4 pending or failed notices', href: '#', icon: 'send') %>
  <% page.with_body do %>
    <%= render Bali::Card::Component.new(style: :bordered) do %>
      <p class="text-base-content/60">DataTable would go here.</p>
    <% end %>
  <% end %>
<% end %>
