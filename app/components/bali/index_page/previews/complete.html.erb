<%# The canonical index page: page chrome (breadcrumbs, title, primary action) plus the
    DataTable body shared with `data_table/complete`, so the reference composition is
    written once. %>
<%= render Bali::IndexPage::Component.new(
      title: 'Movies',
      subtitle: 'Every toolbar control family, row selection and pagination',
      breadcrumbs: [
        { name: 'Dashboard', href: '/lookbook', icon_name: 'home' },
        { name: 'Movies' }
      ]
    ) do |page| %>
  <% page.with_action do %>
    <%= render Bali::Link::Component.new(name: 'New Movie', href: '#', variant: :primary,
                                         icon_name: 'plus') %>
  <% end %>

  <%# The DataTable goes in bare: the surface travels with its content slot. %>
  <% page.with_body do %>
    <%= render partial: 'bali/data_table/previews/canonical_index',
               locals: {
                 url: request.path,
                 filter_form: filter_form,
                 pagy: pagy,
                 movies: movies,
                 display_mode: display_mode
               } %>
  <% end %>
<% end %>
