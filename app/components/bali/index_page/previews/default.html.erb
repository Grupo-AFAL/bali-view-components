<%= render Bali::IndexPage::Component.new(
  title: 'Movies',
  subtitle: '24 movies total',
  breadcrumbs: [
    { name: 'Dashboard', href: '/lookbook', icon: 'home' },
    { name: 'Movies' }
  ]
) do |page| %>
  <% page.with_action do %>
    <%= render Bali::Link::Component.new(name: 'New Movie', href: '#', variant: :primary, icon: 'plus') %>
  <% end %>
  <%# Este escenario ejerce SOLO la capa de página (breadcrumbs, header, acción, body).
      El listado de verdad vive en el escenario "Complete", que es la referencia a copiar. %>
  <% page.with_body do %>
    <%= render Bali::Alert::Component.new(color: :info) do %>
      Page layer only. See the <strong>Complete</strong> scenario for the canonical index
      body: a DataTable with the seven toolbar control families, row selection and pagination.
    <% end %>
  <% end %>
<% end %>
