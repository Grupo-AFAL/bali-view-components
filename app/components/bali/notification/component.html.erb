<%# `render_parent` renders Bali::Toast's template into the buffer at this point,
    so the wrapper below nests it. `fixed:` used to put the alert itself in the
    corner; the replacement is a Bali::ToastContainer, whose classes this reuses. %>
<% if fixed? %>
  <div class="<%= container_classes %>"><%= render_parent %></div>
<% else %>
  <%= render_parent %>
<% end %>
