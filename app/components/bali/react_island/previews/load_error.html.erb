<%= react_island_meta_tags('react-island-demo', js: 'island-demo.js') %>

<%# Two mounts, because a load failure has two shapes and only one of them was
    visible:

    1. EMPTY mount: the island had nothing server-rendered to show, so the error
       notice is all that is left.
    2. Mount WITH CONTENT: what the server painted inside IS the fallback
       (Bali::Gantt puts its loading skeleton there). If the bundle never arrives,
       that content has to SURVIVE and the notice go on top — not the other way
       round. %>

<h3 class="mb-2 text-sm font-semibold">Empty mount</h3>
<div
  data-controller="react-island-demo"
  data-react-island-demo-fail-load-value="true"
></div>

<h3 class="mt-6 mb-2 text-sm font-semibold">Mount with a server-rendered fallback</h3>
<div
  id="island-with-fallback"
  data-controller="react-island-demo"
  data-react-island-demo-fail-load-value="true"
>
  <div data-testid="fallback-server" class="rounded border border-base-300 p-3">
    <p>Server-rendered content: this is the fallback for the island.</p>
    <a href="/lookbook" class="link">A link that still works</a>
  </div>
</div>
