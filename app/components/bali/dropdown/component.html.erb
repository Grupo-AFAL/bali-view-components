<%= tag.div(**dropdown_attributes) do %>
  <%= trigger? ? trigger : default_trigger %>
  <%# `<ul role="menu">` only when the content ARE menuitems (see `menu:`).
      In popover mode the panel is rendered HERE all the same: the controller picks it up
      from this place and only then does tippy move it to the popper, so the served HTML
      is the same in both modes and the menu stays a descendant of the controller's
      element for everything other than painting itself. %>
  <%= content_tag(menu_tag_name, menu_attributes) do %>
    <% if authorized_items.any? %>
      <% authorized_items.each do |item| %>
        <li role="none"><%= item %></li>
      <% end %>
    <% else %>
      <%= content %>
    <% end %>
  <% end %>
<% end %>
