<div class="header mb-4 flex items-center justify-between">
  <div class="flex-none">
    <% if route_path.present? %>
      <%= render Bali::Link::Component.new(href: route(extra_params(:prev)), variant: :ghost, aria: { label: t('bali_view.calendar.header.previous') }) do %>
        <%= render Bali::Icon::Component.new('arrow-left') %>
      <% end %>
    <% end %>
  </div>
  <div class="flex items-center gap-3">
    <h3 class="text-2xl font-bold">
      <%# A year view spans every month, so naming one of them in the title would be
          wrong rather than merely redundant. %>
      <% if period == :year %>
        <%= start_date.year %>
      <% else %>
        <%= t('date.month_names')[start_date.month] %> <%= start_date.year %>
      <% end %>
    </h3>
    <% if period_switch? %>
      <% switch_periods.each do |switch_period| %>
        <%= render Bali::Link::Component.new(
              name: t("bali_view.calendar.header.#{switch_period}"),
              href: route(extra_params(switch_period)),
              variant: :primary,
              style: switch_style(switch_period)
            ) %>
      <% end %>
    <% end %>
  </div>
  <div class="flex-none">
    <% if route_path.present? %>
      <%= render Bali::Link::Component.new(href: route(extra_params(:next)), variant: :ghost, aria: { label: t('bali_view.calendar.header.next') }) do %>
        <%= render Bali::Icon::Component.new('arrow-right') %>
      <% end %>
    <% end %>
  </div>
</div>
