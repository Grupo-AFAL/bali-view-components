<div class="calendar-component">
  <%= render Bali::Card::Component.new(class: card_class) do %>
    <%= header %>
    <% if year_view? %>
      <%= render year_grid_component %>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table table-fixed w-full">
          <thead>
            <tr>
              <% date_range.first(header_day_count).each do |day| %>
                <%# `py-2 px-0 border-none` are utilities here, not only index.css's
                    `.table th` rule: daisyUI styles `.table` cells from
                    @layer utilities, which beats the component sheet.
                    The full name needs a 98px column, what «Wednesday» measures at
                    text-lg; in less it spills out of its column, and at 390px each
                    name ran into the next. The query is on the
                    column, so `weekdays_only` and a host's sidebar count, and on a
                    div because a table cell cannot be a size container. %>
                <th class="text-center font-normal text-lg py-2 px-0 border-none">
                  <div class="@container">
                    <span class="hidden @min-[6.125rem]:inline"><%= t('date.day_names')[day.wday] %></span>
                    <span class="text-sm @min-[6.125rem]:hidden"><%= t('date.abbr_day_names')[day.wday] %></span>
                  </div>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% date_range.each_slice(7) do |week| %>
              <%= content_tag :tr, class: tr_classes_for(week) do %>
                <% filter_week(week).each do |day| %>
                  <%= content_tag :td, class: td_classes_for(day) do %>
                    <% if show_date %>
                      <div class="<%= date_display_classes %>"><%= day.day %></div>
                    <% end %>
                    <% if template.present? %>
                      <%= render template, events: sorted_events[day], period: period, day: day %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    <%= footer %>
  <% end %>
</div>
