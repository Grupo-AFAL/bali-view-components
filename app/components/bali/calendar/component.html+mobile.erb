<%# Every other period answers "phone" with the day view; the year grid reflows
    to one column instead, so it is not replaced by a single day. %>
<% if year_view? %>
  <div class="calendar-component">
    <%= render Bali::Card::Component.new(class: card_class) do %>
      <%= header %>
      <%= render year_grid_component %>
      <%= footer %>
    <% end %>
  </div>
<% else %>
  <div class="calendar-component">
    <div class="day-view">
      <%= render(Bali::Columns::Component.new(mobile: true, middle: true)) do |c| %>
        <% if header? %>
          <%= c.with_column(auto: true) do %>
            <%= render Bali::Link::Component.new(icon: 'chevron-left', **header.day_arrow_options(:prev, prev_day)) %>
          <% end %>
        <% end %>
        <%= c.with_column(class: 'text-center') do %>
          <span class="text-lg text-base-content/70 font-normal">
            <%= day_title %>
          </span>
        <% end %>
        <% if header? %>
          <%= c.with_column(auto: true) do %>
            <%= render Bali::Link::Component.new(icon: 'chevron-right', **header.day_arrow_options(:next, next_day)) %>
          <% end %>
        <% end %>
      <% end %>
      <div class="divider"></div>
      <% if template.present? %>
        <%= render template, events: sorted_events[start_date], period: :day, day: start_date %>
      <% end %>
    </div>
  </div>
<% end %>
