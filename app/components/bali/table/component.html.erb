<%= tag.div(id: container_id, **table_container_options) do %>
  <%= tag.table(**options) do %>
    <thead>
      <tr>
        <% if selectable? %>
          <th class="w-4">
            <%# `bulk_actions_group` acota este seleccionar-todo a las filas de esta tabla;
                nil no emite atributo, y sin atributo el universo es toda la selección. %>
            <%= tag.input type: 'checkbox', class: 'checkbox checkbox-sm', 'aria-label': t('.select_all'),
                          data: { bulk_actions_target: 'selectAll', bulk_actions_group: select_group,
                                  action: 'change->bulk-actions#toggleAll' } %>
          </th>
        <% end %>
        <% visible_headers.each do |header| %>
          <%= header %>
        <% end %>
      </tr>
    </thead>
    <%= tag.tbody(**tbody_options) do %>
      <% if rows.any? %>
        <% if grouped? %>
          <% row_groups.each do |group| %>
            <tr class="bali-table-group-row">
              <% if selectable? %>
                <%# El seleccionar-todo del grupo va en SU PROPIA celda, alineado con la
                    columna de casillas de las filas; el acento de la izquierda se muda con
                    él, que ahora es la celda de más a la izquierda. Un grupo sin ninguna
                    fila seleccionable deja la celda vacía: la casilla no marcaría nada. %>
                <%= tag.td(class: "w-4 bg-base-300 border-l-4 border-l-primary") do %>
                  <% if group_selectable?(group) %>
                    <%= tag.input type: 'checkbox', class: 'checkbox checkbox-sm',
                                  'aria-label': t('.select_all_group', group: group_label(group.value)),
                                  data: { bulk_actions_target: 'selectAll',
                                          bulk_actions_group: group_token(group.value),
                                          action: 'change->bulk-actions#toggleAll' } %>
                  <% end %>
                <% end %>
              <% end %>
              <%= tag.td(group_header_text(group), colspan: visible_headers.count,
                         class: class_names("bg-base-300 font-semibold text-sm text-base-content",
                                            "border-l-4 border-l-primary" => !selectable?)) %>
            </tr>
            <% group.rows.each do |row| %><%= row %><% end %>
          <% end %>
        <% else %>
        <%# Kept at this indent so the no-group output is byte-identical to the pre-grouping template. %>
        <% rows.each do |row| %><%= row %><% end %>
        <% end %>
      <% else %>
        <tr id="<%= empty_table_row_id %>">
          <%# `group_colspan` y no `headers.count`: suma la columna de selección y descuenta
              los headers ocultos, así el empty state cubre el ancho REAL de la tabla. %>
          <td class="empty-table text-center" colspan="<%= group_colspan %>">
            <% if custom_empty_state_content.present? %>
              <div class="<%= Bali::EmptyState::Component.container_classes %>">
                <%= custom_empty_state_content %>
              </div>
            <% else %>
              <%= render Bali::EmptyState::Component.new(title: empty_state_title) do |empty_state| %>
                <% if empty_state_cta.present? %>
                  <% empty_state.with_cta do %><%= empty_state_cta %><% end %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
    <% if footers.any? %>
      <tfoot>
        <% footers.each do |footer| %><%= footer %><% end %>
      </tfoot>
    <% end %>
  <% end %>
<% end %>
