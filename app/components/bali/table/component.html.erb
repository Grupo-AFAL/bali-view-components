<%= tag.div(id: container_id, **table_container_options) do %>
  <%= tag.table(**options) do %>
    <thead>
      <tr>
        <% if selectable? %>
          <th class="w-4">
            <%# `bulk_actions_group` scopes this select-all to the rows of this table;
                nil emits no attribute, and with no attribute the universe is the whole selection. %>
            <%= tag.input type: 'checkbox', class: 'checkbox checkbox-sm', 'aria-label': t('.select_all'),
                          data: { bulk_actions_target: 'selectAll', bulk_actions_group: select_group,
                                  action: 'change->bulk-actions#toggleAll' } %>
          </th>
        <% end %>
        <% visible_headers.each do |header| %>
          <%= header %>
        <% end %>
      </tr>
    </thead>
    <%= tag.tbody(**tbody_options) do %>
      <% if rows.any? %>
        <% if grouped? %>
          <% row_groups.each do |group| %>
            <tr class="bali-table-group-row">
              <% if selectable? %>
                <%# The group select-all goes in ITS OWN cell, aligned with the rows'
                    checkbox column; the left accent moves with it, since it is now the
                    leftmost cell. A group with no selectable row leaves the cell empty:
                    the checkbox would mark nothing. %>
                <%= tag.td(class: "w-4 bg-base-300 border-l-4 border-l-primary") do %>
                  <% if group_selectable?(group) %>
                    <%= tag.input type: 'checkbox', class: 'checkbox checkbox-sm',
                                  'aria-label': t('.select_all_group', group: group_label(group.value)),
                                  data: { bulk_actions_target: 'selectAll',
                                          bulk_actions_group: group_token(group.value),
                                          action: 'change->bulk-actions#toggleAll' } %>
                  <% end %>
                <% end %>
              <% end %>
              <% if collapsible_groups? %>
                <%# The whole band is the button: the chevron rotates with `aria-expanded`
                    and the content —text or `with_group_header` block— is its accessible
                    name. The group checkbox stays OUTSIDE, in its own cell: a control
                    inside another control is invalid HTML. %>
                <%= tag.td(**group_header_cell_options) do %>
                  <%= tag.button(**group_trigger_options(group)) do %>
                    <%= render Bali::Icon::Component.new('chevron-down', class: Bali::Table::Component::GROUP_CHEVRON_CLASSES) %>
                    <%= group_header_content(group) %>
                  <% end %>
                <% end %>
              <% else %>
                <%= tag.td(group_header_content(group), **group_header_cell_options) %>
              <% end %>
            </tr>
            <% group.rows.each do |row| %><%= row %><% end %>
          <% end %>
        <% else %>
        <%# Kept at this indent so the no-group output is byte-identical to the pre-grouping template. %>
        <% rows.each do |row| %><%= row %><% end %>
        <% end %>
      <% else %>
        <tr id="<%= empty_table_row_id %>">
          <%# `group_colspan` and not `headers.count`: it adds the selection column and
              discounts the hidden headers, so the empty state covers the table's REAL width. %>
          <td class="empty-table text-center" colspan="<%= group_colspan %>">
            <% if custom_empty_state_content.present? %>
              <div class="<%= Bali::EmptyState::Component.container_classes %>">
                <%= custom_empty_state_content %>
              </div>
            <% else %>
              <%= render Bali::EmptyState::Component.new(title: empty_state_title) do |empty_state| %>
                <% if empty_state_cta.present? %>
                  <% empty_state.with_cta do %><%= empty_state_cta %><% end %>
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
    <% if footers.any? %>
      <tfoot>
        <% footers.each do |footer| %><%= footer %><% end %>
      </tfoot>
    <% end %>
  <% end %>
<% end %>
