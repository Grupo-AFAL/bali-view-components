<% if @skip_tr %>
  <%= content %>
<% else %>
  <%= tag.tr(**tr_options) do %>
    <% if @select_column %>
      <%# The cell is rendered even when the row is NOT selectable: if the table brings the
          column and a row skips it, that row's columns shift one position. %>
      <%= tag.td(class: 'w-4') do %>
        <% if @selectable %>
          <%# Explicit `change->`: Stimulus' default for an input is `input`, and `change`
              also does NOT fire when JS sets `.checked` (without it, syncing the checkbox
              from the controller re-enters the same handler). %>
          <%= tag.input(type: 'checkbox', class: 'checkbox checkbox-sm', value: @record_id,
                        'aria-label': select_label,
                        data: { action: 'change->bulk-actions#toggleItem' }) %>
        <% end %>
      <% end %>
    <% end %>
    <%= content %>
  <% end %>
<% end %>
