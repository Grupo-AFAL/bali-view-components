<% if @skip_tr %>
  <%= content %>
<% else %>
  <%= tag.tr(**tr_options) do %>
    <% if @selectable %>
      <%= tag.td(class: 'w-4') do %>
        <%# `change->` explícito: el default de Stimulus para un input es `input`, y `change`
            además NO se dispara cuando el JS setea `.checked` (sin eso, sincronizar el
            checkbox desde el controlador vuelve a entrar al mismo handler). %>
        <%= tag.input(type: 'checkbox', class: 'checkbox checkbox-sm', value: @record_id,
                      'aria-label': select_label,
                      data: { action: 'change->bulk-actions#toggleItem' }) %>
      <% end %>
    <% elsif @bulk_actions %>
      <%= tag.td(class: 'w-4') do %>
        <%= tag.input(type: 'checkbox', class: 'checkbox checkbox-sm', value: @record_id, data: { table_target: 'checkbox', action: 'table#toggle' }) %>
      <% end %>
    <% end %>
    <%= content %>
  <% end %>
<% end %>
