<%= form_with(url: '/') do |f| %>
  <%= render(Bali::ImageField::Component.new(size: :lg)) do |c| %>
    <% c.with_input(form: f, method: :avatar) %>
    <% c.with_clear_button do %>
      <%= render Bali::Button::Component.new(
            icon: 'trash-2',
            type: :button,
            variant: :error,
            class: 'btn-circle btn-sm absolute -top-2 -right-2 opacity-0 pointer-events-none ' \
                   'group-hover/image-field:opacity-100 group-hover/image-field:pointer-events-auto ' \
                   'group-has-focus-visible/image-field:opacity-100 max-md:opacity-100 max-md:pointer-events-auto',
            data: { action: 'image-field#clear' },
            aria: { label: 'Delete image' }
          ) %>
    <% end %>
  <% end %>
<% end %>