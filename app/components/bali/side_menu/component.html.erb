<%= tag.nav(**container_options) do %>
  <%# Header with collapse toggle.
      Height comes from the shared `--bali-chrome-height` variable so the row
      stays aligned horizontally with the AppLayout topbar — both share one
      continuous border-b across the top. %>
  <% if collapsible? %>
    <%# Expanded state header - toggle on the right.
        `aria-expanded` is static on both collapse buttons on purpose: the two
        headers are mutually exclusive (CSS shows exactly one), so the button
        that is in the accessibility tree always carries the true value. %>
    <div class="side-menu-expanded flex bali-chrome-height items-center gap-2 py-3 px-2.5 border-b border-base-300">
      <% if brand_present? %>
        <span class="side-menu-brand text-xl font-semibold grow items-center gap-2 min-w-0">
          <%= brand || @brand %>
        </span>
      <% else %>
        <span class="grow"></span>
      <% end %>
      <%# Desktop: collapse toggle %>
      <button type="button"
              title="<%= collapse_label %>"
              aria-label="<%= collapse_label %>"
              aria-controls="<%= id %>"
              aria-expanded="true"
              data-action="side-menu#toggleCollapse"
              class="menu-item p-2 shrink-0 max-lg:hidden">
        <%= render Bali::Icon::Component.new('panel-left-close', class: 'size-4') %>
      </button>
      <% if fixed? %>
        <%# Mobile: close sidebar button %>
        <button type="button"
                title="<%= close_label %>"
                aria-label="<%= close_label %>"
                data-action="side-menu#close"
                class="menu-item p-2 shrink-0 lg:hidden">
          <%= render Bali::Icon::Component.new('x', class: 'size-4') %>
        </button>
      <% end %>
    </div>
    <%# Collapsed state header - toggle centered like menu items %>
    <div class="side-menu-collapsed hidden bali-chrome-height items-center px-1 border-b border-base-300">
      <button type="button"
              title="<%= expand_label %>"
              aria-label="<%= expand_label %>"
              aria-controls="<%= id %>"
              aria-expanded="false"
              data-action="side-menu#toggleCollapse"
              class="collapse-toggle menu-item justify-center w-full">
        <%= render Bali::Icon::Component.new('panel-left-open', class: 'size-4') %>
      </button>
    </div>
  <% elsif brand_present? || fixed? %>
    <div class="flex bali-chrome-height items-center gap-2 px-2.5 border-b border-base-300">
      <% if brand_present? %>
        <span class="side-menu-brand text-xl font-semibold grow items-center gap-2 min-w-0">
          <%= brand || @brand %>
        </span>
      <% else %>
        <span class="grow"></span>
      <% end %>
      <% if fixed? %>
        <button type="button"
                title="<%= close_label %>"
                aria-label="<%= close_label %>"
                data-action="side-menu#close"
                class="menu-item p-2 shrink-0 lg:hidden">
          <%= render Bali::Icon::Component.new('x', class: 'size-4') %>
        </button>
      <% end %>
    </div>
  <% end %>

  <%# Menu switcher dropdown (when multiple menus) %>
  <% if multiple_menus? %>
    <div class="menu-switcher mb-3 mt-3">
      <%# Use <details><summary> instead of focus-based dropdown — the focus
          pattern is fragile on iOS Safari (focus loss on slide-in animation,
          blur on scroll). <details> uses native browser toggling and works
          reliably on all touch devices. %>
      <details class="dropdown dropdown-bottom w-full">
        <summary class="menu-switcher-trigger tooltip tooltip-right border-base-300 hover:bg-base-200 rounded-box flex w-full items-center gap-2 border p-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
                 data-tip="<%= active_menu.title %>">
          <%= active_menu %>
          <%= render Bali::Icon::Component.new('chevrons-up-down', class: 'menu-switcher-chevron ml-auto size-4 text-base-content/50') %>
        </summary>
        <ul class="dropdown-content menu bg-base-100 rounded-box z-[var(--bali-z-dropdown)] mt-1 w-full p-2 shadow-lg">
          <% authorized_menus.each do |menu| %>
            <li>
              <a href="<%= menu.href %>" class="<%= 'active' if menu == active_menu %>">
                <%= menu %>
              </a>
            </li>
          <% end %>
        </ul>
      </details>
    </div>
  <% end %>

  <%# Main menu content with scrolling %>
  <div class="sidebar-menu custom-scrollbar grow overflow-auto">
    <% lists.each do |list| %>
      <%= list %>
    <% end %>
  </div>

  <%# Bottom pinned items and groups %>
  <% if bottom_items? || bottom_groups? %>
    <ul class="side-menu-bottom-section border-t border-base-200 shrink-0 space-y-0.5 py-2">
      <% bottom_items.each do |item| %>
        <li><%= item %></li>
      <% end %>
      <% bottom_groups.each do |group| %>
        <li><%= group %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<%# Scrim for the mobile overlay. Not focusable and hidden from assistive tech:
    Escape and the close button are the keyboard paths out. It sits outside the
    <nav> so it can stack below it, so it carries its own trigger controller
    instead of a `side-menu#close` action. %>
<% if fixed? %>
  <div class="side-menu-overlay"
       aria-hidden="true"
       data-controller="side-menu-trigger"
       data-side-menu-trigger-menu-id-value="<%= id %>"
       data-action="click->side-menu-trigger#close"></div>
<% end %>
