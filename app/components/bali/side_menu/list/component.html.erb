<% if title.present? %>
  <p class="<%= title_classes %>">
    <span><%= title %></span>
    <%= render_badge %>
  </p>
<% end %>
<%# A menu is a list of links, so it is marked up as one: a screen reader
    announces how many items the section has and where in it you are. The
    section title stays a <p>: the sidebar renders before <main>, so headings
    here would land above the page's own h1 and break heading order. %>
<ul class="side-menu-list space-y-0.5 px-2.5">
  <% items.each do |item| %>
    <li><%= item %></li>
  <% end %>
</ul>
