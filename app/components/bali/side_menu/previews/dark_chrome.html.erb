<%# El chrome oscuro: el sidebar lleva su propio data-theme y la página se queda
    clara. El tema usado acá es el `dark` que ya trae daisyUI, a propósito — el
    de cada app es de marca y no viaja en la gema. %>
<div class="h-[640px] bg-base-200 p-4 flex gap-4">
  <div class="w-xs">
    <%= render Bali::SideMenu::Component.new(current_path: '/admin/movies', fixed: false,
                                             collapsible: true, brand: 'MovieDB',
                                             theme: theme.presence) do |menu|
      menu.with_list(title: 'Main') do |list|
        list.with_item(name: 'Dashboard', href: '/admin', icon: 'layout-dashboard', match: :exact)
        list.with_item(name: 'Movies', href: '/admin/movies', icon: 'film', match: :crud)
        list.with_item(name: 'Studios', href: '/admin/studios', icon: 'building-2', match: :crud)
      end

      menu.with_list(title: 'Reports') do |list|
        list.with_item(name: 'Analytics', href: '#', icon: 'bar-chart-3')
        list.with_item(name: 'Revenue', href: '#', icon: 'dollar-sign')
      end

      menu.with_bottom_item(name: 'Ana García', href: '#', icon: 'circle-user')
      menu.with_bottom_group(name: 'Configuration', icon: 'settings') do |group|
        group.with_item(name: 'Profile', href: '#', icon: 'circle-user')
        group.with_item(name: 'Settings', href: '#', icon: 'settings')
        group.with_item(name: 'Log Out', href: '#', icon: 'log-out')
      end
    end %>
  </div>

  <div class="flex-1">
    <%= render Bali::Card::Component.new(style: :bordered) do |card| %>
      <% card.with_title('La página no cambia') %>
      <p class="text-sm text-base-content/70">
        El <code>data-theme</code> va en el <code>&lt;nav&gt;</code>, así que daisyUI
        resuelve sus variables de color contra el sidebar y deja el resto de la
        página con el tema del documento.
      </p>
      <p class="text-sm text-base-content/70 mt-2">
        Abrí <strong>Configuration</strong> abajo del sidebar: el panel flotante es
        lo que se pierde sobre una superficie oscura si nadie le pone borde —
        la sombra suave de daisyUI no se ve contra un fondo oscuro.
      </p>
    <% end %>
  </div>
</div>
