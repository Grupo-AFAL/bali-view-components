<%= tag.div(**component_attributes) do %>
  <% items.each do |item| %>
    <%= item %>
  <% end %>

  <%= content %>

  <% if actions.any? %>
    <%# Live region ALWAYS present and never in display:none: the counter lives inside a
        container that starts hidden, and a live region that appears together with its text
        is not announced. Without this, selecting rows told the screen reader NOTHING — not
        the count, not that bulk actions had appeared, not that the search and the filters
        had left the page (WCAG 2.1 SC 4.1.3). The server serves the plural in two data
        attributes so i18n is not interpolated in JS. %>
    <%= tag.div class: 'sr-only', role: 'status', 'aria-live': 'polite', 'aria-atomic': 'true',
                data: { bulk_actions_target: 'announcement',
                        selected_one: t('.selected_one'), selected_other: t('.selected_other') } %>

    <%= tag.div class: bar_classes, data: { bulk_actions_target: 'actionsContainer' } do %>
      <%= tag.div class: bar_inner_classes do %>
        <% if toolbar? %>
          <%= tag.div class: CLASSES[:toolbar_counter_wrapper] do %>
            <%= tag.span '0', class: CLASSES[:toolbar_counter], data: { bulk_actions_target: 'selectedCount' } %>
            <%= tag.span t('.selected_one'), class: 'hidden', data: { bulk_actions_target: 'selectedLabelOne' } %>
            <%= tag.span t('.selected_other'), data: { bulk_actions_target: 'selectedLabelOther' } %>
          <% end %>
        <% else %>
          <%= tag.div '0', class: CLASSES[:counter], data: { bulk_actions_target: 'selectedCount' } %>
        <% end %>

        <%= tag.div class: actions_wrapper_classes do %>
          <% if select_all_filtered? %>
            <%# The offer shows up when the selection already covers the whole page and
                there are more results behind it (the JS compares N against the rows it
                sees). N travels in a data attribute and the text comes already pluralized
                from the server: the same treatment the live region gives
                `selected_one/other`, so i18n is not interpolated in JS. %>
            <%= tag.div class: CLASSES[:select_all_offer],
                        data: { bulk_actions_target: 'selectAllOffer', total_count: total_count } do %>
              <%= render Bali::Button::Component.new(
                    name: t('.select_all_filtered', count: total_count),
                    variant: :link, size: :xs, responsive: false,
                    data: { action: 'bulk-actions#selectAllFiltered' }
                  ) %>
            <% end %>

            <%= tag.span t('.all_filtered_selected', count: total_count),
                         class: CLASSES[:select_all_notice],
                         data: { bulk_actions_target: 'selectAllNotice' } %>
          <% end %>

          <% actions.each do |action| %>
            <%= action %>
          <% end %>
        <% end %>

        <% if toolbar? %>
          <%= render Bali::Button::Component.new(
                icon: 'times', variant: :ghost, size: :xs, responsive: false,
                'aria-label': t('.clear'),
                data: { action: 'bulk-actions#clear' }
              ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
