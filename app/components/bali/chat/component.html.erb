<%= tag.div(**wrapper_attributes) do %>
  <% if header? %>
    <div class="shrink-0 border-b border-base-300 p-4"><%= header %></div>
  <% end %>
  <%# `scroll->chat#trackPosition` has to sit on the element that scrolls: scroll
      events do not bubble, so the same action on the wrapper would never fire and
      the controller would think the reader never left the bottom. %>
  <%= tag.div(id: id, class: messages_classes,
              data: { chat_target: "messages", action: "scroll->chat#trackPosition" }) do %>
    <%= content %>
  <% end %>
  <% if footer? || own_composer? %>
    <div class="shrink-0 border-t border-base-300 p-4" data-action="turbo:submit-end->chat#followSubmit">
      <% if footer? %>
        <%= footer %>
      <% else %>
        <%= form_with(**composer_form_options) do %>
          <%= render composer_component do |row| %>
            <% composer_actions.each { |action| row.with_action { action.to_s } } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
