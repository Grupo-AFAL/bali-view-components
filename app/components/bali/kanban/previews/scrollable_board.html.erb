<%= render Bali::Kanban::Component.new(
      resource_name: "task",
      group_name: "kanban",
      layout: :flow,
      height: :viewport
    ) do |k| %>
  <% k.with_column(title: "Backlog", status: "backlog", color: :ghost) do |col| %>
    <% 12.times do |i| %>
      <% col.with_card(update_url: "/tasks/#{i + 1}") do %>
        <p class="font-medium text-sm">Backlog task <%= i + 1 %></p>
        <p class="text-xs text-base-content/60 mt-1">Unscheduled</p>
      <% end %>
    <% end %>
  <% end %>

  <% k.with_column(title: "To Do", status: "todo", color: :info) do |col| %>
    <% col.with_card(update_url: "/tasks/20") do %>
      <p class="font-medium text-sm">Design landing page</p>
      <p class="text-xs text-base-content/60 mt-1">Due: Mar 25</p>
    <% end %>
    <% col.with_card(update_url: "/tasks/21") do %>
      <p class="font-medium text-sm">Write API docs</p>
      <p class="text-xs text-base-content/60 mt-1">Due: Mar 28</p>
    <% end %>
  <% end %>

  <% k.with_column(title: "In Progress", status: "in_progress", color: :warning) do |col| %>
    <% col.with_card(update_url: "/tasks/30") do %>
      <p class="font-medium text-sm">Implement auth flow</p>
      <p class="text-xs text-base-content/60 mt-1">Due: Mar 22</p>
    <% end %>
  <% end %>

  <% k.with_column(title: "Blocked", status: "blocked", color: :error, disabled: true) do |col| %>
    <% col.with_card(update_url: "/tasks/40") do %>
      <p class="font-medium text-sm">Payments integration</p>
      <p class="text-xs text-base-content/60 mt-1">Waiting on vendor</p>
    <% end %>
  <% end %>

  <% k.with_column(title: "Done", status: "done", color: :success) %>
<% end %>
