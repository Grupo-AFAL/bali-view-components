<div class="bg-base-100 rounded-xl shadow-sm border border-base-200 p-4 <%= options[:class] %>">
  <h3 class="font-semibold mb-3 flex items-center gap-2">
    <%= render Bali::Tag::Component.new(**indicator_options) %>
    <%= title %>
    <% if display_count > 0 %>
      <%= render Bali::Tag::Component.new(text: display_count.to_s, color: :ghost, size: :sm) %>
    <% end %>
  </h3>

  <%# The stack of cards is a list, and its accessible name carries the count so
      an empty column announces as empty instead of as a list of nothing. The
      count badge above stays hidden at zero — there is nothing to look at — but
      the announcement says "0 cards" either way. %>
  <%= render Bali::SortableList::Component.new(
        **sortable_options,
        class: "space-y-2 min-h-[100px]",
        role: "list",
        'aria-label': list_label,
        data: { kanban_column_title: title }
      ) do %>
    <% cards.each do |card| %>
      <%= card %>
    <% end %>
  <% end %>

  <% if footer? %>
    <div class="kanban-column-footer mt-2 pt-2 border-t border-base-200">
      <%= footer %>
    </div>
  <% end %>
</div>
