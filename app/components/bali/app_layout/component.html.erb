<body class="<%= container_classes %>" <%= tag.attributes(container_attributes) %>>
  <%# 0. Skip link — first focusable element on the page, so the very first Tab
      offers it. Off-screen until focused; the reveal lives in ./index.css next
      to the default that hides it, because a `sr-only` utility on the element
      would beat a `:focus` rule in @layer components and the link would never
      appear. %>
  <% if render_skip_link? %>
    <a href="#<%= main_id %>" class="bali-skip-link"><%= skip_link_label %></a>
  <% end %>

  <%# 1. Banner (impersonation, maintenance, beta) — a full-width strip above
      everything, including the pinned sidebar, which starts below it. The
      target is what the controller measures; the offset itself is CSS. %>
  <% if banner? %>
    <div class="app-layout-banner" data-app-layout-target="banner"><%= banner %></div>
  <% end %>

  <%# 2. Navbar (full-width) %>
  <% if navbar? %>
    <div class="app-layout-navbar"><%= navbar %></div>
  <% end %>

  <%# 3. Main area: sidebar + content %>
  <div class="app-layout-main flex flex-1 min-h-0">
    <% if sidebar? %><%= sidebar_markup %><% end %>

    <div class="app-layout-content flex-1 min-w-0 flex flex-col">
      <% if topbar? %>
        <div class="app-layout-topbar"><%= topbar %></div>
      <% elsif render_default_mobile_topbar? %>
        <header class="app-layout-topbar app-layout-topbar--default-mobile flex items-center gap-2 px-4 py-2 bg-base-100 border-b border-base-300 lg:hidden">
          <%= render Bali::SideMenu::Trigger::Component.new(menu_id: default_menu_id) %>
          <% if @app_name.present? %>
            <span class="font-semibold text-sm"><%= @app_name %></span>
          <% end %>
        </header>
      <% end %>

      <main id="<%= main_id %>" tabindex="-1" class="flex-1" <%= tag.attributes(main_attributes) %>>
        <div class="<%= body_container_classes %>">
          <%= body? ? body : content %>
        </div>

        <% if @modal %>
          <%= render Bali::Modal::Component.new(id: "main-modal", active: false, size: @modal_size) do %>
            <%= render Bali::Skeleton::Component.new(variant: :modal) %>
          <% end %>
        <% end %>

        <% if @drawer %>
          <%= render Bali::Drawer::Component.new(
            drawer_id: "main-drawer",
            size: @drawer_size,
            active: false
          ) do %>
            <%= render Bali::Skeleton::Component.new(variant: :list, lines: 5) %>
          <% end %>
        <% end %>
      </main>
    </div>
  </div>

  <%# 4. Flash toasts. The stack used to be hand-written here, around a
      FlashNotifications that only knew `notice:` and `alert:`; Bali::ToastContainer
      is that markup, and it reads every flash key it recognises. The wrapper also
      used to be an `aria-live` region containing alerts that were live regions
      themselves — nesting that made announcements unreliable. The toasts keep
      their roles; the container is now plain furniture. %>
  <% if flash_toasts? %>
    <%= render Bali::ToastContainer::Component.new(id: "toast-notifications", flash: flash_hash) %>
  <% end %>
</body>
