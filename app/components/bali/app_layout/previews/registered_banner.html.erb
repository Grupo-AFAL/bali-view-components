<%# Registered for this render only: Bali.layout_banners is one Hash for the
    whole process, and every other AppLayout preview would paint it too. %>
<% Bali.layout_banners[:lookbook_impersonation] = lambda do |view|
  view.render(Bali::Alert::Component.new(color: :warning, icon: "eye", class: "rounded-none")) do
    view.tag.div(class: "flex flex-wrap items-center justify-between gap-2") do
      view.safe_join([
        view.tag.span { view.safe_join([ "You are viewing as ", view.tag.strong("Ana García"), " (ana@example.com)" ]) },
        view.render(Bali::Button::Component.new(name: "Stop impersonating", variant: :neutral, size: :sm))
      ])
    end
  end
end %>
<% begin %>
  <%= render Bali::AppLayout::Component.new(
    fixed_sidebar: true,
    viewport_locked: false,
    modal: false,
    drawer: false
  ) do |layout|
    if slot_banner
      layout.with_banner do %>
        <%= render Bali::Alert::Component.new(color: :info, icon: "clipboard-check", class: "rounded-none") do %>
          The page's own banner, from <code>with_banner</code>: it stacks under the registered one.
        <% end %>
      <% end
    end

    layout.with_sidebar do %>
      <%= render Bali::SideMenu::Component.new(current_path: '/admin', brand: 'MovieDB') do |menu|
        menu.with_list(title: 'Main') do |list|
          list.with_item(name: 'Dashboard', href: '/admin', icon: 'layout-dashboard', match: :exact)
          list.with_item(name: 'Movies', href: '/admin/movies', icon: 'film', match: :crud)
          list.with_item(name: 'Studios', href: '/admin/studios', icon: 'building-2', match: :crud)
        end
      end %>
    <% end

    layout.with_body do %>
      <%= render Bali::PageHeader::Component.new(
        title: 'Dashboard',
        subtitle: 'The warning comes from Bali.layout_banners, not from this layout') %>
    <% end
  end %>
<% ensure %>
  <% Bali.layout_banners.delete(:lookbook_impersonation) %>
<% end %>
