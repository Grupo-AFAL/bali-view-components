<%# Fixture del offset del banner: el sidebar fijo arranca DEBAJO de la franja,
    y la franja puede ser una o dos. La segunda es un Bali::Alert cerrable, que
    es lo que hace medible el caso "el usuario descarta un banner". %>
<%= render Bali::AppLayout::Component.new(
  fixed_sidebar: true,
  viewport_locked: false,
  modal: false,
  drawer: false
) do |layout|
  layout.with_banner do %>
    <div class="bg-warning text-warning-content px-4 py-2 text-sm flex items-center justify-between">
      <div class="flex items-center gap-2">
        <%= render Bali::Icon::Component.new("eye", class: "size-4") %>
        <span>You are viewing as <strong>John Doe</strong> (john@example.com)</span>
      </div>
      <%= render Bali::Button::Component.new(name: "Stop Impersonating", variant: :ghost, size: :sm) %>
    </div>

    <% if banners > 1 %>
      <%= render Bali::Alert::Component.new(color: :info, closable: true, icon: "clipboard-check",
                                            class: "rounded-none") do %>
        Three documents are waiting for your review before Friday.
      <% end %>
    <% end %>
  <% end

  layout.with_sidebar do %>
    <%= render Bali::SideMenu::Component.new(current_path: '/admin', collapsible: collapsible, brand: 'MovieDB') do |menu|
      menu.with_list(title: 'Main') do |list|
        list.with_item(name: 'Dashboard', href: '/admin', icon: 'layout-dashboard', match: :exact)
        list.with_item(name: 'Movies', href: '/admin/movies', icon: 'film', match: :crud)
        list.with_item(name: 'Studios', href: '/admin/studios', icon: 'building-2', match: :crud)
      end

      menu.with_bottom_item(name: 'Ana García', href: '#', icon: 'circle-user')
    end %>
  <% end

  layout.with_body do %>
    <%= render Bali::PageHeader::Component.new(
      title: 'Dashboard',
      subtitle: 'Scroll: the banner stays, the sidebar keeps its top under it') %>

    <div class="space-y-4">
      <% 12.times do |index| %>
        <%= render Bali::Card::Component.new(style: :bordered, body_class: 'p-4') do %>
          <p class="font-semibold">Row <%= index + 1 %></p>
          <p class="text-sm text-base-content/60">
            Filler so the page scrolls and the sticky strip has something to stick over.
          </p>
        <% end %>
      <% end %>
    </div>
  <% end
end %>
