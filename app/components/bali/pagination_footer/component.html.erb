<%= tag.div(**@options) do %>
  <%# The empty div is not decorative: without it `justify-between` pulls the controls to the
      left whenever the summary is suppressed. %>
  <% if show_summary? %>
    <div class="text-sm text-base-content/70">
      <%= summary_text %>
    </div>
  <% else %>
    <div></div>
  <% end %>

  <% if show_controls? %>
    <%= controls? ? controls : render(pagination) %>
  <% end %>
<% end %>
