<%# `results` holds the footer counter's `one`/`other` forms, `%{count}` still in
    them: the count changes on every keystroke, so index.js picks and fills them. %>
<%= tag.div(class: container_classes,
            data: { controller: "command", command_results_value: t("bali_view.command.results") }) do %>
  <% if trigger? %>
    <div data-action="click->command#open">
      <%= trigger %>
    </div>
  <% elsif render_trigger? %>
    <%# The default trigger: a search well, sized by its container — put the
        width on the component's `class:`. Not a `.btn` on purpose (see the
        class comment), so it declares its own focus-visible ring: dropping
        `.btn` also dropped daisyUI's, and the browser's default ring does not
        follow the theme. The label is /75: at /60 it read 3.89:1 on afal, and
        /70 read 4.51 under the pointer on the preview's base-200 page.
        In a size container narrower than 7rem — the Topbar's search slot, once its
        actions take the room — the well folds to a square around the icon: below that
        the label gets under 68px, and "Search…" takes 55 and "Buscar…" 54 in Noto
        Sans. The label stays in the accessibility tree as `sr-only`, so it is still
        the button's name, and `title` gives the square the tooltip its IconAction
        neighbours have. The square is capped at the slot and clipped: with six actions
        at 320px the slot is 2px, and 32px would run under the next action. %>
    <button type="button"
            data-action="click->command#open"
            aria-haspopup="dialog"
            title="<%= trigger_label %>"
            class="bali-command-trigger flex items-center gap-2 w-full bg-base-content/8 hover:bg-base-content/16 rounded-md px-2.5 py-1.5 text-sm text-base-content/75 cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content @max-[7rem]:size-8 @max-[7rem]:max-w-full @max-[7rem]:justify-center @max-[7rem]:px-0 @max-[7rem]:overflow-hidden">
      <%= render Bali::Icon::Component.new('search', class: 'size-4 shrink-0') %>
      <span class="flex-1 min-w-0 truncate text-left @max-[7rem]:sr-only"><%= trigger_label %></span>
      <% if shortcut_label.present? %>
        <%# aria-hidden: the hint is decoration — without it the accessible
            name changes with the viewport ("Search…" vs "Search… ⌘K").
            The `shortcut` target is what tells the controller this label is
            ours to rewrite for a keyboard that has no ⌘ key; a label the host
            passed carries no target and is left alone. A hand-rolled trigger
            can opt in by putting the target on its own kbd. %>
        <%= tag.kbd shortcut_label,
                    class: "kbd kbd-xs hidden sm:inline-flex @max-[7rem]:hidden",
                    aria: { hidden: true },
                    data: (auto_shortcut? ? { command_target: "shortcut" } : {}) %>
      <% end %>
    </button>
  <% end %>

  <%# The backdrop and the panel sit inside a `<dialog>` that the controller opens
      with `showModal()`, which is what puts the palette in the top layer. It has
      to: Modal and Drawer are dialogs of their own now, so `--bali-z-command: 500`
      no longer reaches over them — no number in the document does — and opening on
      top of whatever you were doing, a half-filled drawer included, is the whole
      promise of a command palette.
      The dialog wraps the two boxes instead of replacing the container so every
      target stays inside the controller's scope and a `trigger` slot stays where
      the page put it. %>
  <dialog data-command-target="surface" class="bali-command-surface" aria-label="<%= placeholder %>">
    <%# Backdrop — click to close %>
    <div data-command-target="backdrop"
         data-action="click->command#close"
         class="hidden fixed inset-0 bg-black/40 z-[calc(var(--bali-z-command)_-_1)]"></div>

    <%# Modal panel — centered, fixed position %>
    <div data-command-target="panel"
         class="hidden fixed top-24 left-1/2 -translate-x-1/2 z-[var(--bali-z-command)] w-[520px] max-w-[calc(100vw-2rem)]">
      <div class="cmd-panel bg-base-100 border border-base-content/15 rounded-box shadow-xl flex flex-col overflow-hidden <%= 'is-compact' if compact? %>">
        <%# Search input. Padding and font size live in index.css next to the
            `.is-compact` overrides — see the comment there before moving them
            back onto these elements. %>
        <div class="cmd-input-wrap flex items-center gap-3 border-b border-base-200 text-base-content/60">
          <%= render Bali::Icon::Component.new('search', class: 'size-4 shrink-0') %>
          <input data-command-target="input"
                 data-action="input->command#filter keydown->command#nav"
                 type="text"
                 placeholder="<%= placeholder %>"
                 class="cmd-input flex-1 min-w-0 bg-transparent border-0 outline-none text-base-content placeholder:text-base-content/70"
                 aria-label="<%= placeholder %>" />
          <kbd class="kbd kbd-xs"><%= t('.esc_key') %></kbd>
        </div>

        <%# List %>
        <div class="cmd-list p-1.5 max-h-80 overflow-y-auto">
          <% groups.each do |group| %>
            <%= group %>
          <% end %>

          <div data-command-target="noResults" class="hidden text-center px-4 pt-8 pb-3">
            <div class="text-sm font-semibold text-base-content"><%= no_results_text %></div>
            <% if no_results_subtitle %>
              <div class="text-xs text-base-content/70 mt-1"><%= no_results_subtitle %></div>
            <% end %>
          </div>
        </div>

        <%# Footer. It wraps because the panel's overflow-hidden clips whatever
            does not fit: on one line at 320px, "9 resultados" overflows by 42px. %>
        <div class="flex flex-wrap items-center gap-3 px-3 py-2 border-t border-base-200 bg-base-100 text-xs text-base-content/70">
          <span class="inline-flex items-center gap-1.5"><kbd class="kbd kbd-xs">↑</kbd><kbd class="kbd kbd-xs">↓</kbd> <%= t('bali_view.command.navigate') %></span>
          <span class="inline-flex items-center gap-1.5"><kbd class="kbd kbd-xs">⏎</kbd> <%= t('bali_view.command.open_action') %></span>
          <span class="inline-flex items-center gap-1.5"><kbd class="kbd kbd-xs"><%= t('.esc_key') %></kbd> <%= t('bali_view.command.close') %></span>
          <span class="ml-auto font-mono text-[10.5px] text-base-content/70" data-command-target="count"></span>
        </div>
      </div>
    </div>
  </dialog>
<% end %>
