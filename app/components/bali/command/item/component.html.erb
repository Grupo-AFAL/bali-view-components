<%# Padding, the hover background and the body's direction/gap live in
    index.css next to the `.is-active` and `.is-compact` overrides — see the
    comment there before moving them back onto these elements. %>
<%= tag.button(**button_options) do %>
  <% if icon %>
    <%# bg / text colour live in index.css next to the `.is-active` override —
        see the comment there before moving them back onto this element. %>
    <span class="cmd-row-ic size-7 rounded-md grid place-items-center shrink-0">
      <%= render Bali::Icon::Component.new(icon, class: 'size-3.5') %>
    </span>
  <% end %>
  <span class="cmd-row-body flex-1 min-w-0 flex">
    <span class="cmd-row-title text-sm text-base-content truncate"><%= title %></span>
    <% if meta %>
      <span class="cmd-row-meta text-xs text-base-content/60 truncate"><%= meta %></span>
    <% end %>
  </span>
  <%# opacity lives in index.css next to the `.is-active` override. %>
  <span class="cmd-row-hint shrink-0 text-base-content/50 inline-flex items-center gap-1 transition-opacity">
    <kbd class="kbd kbd-xs">⏎</kbd>
  </span>
<% end %>
