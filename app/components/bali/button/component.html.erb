<%= tag.button(**button_attributes) do %>
  <% if @loading %>
    <span class="loading loading-spinner loading-sm"></span>
  <% elsif icon? %>
    <%= icon %>
  <% elsif @icon.present? %>
    <%= render Bali::Icon::Component.new(@icon) %>
  <% end %>

  <% if labelled_icon? %>
    <%= tag.span(@name, class: class_names("btn-label", "max-sm:hidden" => responsive_icon_only?)) %>
  <% elsif @name.present? %>
    <%= @name %>
  <% else %>
    <%= content %>
  <% end %>

  <%= icon_right if icon_right.present? %>
<% end %>
