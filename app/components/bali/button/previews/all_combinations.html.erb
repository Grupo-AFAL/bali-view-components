<div class="flex flex-col gap-6">
  <% [nil, *Bali::Button::Component::STYLES.keys].each do |style| %>
    <div>
      <h3 class="text-lg font-semibold mb-3"><%= style || :solid %></h3>
      <div class="flex flex-wrap gap-2">
        <% (Bali::Button::Component::VARIANTS.keys - %i[ghost link]).each do |variant| %>
          <%= render Bali::Button::Component.new(name: variant.to_s, variant: variant, style: style) %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
