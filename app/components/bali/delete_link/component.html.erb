<% if disabled? %>
  <%= render Bali::HoverCard::Component.new(hover_url: disabled_hover_url) do |c| %>
    <% c.with_trigger do %>
      <%# `<a disabled>` is not a thing — HTML has no disabled attribute on an anchor, so the
          state was paint only and nothing in the accessibility tree said "unavailable". A real
          button carries it. `aria-disabled` and not `disabled`, because a disabled control
          takes no focus, and the hover card that explains WHY deletion is off would then be
          reachable with a mouse and with nothing else. %>
      <%= tag.button(type: 'button', 'aria-disabled': true, class: button_classes,
                     **button_options) do %>
        <% if icon_name.present? %>
          <%= render Bali::Icon::Component.new(icon_name, size: :small) %>
        <% end %>

        <%= name %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= button_to href, method: :delete,
                      form: { data: confirm_data },
                      form_class: form_classes,
                      class: button_classes,
                      **button_options do %>
    <% if icon_name.present? %>
      <%= render Bali::Icon::Component.new(icon_name, size: :small) %>
    <% end %>

    <%= name %>
  <% end %>
<% end %>
