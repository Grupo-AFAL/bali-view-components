<%# The same figure on the three boxes a host can reach for, in the situation
    that tells them apart: inside a section card.

    `size: :sm, shadow: false` already gets you a quiet bordered box with 1rem of
    padding — it is the right answer plenty of the time. What it cannot do is
    stop being a `.card`, which is what a grid inside a card needs. %>
<%= render Bali::Card::Component.new do |card| %>
  <% card.with_title('Tres cajas, una métrica') %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div>
      <p class="text-base-content/60 mb-2 text-xs font-medium tracking-wide uppercase">
        surface: :card (por omisión)
      </p>
      <%= render Bali::StatCard::Component.new(
            title: 'VPN', value: '$6.14M', icon: 'trending-up'
          ) %>
    </div>

    <div>
      <p class="text-base-content/60 mb-2 text-xs font-medium tracking-wide uppercase">
        surface: :card, size: :sm, shadow: false
      </p>
      <%= render Bali::StatCard::Component.new(
            title: 'VPN', value: '$6.14M', icon: 'trending-up', size: :sm, shadow: false
          ) %>
    </div>

    <div>
      <p class="text-base-content/60 mb-2 text-xs font-medium tracking-wide uppercase">
        surface: :cell
      </p>
      <%= render Bali::StatCard::Component.new(
            surface: :cell, title: 'VPN', value: '$6.14M', note: 'Crea valor · tasa 12.5%'
          ) %>
    </div>
  </div>
<% end %>
