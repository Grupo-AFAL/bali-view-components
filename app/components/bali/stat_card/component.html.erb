<%# The whitespace here is load-bearing: the blank line below and the absence of a trailing
    newline at the end of this file are what keep `surface: :card` rendering byte for byte
    what it rendered before the cell surface existed.
    test/bali/components/stat_card/default_surface_unchanged_test.rb fails if either goes. %>
<% body = capture do %>

  <div class="flex items-center justify-between">
    <div>
      <p class="text-base-content/60 text-xs font-medium tracking-wide uppercase">
        <%= title %>
      </p>
      <p class="<%= value_classes %>"><%= value %></p>
      <% if note.present? %>
        <p class="<%= note_classes %>"><%= note %></p>
      <% end %>
    </div>
    <% if icon.present? %>
      <%= tag.div(class: icon_container_classes, style: icon_container_style) do %>
        <%= render Bali::Icon::Component.new(icon, size: :large, class: icon_text_class,
                                             style: icon_style) %>
      <% end %>
    <% end %>
  </div>
  <% if footer? %>
    <div class="flex items-center gap-1 text-sm">
      <%= footer %>
    </div>
  <% end %>
<% end %>
<% if cell? %><%= content_tag(cell_tag, body, cell_options) %><% else %><%= render Bali::Card::Component.new(**card_options) do %><%= body %><% end %><% end %>