<%= tag.div(**container_attributes) do %>
  <% if navigation? %>
    <%= tag.nav(class: tabs_classes, 'aria-label': nav_label) do %>
      <% tabs.each_with_index do |tab, index| %>
        <%= render Bali::Tabs::Trigger::Component.new(tab, index, navigation: true) %>
      <% end %>
    <% end %>
  <% else %>
    <div role="tablist" class="<%= tabs_classes %>">
      <% tabs.each_with_index do |tab, index| %>
        <%= render Bali::Tabs::Trigger::Component.new(tab, index) %>
      <% end %>
    </div>
    <% if tabs.any? %>
      <div class="tabs-content pt-4">
        <% tabs.each_with_index do |tab, index| %>
          <%= tag.div(**tab.panel_options,
                id: "tabpanel-#{index}",
                role: 'tabpanel',
                'aria-labelledby': "tab-#{index}",
                tabindex: 0,
                data: {
                  'tabs-target': 'tabContent',
                  'tabs-index-param': index
                }) do %>
            <%= tab %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
