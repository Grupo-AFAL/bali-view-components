<%# A real `<dialog>`: `ModalController` opens it with `showModal()`, which is what
    buys the top layer, the inertness of everything behind it and the browser's own
    focus containment. `role="dialog"` and `aria-modal` are gone because both are
    implicit here — and `aria-modal` was a lie in the one state a plain attribute
    cannot tell apart, a panel rendered `active:` that no script has opened yet. %>
<dialog id="<%= modal_id %>"
     class="<%= modal_classes %> fixed inset-0 z-[var(--bali-z-modal)] items-center justify-center hidden [&.modal-open]:flex"
     <% if title? %>aria-labelledby="<%= title_id %>"<% end %>
     <% if description? %>aria-describedby="<%= description_id %>"<% end %>
     <% if confirm_on_close? %>data-controller="modal" data-modal-confirm-close-message-value="<%= confirm_close_message %>"<% end %>
     data-modal-target="template"
     data-action="keydown.esc->modal#close">
  <div class="modal-backdrop fixed inset-0 bg-black/50" data-modal-target="background" aria-hidden="true"></div>
  <div class="<%= box_classes %> relative bg-base-100 rounded-box p-4 sm:p-6 shadow-xl w-11/12 max-h-[calc(100vh-5em)] overflow-y-auto" data-wrapper-class="<%= @wrapper_class %>" data-modal-target="wrapper" tabindex="-1">
    <% if render_standalone_close_button? %>
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label="<%= close_label %>" data-action="modal#close" type="button">✕</button>
    <% end %>
    <% if header? %>
      <%= header %>
    <% end %>
    <div class="modal-inner" data-modal-target="content">
      <% if body? %>
        <%= body %>
      <% else %>
        <%= content %>
      <% end %>
    </div>
    <% if actions? %>
      <%= actions %>
    <% end %>
  </div>
</dialog>
