<div class="flex flex-col gap-4 max-w-sm">
  <%= render Bali::QrScanner::Component.new(autostart: false) %>

  <div class="flex flex-col gap-1">
    <span class="text-sm font-semibold">Last scan</span>
    <output id="qr-scanner-demo-output"
            class="font-mono text-sm break-all rounded-box bg-base-200 px-3 py-2 min-h-10">
      —
    </output>
  </div>
</div>

<script>
  document.addEventListener('bali:qr-scanner:scan', event => {
    document.getElementById('qr-scanner-demo-output').textContent = event.detail.value
  })
</script>
