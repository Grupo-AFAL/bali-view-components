<%= tag.header(class: container_classes, **container_attributes) do %>
  <% if menu_id %>
    <%# Mobile sidebar trigger — only on small screens. A real <button>, so it
        is in the tab order and answers Enter and Space natively. %>
    <%= render Bali::SideMenu::Trigger::Component.new(menu_id: menu_id, class: 'lg:hidden') %>
  <% end %>

  <% if brand? %>
    <div class="bali-topbar-brand"><%= brand %></div>
  <% end %>

  <% if search? %>
    <div class="flex-1 max-w-md">
      <%= search %>
    </div>
  <% end %>

  <% if actions? || user_menu? %>
    <div class="flex items-center gap-1 ml-auto">
      <% actions.each do |action| %>
        <%= action %>
      <% end %>
      <% if user_menu? %>
        <%= user_menu %>
      <% end %>
    </div>
  <% end %>
<% end %>
