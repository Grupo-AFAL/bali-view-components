<%# locals: data, i18n %>
<%# Readonly island: toy data straight from the preview (no DB, no URLs).
    The values on the div ARE the island's API — they map 1:1 to GanttFlow
    props through the ReactIslandController base (see docs/api/react-island.md
    and app/components/bali/gantt/index.js). %>
<%= react_island_meta_tags('gantt', js: 'gantt-island.js', css: 'gantt-island.css') %>
<%= tag.div nil,
      class: 'block w-full',
      data: {
        controller: 'gantt',
        gantt_data_value: data.to_json,
        gantt_i18n_value: i18n.to_json,
        gantt_date_locale_value: I18n.locale.to_s
      } %>
