<%# locals: project, gantt, i18n %>
<%# The COMPLETE editable island wired to the dummy's reference endpoints —
    the executable form of the mutation contract (#705, D15/D17). Phase 3
    (#719) renders this same element through Bali::Gantt::Component
    `mode: :interactive` at /admin/projects/:id?view=timeline. %>
<%= react_island_meta_tags('gantt', js: 'gantt-island.js', css: 'gantt-island.css') %>
<% if project %>
  <%= tag.div nil,
        class: 'block w-full',
        data: {
          controller: 'gantt',
          gantt_data_value: gantt.to_h.to_json,
          gantt_catalogs_value: gantt.catalogs.to_json,
          gantt_i18n_value: i18n.to_json,
          gantt_editable_value: 'true',
          gantt_manageable_value: 'true',
          gantt_patch_url_value: admin_project_schedule_path(project),
          gantt_schedule_url_value: admin_project_schedule_path(project),
          gantt_dependencies_url_value: admin_project_dependencies_path(project),
          gantt_date_locale_value: I18n.locale.to_s
        } %>
<% else %>
  <p class="p-4 text-sm text-base-content/60">
    This preview mounts the island against the seeded demo project — run
    <code>bin/rails db:seed</code> in spec/dummy first.
  </p>
<% end %>
