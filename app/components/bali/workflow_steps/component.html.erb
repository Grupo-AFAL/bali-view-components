<% if segments? %>
  <div <%= tag.attributes(**container_options) %>>
    <ol class="workflow-steps-list">
      <% rendered_steps.each do |step| %>
        <%= step %>
      <% end %>
    </ol>
    <% if current_title %>
      <%# Hidden from assistive tech because the list above already reads this
          step out with its state; heard twice, it is the same step again. %>
      <span class="workflow-steps-current-title" aria-hidden="true"><%= current_title %></span>
    <% end %>
  </div>
<% elsif boxed? %>
  <div <%= tag.attributes(**container_options) %>>
    <% if progress? %>
      <div class="workflow-steps-progress">
        <%= render Bali::Progress::Component.new(
              value: resolved_count, max: total_count, color: progress_color,
              show_percentage: false, class: "grow") %>
        <span class="workflow-steps-count"><%= resolved_count %>/<%= total_count %></span>
      </div>
    <% end %>
    <ol <%= tag.attributes(class: "workflow-steps-list", **list_options) %>>
      <% rendered_steps.each do |step| %>
        <%= step %>
      <% end %>
    </ol>
  </div>
<% else %>
  <ol <%= tag.attributes(**container_options) %>>
    <% rendered_steps.each do |step| %>
      <%= step %>
    <% end %>
  </ol>
<% end %>
