<li <%= tag.attributes(**step_options) %>>
  <div class="workflow-step-marker">
    <% if connector_state %>
      <span class="<%= connector_classes %>" aria-hidden="true"></span>
    <% end %>
    <% if dot? %>
      <span class="<%= dot_classes %>" aria-hidden="true"></span>
    <% else %>
      <span class="<%= circle_classes %>">
        <% if number.present? %>
          <%= number %>
        <% else %>
          <%= render Bali::Icon::Component.new("minus", size: 16) %>
        <% end %>
      </span>
    <% end %>
    <%# Both markers say the state in colour and nothing else — the number is a
        position, not a verdict, and the dot has no text at all. This is the one
        place that says it in words, and it sits outside the circle so the
        number stays the circle's whole content. %>
    <span class="sr-only"><%= state_label %></span>
  </div>
  <div class="workflow-step-body">
    <p class="<%= title_classes %>"><%= title %></p>
    <% if assignee.present? %>
      <p class="workflow-step-assignee">
        <%= render Bali::Icon::Component.new("user", size: 14) %>
        <%= assignee %>
      </p>
    <% end %>
    <% if date.present? %>
      <p class="workflow-step-date"><%= date %></p>
    <% end %>
    <% if content? %>
      <div class="workflow-step-comment"><%= content %></div>
    <% end %>
  </div>
</li>
