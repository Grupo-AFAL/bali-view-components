<%= tag.div(**options) do %>
  <% if title.present? %>
    <%= tag.span(title, id: title_id, class: "legend-component__title") %>
  <% end %>
  <%= tag.ul(class: "legend-component__items", role: "list", **list_name) do %>
    <% items.each do |item| %>
      <%= item %>
    <% end %>
  <% end %>
<% end %>
