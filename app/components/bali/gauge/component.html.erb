<%# The ring draws itself from `--value`; the text inside it is ordinary flow
    content, which is why the label sits here rather than in a pseudo-element. %>
<div class="<%= gauge_classes %>"
     style="<%= gauge_style %>"
     <%# One hash: `gauge_attributes` folds the ARIA contract in and lets a
         caller's own override it. Two `tag.attributes` calls emitted the same
         key twice and the first silently won. %>
     <%= tag.attributes(gauge_attributes) %>>
  <%# `aria-hidden`: every one of these is already in the ring's accessible
      name, and without this a screen reader reads the figure twice. %>
  <span aria-hidden="true" class="flex flex-col items-center leading-none">
    <% if show_percentage? %>
      <span class="font-semibold tabular-nums"><%= percentage %>%</span>
    <% end %>
    <% if label.present? %>
      <span class="text-[0.65em] opacity-70"><%= label %></span>
    <% end %>
  </span>
</div>
