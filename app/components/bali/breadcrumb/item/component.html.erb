<li class="<%= item_classes %>">
  <% if link? %>
    <%= render Bali::Link::Component.new(href: href, name: name, icon: icon, plain: true, class: link_classes) %>
  <% else %>
    <span class="<%= text_classes %>" <%= tag.attributes(aria: { current: ("page" if current?) }) %>>
      <% if icon.present? %>
        <%= render Bali::Icon::Component.new(icon) %>
      <% end %>
      <%= name %>
    </span>
  <% end %>
</li>
