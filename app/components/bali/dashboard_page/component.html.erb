<div class="<%= page_container_class('dashboard-page-component') %>">
  <%= render_breadcrumbs %>
  <%= render_page_header %>
  <%= render_nav %>

  <% if stat_items.any? %>
    <div class="<%= stats_grid_classes %>">
      <% stat_items.each do |stat| %>
        <%= render Bali::StatCard::Component.new(
          title: stat.label,
          value: stat.value,
          icon_name: stat.icon,
          color: stat.color
        ) do |card| %>
          <% if stat.change.present? %>
            <% card.with_footer do %>
              <span class="<%= stat_change_class(stat.color) %>"><%= stat.change %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render_body %>
</div>
