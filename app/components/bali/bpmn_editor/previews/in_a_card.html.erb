<%# locals: locale, component %>
<%= react_island_meta_tags("bpmn-editor", js: "bpmn-editor-island.js", css: "bpmn-editor-island.css") %>
<% en = locale.to_s == "en" %>
<div class="p-4">
  <div class="flex h-[560px] flex-col overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm"
       data-testid="bpmn-card-panel">
    <%= render Bali::Card::Component.new(style: :flush, size: :sm, class: "shrink-0 border-b border-base-300") do |card| %>
      <% card.with_header(title: en ? "Supplier onboarding" : "Alta de proveedor",
                          subtitle: en ? "Process map · version 2" : "Mapa de procesos · versión 2") %>
    <% end %>
    <div class="min-h-0 flex-1"><%= render component %></div>
  </div>
</div>
