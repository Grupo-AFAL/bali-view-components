<%# locals: flow, rule, example, optional, optional_rules, sample, locale %>
<%# The optional rule package runs only in the bundle that imports it: this
    preview loads a second island bundle (test/dummy/app/javascript/
    bpmn-editor-island-with-rules.js) instead of the usual one. %>
<% bundle = optional_rules ? "bpmn-editor-island-with-rules" : "bpmn-editor-island" %>
<%= react_island_meta_tags("bpmn-editor", js: "#{bundle}.js", css: "#{bundle}.css") %>
<% texts = Bali::BpmnEditor::Translations.island(locale: locale) %>
<% en = locale.to_s == "en" %>
<div class="flex flex-col gap-3 p-4" data-testid="bpmn-rules-gallery" data-rule="<%= rule %>" data-example="<%= example %>">
  <div>
    <p class="text-sm font-semibold"><%= rule %> · <%= texts["rule_title_#{rule}"] || rule %></p>
    <p class="text-xs text-base-content/70">
      <% if example == "failing" %>
        <%= en ? "This flow breaks the rule: the panel lists it." : "Este flujo incumple la regla: el panel la lista." %>
      <% else %>
        <%= en ? "This flow follows the rule: the panel does not list it." : "Este flujo cumple la regla: el panel no la lista." %>
      <% end %>
    </p>
    <% also = sample[:also].reject { |id| BpmnRuleExamples.optional_rule_ids.include?(id) && !optional_rules } %>
    <% if also.any? %>
      <p class="text-xs text-base-content/70" data-testid="bpmn-rules-gallery-also">
        <%= en ? "It also raises" : "También dispara" %> <%= also.join(", ") %>: <%= sample[:why] %>
      </p>
    <% end %>
  </div>
  <% if optional && !optional_rules %>
    <%= render Bali::Alert::Component.new(color: :info, size: :sm, data: { testid: "bpmn-rules-gallery-optional" }) do %>
      <% if en %>
        This rule belongs to the optional rule package, which is not loaded: turn on
        <code>optional_rules</code> to see it run.
      <% else %>
        Esta regla es del paquete de reglas opcional, que no está cargado: activa
        <code>optional_rules</code> para verla funcionar.
      <% end %>
    <% end %>
  <% end %>
  <%= I18n.with_locale(locale) { render Bali::BpmnEditor::Component.new(
        data: sample[:document].merge("version" => flow.version),
        editable: true,
        autosave: false,
        open_issues: true,
        palette: sample[:allowed] || :full,
        page: (sample[:page] || {}).symbolize_keys.presence || Bali::BpmnEditor::Component::DEFAULT_PAGE,
        rules: { enabled: optional && !optional_rules ? [] : [ rule ], options: sample[:options] || {} },
        urls: { save: admin_process_flow_diagram_path(flow), diagram: admin_process_flow_diagram_path(flow) },
        id: "rules_gallery_bpmn") } %>
</div>
