<%# locals: locale, component %>
<%= react_island_meta_tags("bpmn-editor", js: "bpmn-editor-island.js", css: "bpmn-editor-island.css") %>
<% en = locale.to_s == "en" %>
<div class="flex flex-col gap-3 p-4" data-testid="bpmn-compare-flows">
  <p class="text-xs text-base-content/60">
    <%= en ? "Open «Compare» and pick what to compare against: another process, or a previous version (stable or recreated ids). Elements pair by id, then by name (match: :auto)." :
             "Abre «Comparar» y elige contra qué comparar: otro proceso o una versión anterior (con ids estables o recreados). Los elementos se emparejan por id y luego por nombre (match: :auto)." %>
  </p>
  <%= render component %>
</div>
