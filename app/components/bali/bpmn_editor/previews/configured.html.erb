<%# locals: flow %>
<%= react_island_meta_tags('bpmn-editor', js: 'bpmn-editor-island.js', css: 'bpmn-editor-island.css') %>
<% if flow %>
  <%= render Bali::BpmnEditor::Component.new(
        data: flow.to_diagram,
        editable: true,
        palette: {
          preset: :full,
          items: { complex_gateway: "disabled", parallel_multiple_event: false },
          notes: { signal_event: "Por confirmar con el área", link_event: "Por confirmar con el área",
                   data_store: "Solo para sistemas registrados" },
          note_legend: "Contorno punteado: elemento por confirmar con el área."
        },
        legend: { remove: %i[external_task], add: [ { key: "rework", label: "Retrabajo", swatch: "color", color: "#dc2626" } ] },
        i18n: Bali::BpmnEditor::Translations.island(locale: :es),
        urls: { save: admin_process_flow_diagram_path(flow), diagram: admin_process_flow_diagram_path(flow) },
        id: dom_id(flow, :bpmn)) %>
<% else %>
  <p class="p-4 text-sm text-base-content/60">
    This preview edits the seeded process flow — run <code>bin/rails db:seed</code> in test/dummy first.
  </p>
<% end %>
