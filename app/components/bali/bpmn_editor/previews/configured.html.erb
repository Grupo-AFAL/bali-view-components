<%# locals: flow, locale %>
<%= react_island_meta_tags('bpmn-editor', js: 'bpmn-editor-island.js', css: 'bpmn-editor-island.css') %>
<% en = locale.to_s == "en" %>
<% if flow %>
  <%= I18n.with_locale(locale) { render Bali::BpmnEditor::Component.new(
        data: flow.to_diagram(locale: locale),
        editable: true,
        palette: {
          preset: :full,
          items: { complex_gateway: "disabled", parallel_multiple_event: false },
          notes: { signal_event: en ? "To be confirmed with the team" : "Por confirmar con el equipo",
                   link_event: en ? "To be confirmed with the team" : "Por confirmar con el equipo",
                   data_store: en ? "Registered systems only" : "Solo para sistemas registrados" },
          note_legend: en ? "Dotted outline: element to be confirmed with the team." : "Contorno punteado: elemento por confirmar con el equipo.",
          note_label: en ? "to confirm" : "por confirmar"
        },
        legend: { remove: %i[external_task], add: [ { key: "rework", label: en ? "Rework" : "Retrabajo", swatch: "color", color: "#dc2626" } ] },
        urls: { save: admin_process_flow_diagram_path(flow), diagram: admin_process_flow_diagram_path(flow) },
        id: dom_id(flow, :bpmn)) } %>
<% else %>
  <p class="p-4 text-sm text-base-content/60">
    This preview edits the seeded process flow — run <code>bin/rails db:seed</code> in test/dummy first.
  </p>
<% end %>
