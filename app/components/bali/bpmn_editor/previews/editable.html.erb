<%# locals: flow, locale, autosave, palette, external_lanes %>
<%# What a host writes: one render call with its endpoints in `urls:`. %>
<%= react_island_meta_tags('bpmn-editor', js: 'bpmn-editor-island.js', css: 'bpmn-editor-island.css') %>
<% if flow %>
  <%= I18n.with_locale(locale) { render Bali::BpmnEditor::Component.new(
        data: flow.to_diagram,
        editable: true,
        autosave: autosave,
        external_lanes: external_lanes,
        palette: palette,
        fields: {
          nodes: {
            "*" => [ { key: "owner_note", label: "Nota del responsable", type: "textarea" } ],
            user_task: [
              { key: "duration", label: "Duración (minutos)", type: "number", min: 0 },
              { key: "systems", label: "Sistemas", type: "multi_select",
                options: [ { value: "erp", label: "ERP" }, { value: "portal", label: "Portal de proveedores" },
                           { value: "bank", label: "Banca en línea" } ] }
            ]
          },
          lanes: [ { key: "notes", label: "Notas", type: "textarea" } ]
        },
        urls: {
          save: admin_process_flow_diagram_path(flow),
          diagram: admin_process_flow_diagram_path(flow),
          finalize: admin_process_flow_finalization_path(flow),
          references: admin_process_flow_references_path(flow),
          new_reference: new_admin_process_flow_reference_path(flow),
          lane_assignees: admin_process_flow_lane_assignees_path(flow),
          new_lane_assignee: new_admin_process_flow_lane_assignee_path(flow)
        },
        id: dom_id(flow, :bpmn)) } %>
<% else %>
  <p class="p-4 text-sm text-base-content/60">
    This preview edits the seeded process flow — run <code>bin/rails db:seed</code> in test/dummy first.
  </p>
<% end %>
