<div class="flex items-center gap-6">
  <div class="flex items-center gap-2">
    <span class="text-sm font-medium">true:</span>
    <%= render Bali::BooleanIcon::Component.new(value: true) %>
  </div>

  <div class="flex items-center gap-2">
    <span class="text-sm font-medium">false:</span>
    <%= render Bali::BooleanIcon::Component.new(value: false) %>
  </div>

  <div class="flex items-center gap-2">
    <span class="text-sm font-medium">nil:</span>
    <%= render Bali::BooleanIcon::Component.new(value: nil) %>
  </div>
</div>

<p class="text-sm text-base-content/70 mt-4">
  Every icon carries an <code>sr-only</code> name — "Yes", "No",
  "Not specified" — so the three states are told apart without colour.
</p>
