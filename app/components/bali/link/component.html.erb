<%= tag.a class: link_classes, **link_attributes do %>
  <% if icon? %>
    <%= icon %>
  <% elsif @icon.present? %>
    <%= render Bali::Icon::Component.new(@icon) %>
  <% end %>
  <% if responsive_icon_only? %>
    <span class="max-sm:hidden"><%= name %></span>
  <% else %>
    <%= name %>
  <% end %>
  <%= icon_right if icon_right? %>
  <%= content %>
<% end %>
