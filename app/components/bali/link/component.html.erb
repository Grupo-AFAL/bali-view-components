<%= tag.a class: link_classes, **link_attributes do %>
  <% if icon? %>
    <%= icon %>
  <% elsif @icon.present? %>
    <%= render Bali::Icon::Component.new(@icon) %>
  <% end %>
  <% if labelled_icon? %>
    <%= tag.span(name, class: class_names("btn-label", "max-sm:hidden" => responsive_icon_only?)) %>
  <% else %>
    <%= name %>
  <% end %>
  <%= icon_right if icon_right? %>
  <%= content %>
<% end %>
