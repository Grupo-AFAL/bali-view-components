<%# `render_with_template` rather than building this in the preview method: a
    `tag.div` block there raises "no implicit conversion of Symbol into Integer",
    and `safe_join` prints raw HTML. See .claude/CLAUDE.md. %>
<div class="p-6">
  <%= render Bali::WidgetGrid::Component.new(url: '/widget_layout', add_path: '/lookbook') do |grid| %>
    <% grid.with_heading do %>
      <h2 class="text-lg font-semibold">Hoy</h2>
    <% end %>

    <% if populated %>
      <% grid.with_widget(Bali::WidgetGrid::Preview::Demo.goal('compliance_status', :medium, 3)) %>
      <% grid.with_widget(Bali::WidgetGrid::Preview::Demo.list('low_stock_items', :medium, 4)) %>
    <% end %>
  <% end %>
</div>
