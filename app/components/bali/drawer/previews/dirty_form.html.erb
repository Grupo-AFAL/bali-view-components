<%= render Bali::Drawer::Component.new(active: true, title: 'Edit Item') do %>
  <%= form_with(model: model, url: '/fake/submit', builder: Bali::FormBuilder) do |form| %>
    <%= form.text_group :text %>
    <%= form.date_group :date %>
    <%# The slim select portals its .ss-content into the dialog through
        enterTopLayer, just like the calendar — the other half of the #1013 repro. %>
    <%= form.slim_select_group :select, [['Action', 1], ['Comedy', 2], ['Drama', 3]] %>
    <%# The file input fires a `cancel` that BUBBLES when the system picker is
        dismissed — the third half of #1013. %>
    <%= form.file_group :url %>
    <div class="mt-4">
      <%= render Bali::Button::Component.new(name: 'Save', variant: :primary, type: :submit) %>
    </div>
  <% end %>
<% end %>
