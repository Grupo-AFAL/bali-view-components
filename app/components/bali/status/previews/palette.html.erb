<div class="flex flex-col items-start gap-6">
  <div class="flex flex-wrap gap-2">
    <% options.each do |option| %>
      <%= render Bali::Status::Component.new(selected: option[:value], options: [option]) %>
    <% end %>
  </div>

  <%= render Bali::Status::Component.new(
        selected: options.first[:value],
        options: options,
        form: { url: "/lookbook", method: :patch, param: "palette[status]" }) %>
</div>
