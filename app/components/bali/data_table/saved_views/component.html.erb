<%# No `dropdown-end`: the control lives in the toolbar's LEFT group, and anchored to its
    trigger's right edge the panel opened outside the row it belongs to. %>
<div class="dropdown"
     data-controller="saved-views"
     data-saved-views-table-value="<%= table_selector %>"
     data-saved-views-storage-key-value="<%= columns_storage_key %>"
     data-saved-views-server-columns-value="<%= server_columns_json %>">
  <%# The button names the ACTIVE view (the one applied by URL, or the one matching the
      current state — shortcuts included); the icon fills in so it is signalled with the
      popover closed too. %>
  <%# Explicit aria-label, computed the same way as the visible text (which lives in a
      `hidden sm:inline` span): with a static label it would break "Label in Name" when the
      button names the active view. %>
  <%# `aria-haspopup`/`aria-expanded`: daisyUI's `:focus-within` is what opens the panel, not
      a JS, so without these the button announced neither that it opens a popover nor whether
      it is open. `syncPopoverAria` keeps them up to date from the controller. %>
  <button type="button" tabindex="0" class="btn btn-outline btn-sm gap-2" aria-label="<%= button_label %>"
          aria-haspopup="true" aria-expanded="false">
    <%= render Bali::Icon::Component.new(active_view ? 'bookmark-check' : 'bookmark', class: 'w-4 h-4') %>
    <span class="toolbar-control-label hidden sm:inline"><%= button_label %></span>
  </button>

  <div tabindex="0" class="dropdown-content z-[var(--bali-z-dropdown)] p-2 shadow-lg bg-base-100 rounded-box w-72 max-h-[70vh] overflow-y-auto border border-base-200">
    <% if default_views.any? %>
      <div class="menu-title px-2 pt-1"><%= t('.suggested_title') %></div>
      <ul class="menu p-0 w-full">
        <% default_views.each do |view| %>
          <li class="w-full"><%= link_to view.name, view.url,
                class: "text-sm #{active_item_class(view)}" %></li>
        <% end %>
      </ul>
    <% end %>

    <% if views.any? %>
      <div class="menu-title px-2 pt-1"><%= t('.mine_title') %></div>
      <ul class="menu p-0 w-full">
        <% views.each do |view| %>
          <li class="flex-row items-center flex-nowrap w-full">
            <%= link_to view.name, apply_url(view),
                  class: "grow text-sm truncate #{active_item_class(view)}" %>
            <button type="button" class="btn btn-ghost btn-xs px-1"
                    title="<%= t('.rename') %>"
                    data-action="saved-views#toggleRename" data-saved-views-id-param="<%= view.id %>">
              <%= render Bali::Icon::Component.new('pencil', class: 'w-3 h-3') %>
            </button>
            <%# `form_class: 'contents'` and not Rails' default `button_to`: the form is a
                direct child of a `.menu` <li>, and daisyUI styles `li > *` unless it is a
                `.btn`. The pencil beside it IS a `.btn` and is skipped; this form was not,
                so it collected a 46x36 box with its own hover against the pencil's 22x24,
                and stretched the row from 32px to 36px. Transparent, the trash button is
                the item and the two affordances match. %>
            <%= button_to view_url(view), method: :delete,
                  class: 'btn btn-ghost btn-xs px-1',
                  form_class: 'contents',
                  title: t('.delete'),
                  form: { data: { turbo_confirm: t('.delete_confirm', name: view.name) } } do %>
              <%= render Bali::Icon::Component.new('trash-2', class: 'w-3 h-3') %>
            <% end %>
          </li>
          <li class="hidden" data-saved-views-target="renameForm" data-saved-views-id="<%= view.id %>">
            <%# Explicit `builder:`: a form internal to the gem cannot change shape just because
                the host declares `default_form_builder = Bali::FormBuilder` (what
                docs/guides/installation.md recommends and what the group's six apps have on).
                Without it, `f.text_field` came out wrapped in a `div.control` with the `input`
                class repeated and `f.submit` as a `<button>`, losing the POST's `name="commit"`
                (#1137). The `data-disable-with` comes back with the `<input>` but does not count
                as an argument: rails-ujs reads it and none of the six apps has it. Moving these
                forms to the Bali builder's idiom is another discussion, set aside for v4 (#903). %>
            <%= form_with url: view_url(view), method: :patch, class: 'flex gap-1 p-1',
                  builder: ActionView::Helpers::FormBuilder do |f| %>
              <%# Explicit id per view: N rename forms + the save one generated N+1 duplicate
                  "name" ids (invalid HTML, confused autofill). %>
              <%= f.text_field :name, value: view.name, required: true,
                    id: "saved-view-name-#{view.id}",
                    class: 'input input-bordered input-xs grow' %>
              <%= f.submit t('.save'), class: 'btn btn-primary btn-xs' %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="border-t border-base-200 mt-1 pt-1">
      <%# With a modified origin view, UPDATING it is the expected action and saving another
          one becomes secondary. Before, the only way to overwrite was typing the exact name
          into "Guardar": nothing said so, and a typo created a new view instead of updating.
          It is destructive (it overwrites what was saved), so it confirms just like deleting. %>
      <% if updatable? %>
        <%# Explicit Rails builder, for the same reason as the rename form (#1137). %>
        <%= form_with url: view_url(origin_view), method: :patch,
              builder: ActionView::Helpers::FormBuilder,
              data: { action: 'submit->saved-views#injectColumns',
                      turbo_confirm: update_confirm } do |f| %>
          <%= f.hidden_field :payload, value: payload_json, data: { saved_views_target: 'payload' } %>
          <%= f.submit update_label, class: 'btn btn-primary btn-sm btn-block justify-start gap-2' %>
        <% end %>
      <% end %>
      <button type="button" class="btn btn-ghost btn-sm btn-block justify-start gap-2"
              data-action="saved-views#toggleSaveForm">
        <%= render Bali::Icon::Component.new('plus', class: 'w-4 h-4') %>
        <%= save_label %>
      </button>
      <%# Saves the CURRENT state: the payload travels serialized in a hidden field; the
          Stimulus controller adds the column selector's visible columns just before submitting. %>
      <div class="hidden p-1" data-saved-views-target="saveForm">
        <%# Explicit Rails builder, for the same reason as the rename form (#1137). %>
        <%= form_with url: url, method: :post, class: 'flex gap-1',
              builder: ActionView::Helpers::FormBuilder,
              data: { action: 'submit->saved-views#injectColumns' } do |f| %>
          <%= f.text_field :name, placeholder: t('.name_placeholder'), required: true,
                id: nil,
                class: 'input input-bordered input-sm grow' %>
          <%= f.hidden_field :payload, value: payload_json, data: { saved_views_target: 'payload' } %>
          <%= f.submit t('.save'), class: 'btn btn-primary btn-sm' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
