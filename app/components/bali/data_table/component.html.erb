<%= tag.div(**container_attributes) do %>
  <%# Toolbar: una sola fila agrupada por función — izquierda el ESTADO del listado y cómo se
      recuerda, derecha CÓMO se ve. Bajo el breakpoint el controlador `toolbar-overflow`
      MUEVE los controles secundarios al menú ⋯ (ver OVERFLOW_PRIORITIES) y los devuelve al
      subir. %>
  <% if show_toolbar? %>
    <%= tag.div(**toolbar_attributes) do %>
      <%# Izquierda, primer subgrupo: el CONTENIDO de la vista — qué filas y qué columnas.
          `flex-1` solo bajo `sm`: ahí la búsqueda tiene que llenar la fila, y arriba de `sm`
          es de ancho fijo (`sm:w-64`), así que creciendo empujaba la barrita y las vistas
          contra el view switch en vez de dejar el hueco donde va. %>
      <% if show_toolbar_left? %>
        <%= tag.div(**overflow_group_attributes("left", css_class: "flex items-center gap-1 sm:gap-2 flex-1 sm:flex-initial min-w-0")) do %>
          <%# Se pregunta por el CONTENIDO y no por el slot: un control declarado que decide no
              pintar (p.ej. vistas guardadas sin store) dejaba un envoltorio vacío que el JS
              movía al ⋯, destapando un botón que abre un menú vacío. %>
          <% if control_content(:filters_panel) || control_content(:simple_filters) %>
            <%= tag.div(**overflow_item_attributes(:filters, group: "left", css_class: "flex-1 min-w-0")) do %>
              <%= control_content(:filters_panel) %>
              <%= control_content(:simple_filters) %>
            <% end %>
          <% end %>

          <% if group_by_control? %>
            <%= tag.div(**overflow_item_attributes(:group_by, group: "left", css_class: "shrink-0")) do %>
              <%= render group_by_control %>
            <% end %>
          <% end %>

          <%# `shrink-0`: este grupo SÍ encoge (a diferencia del de la derecha), y sin esto el
              botón de columnas se aplasta en vez de dejar que la búsqueda absorba. %>
          <% if control_content(:column_selector) %>
            <%= tag.div(**overflow_item_attributes(:column_selector, group: "left", css_class: "shrink-0")) do %>
              <%= control_content(:column_selector) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%# Frontera entre "qué contiene la vista" y "cómo se recuerda". Va ENTRE los dos grupos
          y no adentro de uno: el JS ordena a los hijos de un grupo por prioridad y un nodo sin
          prioridad cuenta como 0, así que la barrita terminaba empujada al final de la fila ya
          en el primer render de escritorio. %>
      <% if toolbar_separator? %>
        <%= tag.div(**overflow_separator_attributes("left", "memory")) do %>
          <div class="divider divider-horizontal mx-0 h-6"></div>
        <% end %>
      <% end %>

      <%# Izquierda, segundo subgrupo: cómo se RECUERDA ese contenido — las vistas guardadas
          con nombre y el marcador que recuerda el último estado. %>
      <% if show_toolbar_memory? %>
        <%= tag.div(**overflow_group_attributes("memory", css_class: "flex items-center gap-1 sm:gap-2 shrink-0")) do %>
          <% if control_content(:saved_views) %>
            <%= tag.div(**overflow_item_attributes(:saved_views, group: "memory")) do %>
              <%= control_content(:saved_views) %>
            <% end %>
          <% end %>

          <% if filter_persistence_control? %>
            <%= tag.div(**overflow_item_attributes(:filter_persistence, group: "memory")) do %>
              <%= render filter_persistence_control %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%# Botones del host: contenido arbitrario que Bali no cubre, así que no son ni estado
          del listado ni modo de visualización. Grupo PROPIO y no adentro del de la derecha:
          ahí el JS ordena por prioridad descendente (10 contra 50) y quedaban a la derecha
          DEL view switch, que es lo único que puede ir pegado al borde. %>
      <% if show_toolbar_host? %>
        <%= tag.div(**overflow_group_attributes("host", css_class: "flex items-center gap-1 sm:gap-2 shrink-0")) do %>
          <% toolbar_buttons.each do |button| %>
            <%= tag.div(**overflow_item_attributes(:toolbar_buttons, group: "host")) do %>
              <%= button %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <%# Derecha: cómo se ven. `ml-auto` acá y no `flex-1` en la izquierda: el margen auto
          absorbe el espacio libre DESPUÉS de resolver grow/shrink, así que en móvil —donde la
          izquierda sí crece— es un no-op, y arriba de `sm` clava el switch contra el borde. %>
      <% if show_toolbar_right? %>
        <%= tag.div(**overflow_group_attributes("right", css_class: "flex items-center gap-1 sm:gap-2 shrink-0 ml-auto")) do %>
          <%= tag.div(**overflow_item_attributes(:view_switch, group: "right")) do %>
            <%= control_content(:view_switch) %>
          <% end %>
        <% end %>
      <% end %>

      <%# Menú ⋯: solo existe si hay algo que colapsar, y se sirve oculto — lo destapa el JS
          al mover el primer control adentro, así no parpadea un menú vacío. `sm:hidden` va
          en este div PLANO, sin la clase .dropdown compitiendo, así no hace falta la
          variante !important. %>
      <% if overflow_menu? %>
        <div class="shrink-0 hidden sm:hidden" data-toolbar-overflow-target="overflow">
          <%# `menu: false`: acá adentro no hay menuitems sino widgets enteros (otros
              dropdowns, checkboxes de columnas, el form de renombrar vistas). Declarado como
              `role="menu"` el lector de pantalla entra en modo menú sobre un formulario y
              expone hijos que ese rol no permite. Esto es un popover contenedor. %>
          <%= render Bali::Dropdown::Component.new(align: :bottom_end, wide: true, menu: false) do |dropdown| %>
            <% dropdown.with_trigger(variant: :ghost, class: "btn-sm btn-square",
                                     "aria-label": overflow_menu_label) do %>
              <%= render Bali::Icon::Component.new("ellipsis", class: "w-4 h-4") %>
            <% end %>
            <%# Sin la clase `.menu` de daisyUI el contenedor ya no impone display:grid +
                padding + hover a sus hijos, así que las utilidades van sin `!`.

                Los dropdowns que caen acá (columnas, vistas, agrupar) tienen contenido
                ABSOLUTO: anidados se posicionan contra este contenedor y se salen del
                viewport (medido: left -115px en un teléfono de 375px, cuando además eran
                `.dropdown-end`). En flujo quedan como secciones apiladas, que es lo
                razonable en un teléfono. Cerrados siguen siendo `display:none`, así que no
                dejan huecos. %>
            <div class="toolbar-overflow-menu
                        flex flex-col items-stretch gap-2 w-full p-1
                        max-w-[calc(100vw-3rem)] max-h-[70vh] overflow-y-auto
                        [&_.dropdown-content]:!static [&_.dropdown-content]:!w-full"
                 data-toolbar-overflow-target="menu"></div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# Fila contextual de selección: hermana inmediata de la toolbar, para caer en su mismo
      hueco vertical cuando el controlador se la esconde %>
  <%= bulk_actions if bulk_actions? %>

  <%# Custom summary slot (top position) or summary_position: :top %>
  <% if summary? || show_summary_top? %>
    <div class="mb-4 text-sm text-base-content/70">
      <%= summary? ? summary : default_summary_text %>
    </div>
  <% end %>

  <%# Contenido: la superficie viaja con el slot (with_table la trae, with_grid no) %>
  <%= content_band %>

  <%# Footer: Summary (left) + Pagination (right) %>
  <% if show_footer? %>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4 pt-4 border-t border-base-200">
      <%# Summary text %>
      <div class="text-sm text-base-content/70 order-2 sm:order-1">
        <% if show_summary_bottom? %>
          <%= default_summary_text %>
        <% end %>
      </div>

      <%# Pagination %>
      <% if pagy %>
        <div class="order-1 sm:order-2">
          <% if custom_pagy_nav? %>
            <%= custom_pagy_nav %>
          <% else %>
            <%= render Bali::Pagination::Component.new(pagy: pagy) %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
