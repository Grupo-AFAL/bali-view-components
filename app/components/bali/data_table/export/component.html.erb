<%# `export-links` re-syncs the hrefs from the browser URL: the link is served with the
    slice of the full page load, and a filters submit (which answers turbo_stream and
    replaces ONLY the listing node) can leave it frozen if this dropdown lives outside that
    node — which is exactly where it lives in the PageHeader's ⋯. %>
<div class="dropdown dropdown-end"
     data-controller="export-links"
     data-export-links-sync-value="<%= sync_links? %>">
  <%# Explicit aria-label: the visible label lives in a `hidden sm:inline` span (see the
      column selector). %>
  <button type="button" tabindex="0" class="btn btn-outline btn-sm gap-2" aria-label="<%= button_label %>">
    <%= render Bali::Icon::Component.new(button_icon, class: 'w-4 h-4') %>
    <span class="toolbar-control-label hidden sm:inline"><%= button_label %></span>
  </button>
  <ul tabindex="0" class="dropdown-content z-[var(--bali-z-dropdown)] menu p-2 shadow-lg bg-base-100 rounded-box w-40 border border-base-200">
    <% export_items.each do |item| %>
      <li>
        <%# `data-turbo="false"`: a CSV/XLSX is not a response Turbo Drive can render, so
            the visit stalls halfway instead of triggering the download. The Rails-UJS
            `method:` that used to be here emitted a `data-method="get"` that is dead under
            Turbo. %>
        <%= link_to item[:url], class: 'flex items-center gap-2',
                    data: { turbo: false, export_links_target: 'link' } do %>
          <%= render Bali::Icon::Component.new(item[:icon], class: 'w-4 h-4') %>
          <%= item[:label] %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
