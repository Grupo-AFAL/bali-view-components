<%= form_with url: @url, method: :get, builder: Bali::FormBuilder, data: { turbo_frame: "_top" } do |f| %>
  <%# Preserve top-level params (e.g. an active group_by) across the GET submit %>
  <% preserved_params.each do |name, value| %>
    <%= tag.input(type: "hidden", name: name, value: value) %>
  <% end %>
  <div class="flex flex-nowrap overflow-x-auto sm:flex-wrap gap-2 items-end py-1 pb-2 sm:pb-1 scrollbar-hide">
    <% if search_enabled? %>
      <div class="<%= search_width %> shrink-0">
        <div class="w-full <%= 'join' if search_icon %>">
          <%= icon_addon(search_icon) %>

          <%# Un buscador de texto no es un campo de credenciales: optamos por
              salir del autofill para que los gestores de contraseñas (1Password,
              LastPass, Dashlane) no ofrezcan login al enfocarlo. Aplica a todos
              los buscadores del DataTable; el name puede contener tokens como
              "name"/"email" (p. ej. q[name_or_email_cont]) que disparan su heurística. %>
          <%= tag.input(
                type: "text",
                id: search_input_id,
                name: search_field_name,
                value: search_value,
                placeholder: search_placeholder,
                "aria-label": search_label,
                autocomplete: "off",
                data: { "1p-ignore": "", lpignore: "true", "form-type": "other" },
                class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0' if search_icon}"
              ) %>
        </div>
      </div>
    <% end %>

    <% @filters.each do |filter| %>
      <div class="<%= (toggle_group?(filter) || radio_group?(filter)) ? '' : (number_range?(filter) ? 'w-auto' : 'w-auto sm:max-w-56') %> shrink-0">
        <%# Boolean filters already render their own inline label, so skip the caption there.
            The caption used to be a `<label>` with no `for`, which names nothing: it is a
            `<label for>` where there is a single control to point at, and a `<span>` naming a
            `role="group"` where the filter is really several controls. %>
        <% if filter[:label].present? && !boolean?(filter) %>
          <%= tag.send(
                multi_control?(filter) ? :span : :label,
                filter[:label],
                id: filter_label_id(filter),
                for: (filter_control_id(filter) unless multi_control?(filter)),
                title: filter[:label],
                class: "block text-xs font-medium text-base-content/60 mb-0.5 truncate"
              ) %>
        <% end %>
        <% group_attributes = if filter[:label].present? && multi_control?(filter)
                                { role: "group", "aria-labelledby": filter_label_id(filter) }
                              else
                                {}
                              end %>
        <% if toggle_group?(filter) %>
          <%# Hidden input to ensure the parameter is sent even when nothing is checked %>
          <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />

          <div class="join" <%= tag.attributes(group_attributes) %>>
            <% filter[:collection].each do |label, value| %>
              <%
                current_values = Array.wrap(filter[:value] || filter[:default]).map(&:to_s)
                is_checked = current_values.include?(value.to_s)
              %>
              <input type="checkbox"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= "checked" if is_checked %> />
            <% end %>
          </div>
        <% elsif radio_group?(filter) %>
          <div class="join" <%= tag.attributes(group_attributes) %>>
            <% filter[:collection].each do |label, value| %>
              <% current_value = (filter[:value] || filter[:default]).to_s %>
              <input type="radio"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= "checked" if current_value == value.to_s %> />
            <% end %>
          </div>
        <% elsif boolean?(filter) %>
          <label class="flex items-center gap-2 cursor-pointer px-1">
            <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />
            <input type="checkbox"
                   name="<%= filter_field_name(filter) %>"
                   value="true"
                   class="toggle toggle-sm toggle-primary"
                   <%= "checked" if (filter[:value] || filter[:default]).to_s == "true" %> />
            <span class="text-sm whitespace-nowrap"><%= filter[:label] %></span>
          </label>
        <% elsif number_range?(filter) %>
          <% names = number_range_field_names(filter) %>
          <% values = number_range_values(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <div class="flex items-center gap-1 <%= 'join-item' if filter[:icon] %>" <%= tag.attributes(group_attributes) %>>
              <input type="number"
                     name="<%= names[:min] %>"
                     value="<%= values[:min] %>"
                     placeholder="<%= filter[:placeholder_min] || t('.placeholder_min') %>"
                     class="input input-bordered input-sm w-20"
                     step="<%= filter[:step] || 'any' %>" />
              <span class="text-base-content/40 text-xs">–</span>
              <input type="number"
                     name="<%= names[:max] %>"
                     value="<%= values[:max] %>"
                     placeholder="<%= filter[:placeholder_max] || t('.placeholder_max') %>"
                     class="input input-bordered input-sm w-20"
                     step="<%= filter[:step] || 'any' %>" />
            </div>
          </div>
        <% elsif date_filter?(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%# Explicit id so the caption's `for` reaches it: off a Ransack param
                name Rails would derive `q[released_at_gteq]`, brackets and all. %>
            <%= f.date_field(
                  filter_field_name(filter),
                  id: filter_control_id(filter),
                  value: filter[:value] || filter[:default],
                  placeholder: filter[:placeholder] || filter[:label],
                  alt_input_class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0 max-sm:w-24 max-sm:px-1' if filter[:icon]}",
                  wrapper_options: { class: "flatpickr #{'grow' if filter[:icon]}" },
                  **({ mode: "range" } if date_range?(filter))
                ) %>
          </div>
        <% elsif slim_select?(filter) %>
          <%= f.slim_select_field(
                filter_field_name(filter),
                filter[:collection],
                include_blank: filter[:blank],
                selected: (filter[:value] || filter[:default]),
                size: :sm,
                content_width: SLIM_SELECT_CONTENT_WIDTH,
                addon_left: (render Bali::Icon::Component.new(filter[:icon], class: 'w-4 h-4') if filter[:icon]),
                html: { id: filter_control_id(filter), class: "w-full #{'max-sm:w-16' if filter[:icon]}", select_class: ('max-sm:w-16' if filter[:icon]) }
              ) %>
        <% else %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%= f.select(
              filter_field_name(filter),
              options_for_select(
                filter[:collection],
                filter[:value] || filter[:default]
              ),
              { include_blank: filter[:blank] },
              id: filter_control_id(filter),
              class: "select select-bordered select-sm w-full bg-none max-sm:pr-2 #{'join-item rounded-l-none border-l-0 max-sm:w-16 max-sm:px-1' if filter[:icon]}"
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-2 items-center shrink-0">
      <%= render Bali::Button::Component.new(
        name: apply_button_text,
        type: :submit,
        variant: :primary,
        size: :sm,
        icon: 'search',
        responsive: true
      ) %>

      <% if show_clear? %>
        <%= render Bali::Link::Component.new(
          name: clear_button_text,
          href: @url,
          variant: :ghost,
          size: :sm,
          icon: 'x',
          responsive: true
        ) %>
      <% end %>

      <%# Persistence toggle (bookmark icon). Dentro de un DataTable llega apagado: el
          marcador lo pinta la toolbar como control propio, fuera de este form. %>
      <% if persistence_toggle? %>
        <%= render Bali::Filters::PersistenceToggle::Component.new(
              storage_id: storage_id, enabled: persist_enabled?) %>
      <% end %>
    </div>
  </div>
<% end %>
