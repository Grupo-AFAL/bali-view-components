<%= form_with url: @url, method: :get, builder: Bali::FormBuilder, data: form_data_attributes do |f| %>
  <%# Preserve top-level params across the GET submit: el browser descarta el query de la
      action en un submit GET, así que tanto los params propios de la `url:` del host (un
      scope como `status=historico`) como los explícitos (`preserved_params`, p. ej. un
      `group_by` activo) se re-emiten como hidden fields — misma semántica que Filters. %>
  <%= preserved_params_hidden_fields %>
  <%# El scroll horizontal es del teléfono: arriba de `sm` la fila envuelve
      (`sm:flex-wrap`) y no scrollea nunca. Pero `overflow-x-auto` seguía puesto en todos
      los anchos, y eso hace de la fila un contenedor de scroll, que RECORTA en su caja de
      relleno — de ahí venía el `pb-1`: los 4px eran el lugar del anillo de foco del botón
      Filter, que se dibuja a `outline-offset: 2px` con `outline-width: 2px`.
      Esos mismos 4px desalineaban la fila. La toolbar del DataTable alinea por abajo, así
      que sus vecinos de una línea se apoyan en el borde inferior de ESTE bloque: el botón
      Filter quedaba 4px arriba del ⋯, medido en /admin/studios a 1900px.
      Devolviendo el overflow a `visible` arriba del breakpoint el anillo ya no se puede
      recortar, y sin nada que reservar el relleno de abajo se va: 0px de diferencia. Debajo
      de `sm` no cambia nada — sigue el scroll y sigue el `pb-2`. El `pt-1` tampoco se toca,
      que es el aire de las etiquetas. %>
  <div class="flex flex-nowrap overflow-x-auto sm:overflow-visible sm:flex-wrap gap-2 items-end pt-1 pb-2 sm:pb-0 scrollbar-hide">
    <% if search_enabled? %>
      <div class="<%= search_width %> shrink-0">
        <div class="w-full <%= 'join' if search_icon %>">
          <%= icon_addon(search_icon) %>

          <%# Un buscador de texto no es un campo de credenciales: optamos por
              salir del autofill para que los gestores de contraseñas (1Password,
              LastPass, Dashlane) no ofrezcan login al enfocarlo. Aplica a todos
              los buscadores del DataTable; el name puede contener tokens como
              "name"/"email" (p. ej. q[name_or_email_cont]) que disparan su heurística. %>
          <%= tag.input(
                type: "text",
                id: search_input_id,
                name: search_field_name,
                value: search_value,
                placeholder: search_placeholder,
                "aria-label": search_label,
                autocomplete: "off",
                data: { "1p-ignore": "", lpignore: "true", "form-type": "other" },
                class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0' if search_icon}"
              ) %>
        </div>
      </div>
    <% end %>

    <% @filters.each do |filter| %>
      <div class="<%= (toggle_group?(filter) || radio_group?(filter)) ? '' : (number_range?(filter) ? 'w-auto' : 'w-auto sm:max-w-56') %> shrink-0">
        <%# Boolean filters already render their own inline label, so skip the caption there.
            The caption used to be a `<label>` with no `for`, which names nothing: it is a
            `<label for>` where there is a single control to point at, and a `<span>` naming a
            `role="group"` where the filter is really several controls. %>
        <% if filter[:label].present? && !boolean?(filter) %>
          <%= tag.send(
                multi_control?(filter) ? :span : :label,
                filter[:label],
                id: filter_label_id(filter),
                for: (filter_control_id(filter) unless multi_control?(filter)),
                title: filter[:label],
                class: "block text-xs font-medium text-base-content/60 mb-0.5 truncate"
              ) %>
        <% end %>
        <% group_attributes = if filter[:label].present? && multi_control?(filter)
                                { role: "group", "aria-labelledby": filter_label_id(filter) }
                              else
                                {}
                              end %>
        <% if toggle_group?(filter) %>
          <%# Hidden input to ensure the parameter is sent even when nothing is checked %>
          <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />

          <div class="join" <%= tag.attributes(group_attributes) %>>
            <% filter[:collection].each do |label, value| %>
              <%
                current_values = Array.wrap(filter[:value] || filter[:default]).map(&:to_s)
                is_checked = current_values.include?(value.to_s)
              %>
              <input type="checkbox"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= tag.attributes(auto_submit_attributes(filter)) %>
                     <%= "checked" if is_checked %> />
            <% end %>
          </div>
        <% elsif radio_group?(filter) %>
          <div class="join" <%= tag.attributes(group_attributes) %>>
            <% filter[:collection].each do |label, value| %>
              <% current_value = (filter[:value] || filter[:default]).to_s %>
              <input type="radio"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= tag.attributes(auto_submit_attributes(filter)) %>
                     <%= "checked" if current_value == value.to_s %> />
            <% end %>
          </div>
        <% elsif boolean?(filter) %>
          <%# `h-8` — la altura de un control `-sm` — porque es el único filtro sin caption
              arriba, y la fila alinea por abajo (`items-end`): sin altura propia el switch se
              apoyaba en la línea del label ajeno en vez de en la de los controles. %>
          <label class="flex h-8 items-center gap-2 cursor-pointer px-1">
            <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />
            <input type="checkbox"
                   name="<%= filter_field_name(filter) %>"
                   value="true"
                   class="toggle toggle-sm toggle-primary"
                   <%= "checked" if (filter[:value] || filter[:default]).to_s == "true" %> />
            <span class="text-sm whitespace-nowrap"><%= filter[:label] %></span>
          </label>
        <% elsif number_range?(filter) %>
          <% names = number_range_field_names(filter) %>
          <% values = number_range_values(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%# `join-item` va sobre el CONTROL, no sobre el div que lo envuelve: daisyUI lo usa
                para recortar los bordes del elemento que une, y puesto en un contenedor de
                layout le quitaba el borde a los dos inputs — se veían sin marco hasta enfocarlos.
                El que se une al icono es el input Min, igual que en el buscador de arriba. %>
            <div class="flex items-center gap-1" <%= tag.attributes(group_attributes) %>>
              <input type="number"
                     name="<%= names[:min] %>"
                     value="<%= values[:min] %>"
                     placeholder="<%= filter[:placeholder_min] || t('.placeholder_min') %>"
                     class="input input-bordered input-sm w-20 <%= 'join-item rounded-l-none border-l-0' if filter[:icon] %>"
                     step="<%= filter[:step] || 'any' %>" />
              <span class="text-base-content/40 text-xs">–</span>
              <input type="number"
                     name="<%= names[:max] %>"
                     value="<%= values[:max] %>"
                     placeholder="<%= filter[:placeholder_max] || t('.placeholder_max') %>"
                     class="input input-bordered input-sm w-20"
                     step="<%= filter[:step] || 'any' %>" />
            </div>
          </div>
        <% elsif presets?(filter) %>
          <%# Un solo param, dos controles: el hidden es el ÚNICO con `name`, y el
              `time-period-field` le escribe el token del select o el rango del picker según
              cuál tocó el usuario. Dos inputs con el mismo name mandarían el param dos veces
              y el server se quedaría con el último, que no es necesariamente el que se ve.

              El controller es el mismo de `f.time_period_group`, con el centinela de
              "Personalizado…" pasado como value: ahí el vacío significa custom porque el
              widget no filtra nada; acá el vacío tiene que significar "sin filtro". %>
          <div class="flex items-end gap-1"
               data-controller="time-period-field"
               data-time-period-field-custom-value="<%= Bali::DateRangePresets::CUSTOM %>"
               data-time-period-field-date-input-container-class-value="flatpickr">
            <input type="hidden"
                   name="<%= filter_field_name(filter) %>"
                   value="<%= preset_current_value(filter) %>"
                   data-time-period-field-target="input" />

            <div class="<%= 'join' if filter[:icon] %>">
              <%= icon_addon(filter[:icon]) %>

              <%# `tag.select` y no `select_tag`/`f.select`: los dos emiten un `name` y este
                  control no manda nada — el hidden de arriba es el que viaja. %>
              <%= tag.select(
                    options_for_select(preset_options(filter), preset_select_value(filter)),
                    id: filter_control_id(filter),
                    class: "select select-bordered select-sm w-full bg-none max-sm:pr-2 #{'join-item rounded-l-none border-l-0 max-sm:w-16 max-sm:px-1' if filter[:icon]}",
                    data: {
                      "time-period-field-target": "select",
                      action: "time-period-field#toggleDateInput time-period-field#setInputValue"
                    }
                  ) %>
            </div>

            <%# `name: nil` deja al input sin atributo `name`, o sea fuera del submit.
                El `hidden` inicial va en el WRAPPER (`.flatpickr`), que es el que esconde el
                controller: con `alt_input` el input real ya está oculto y lo que se ve es el
                alt input que flatpickr crea a su lado, dentro de ese mismo wrapper. %>
            <%= f.date_field(
                  filter_field_name(filter),
                  name: nil,
                  id: "#{filter_control_id(filter)}-custom",
                  value: preset_custom_value(filter),
                  mode: "range",
                  placeholder: filter[:placeholder] || filter[:label],
                  "aria-label": filter[:label],
                  alt_input_class: "input input-bordered input-sm w-full",
                  wrapper_options: {
                    class: class_names("flatpickr", "hidden" => preset_select_value(filter) != Bali::DateRangePresets::CUSTOM)
                  },
                  data: {
                    "time-period-field-target": "dateInput",
                    action: "time-period-field#setInputValue"
                  }
                ) %>
          </div>
        <% elsif date_filter?(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%# Explicit id so the caption's `for` reaches it: off a Ransack param
                name Rails would derive `q[released_at_gteq]`, brackets and all. %>
            <%= f.date_field(
                  filter_field_name(filter),
                  id: filter_control_id(filter),
                  value: filter[:value] || filter[:default],
                  placeholder: filter[:placeholder] || filter[:label],
                  alt_input_class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0 max-sm:w-24 max-sm:px-1' if filter[:icon]}",
                  wrapper_options: { class: "flatpickr #{'grow' if filter[:icon]}" },
                  **({ mode: "range" } if date_range?(filter))
                ) %>
          </div>
        <% elsif slim_select?(filter) %>
          <%= f.slim_select_field(
                filter_field_name(filter),
                filter[:collection],
                include_blank: filter[:blank],
                selected: (filter[:value] || filter[:default]),
                size: :sm,
                content_width: SLIM_SELECT_CONTENT_WIDTH,
                # `icon_addon` y no el icono pelado: el addon entra tal cual dentro de un `join`,
                # y un <span> de 16px no se estira bajo `align-items: stretch`, así que este
                # icono quedaba flotando a media altura mientras los otros cinco filtros, que sí
                # usan el helper, alineaban con su control.
                addon_left: icon_addon(filter[:icon]),
                html: { id: filter_control_id(filter), class: "w-full #{'max-sm:w-16' if filter[:icon]}", select_class: ('max-sm:w-16' if filter[:icon]) }
              ) %>
        <% else %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%= f.select(
              filter_field_name(filter),
              options_for_select(
                filter[:collection],
                filter[:value] || filter[:default]
              ),
              { include_blank: filter[:blank] },
              id: filter_control_id(filter),
              class: "select select-bordered select-sm w-full bg-none max-sm:pr-2 #{'join-item rounded-l-none border-l-0 max-sm:w-16 max-sm:px-1' if filter[:icon]}",
              **auto_submit_attributes(filter)
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-2 items-center shrink-0">
      <%= render Bali::Button::Component.new(
        name: apply_button_text,
        type: :submit,
        variant: :primary,
        size: :sm,
        icon: 'search',
        responsive: true
      ) %>

      <% if show_clear? %>
        <%= render Bali::Link::Component.new(
          name: clear_button_text,
          href: clear_href,
          variant: :ghost,
          size: :sm,
          icon: 'x',
          responsive: true
        ) %>
      <% end %>

      <%# Persistence toggle (bookmark icon). Dentro de un DataTable llega apagado: el
          marcador lo pinta la toolbar como control propio, fuera de este form. %>
      <% if persistence_toggle? %>
        <%= render Bali::Filters::PersistenceToggle::Component.new(
              storage_id: storage_id, enabled: persist_enabled?) %>
      <% end %>
    </div>
  </div>
<% end %>
