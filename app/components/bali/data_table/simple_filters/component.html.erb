<%= form_with url: @url, method: :get, builder: Bali::FormBuilder, data: form_data_attributes do |f| %>
  <%# Preserve top-level params across the GET submit: the browser drops the action's query
      string on a GET submit, so both the host's own params from `url:` (a scope like
      `status=historico`) and the explicit ones (`preserved_params`, e.g. an active
      `group_by`) are re-emitted as hidden fields — same semantics as Filters. %>
  <%= preserved_params_hidden_fields %>
  <%# The horizontal scroll belongs to the phone: above `sm` the row wraps (`sm:flex-wrap`)
      and never scrolls. But `overflow-x-auto` was still set at every width, and that makes
      the row a scroll container, which CLIPS at its padding box — that is where the `pb-1`
      came from: the 4px were the room for the Filter button's focus ring, drawn at
      `outline-offset: 2px` with `outline-width: 2px`.
      Those same 4px misaligned the row. The DataTable toolbar aligns to the bottom, so its
      one-line neighbours rest on the bottom edge of THIS block: the Filter button sat 4px
      above the ⋯, measured on /admin/studios at 1900px.
      Returning the overflow to `visible` above the breakpoint means the ring can no longer
      be clipped, and with nothing to reserve, the bottom padding goes: 0px of difference.
      Below `sm` nothing changes — the scroll stays and so does the `pb-2`. The `pt-1` is not
      touched either; it is the breathing room for the captions. %>
  <div class="flex flex-nowrap overflow-x-auto sm:overflow-visible sm:flex-wrap gap-2 items-end pt-1 pb-2 sm:pb-0 scrollbar-hide">
    <% if search_enabled? %>
      <div class="<%= search_width %> shrink-0">
        <div class="w-full <%= 'join' if search_icon %>">
          <%= icon_addon(search_icon) %>

          <%# A text search box is not a credentials field: we opt out of
              autofill so password managers (1Password, LastPass, Dashlane) do
              not offer a login when it is focused. Applies to every DataTable
              search box; the name can contain tokens like "name"/"email"
              (e.g. q[name_or_email_cont]) that trigger their heuristics. %>
          <%= tag.input(
                type: "text",
                id: search_input_id,
                name: search_field_name,
                value: search_value,
                placeholder: search_placeholder,
                "aria-label": search_label,
                autocomplete: "off",
                data: { "1p-ignore": "", lpignore: "true", "form-type": "other" },
                class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0' if search_icon}"
              ) %>
        </div>
      </div>
    <% end %>

    <% @filters.each do |filter| %>
      <div class="<%= (toggle_group?(filter) || radio_group?(filter)) ? '' : (number_range?(filter) ? 'w-auto' : 'w-auto sm:max-w-56') %> shrink-0">
        <%# Boolean filters already render their own inline label, so skip the caption there.
            The caption used to be a `<label>` with no `for`, which names nothing: it is a
            `<label for>` where there is a single control to point at, and a `<span>` naming a
            `role="group"` where the filter is really several controls. %>
        <% if captioned?(filter) && !boolean?(filter) %>
          <%= tag.send(
                multi_control?(filter) ? :span : :label,
                filter_caption(filter),
                id: filter_label_id(filter),
                for: (filter_control_id(filter) unless multi_control?(filter)),
                title: filter_caption(filter),
                class: "block text-xs font-medium text-base-content/60 mb-0.5 truncate"
              ) %>
        <% end %>
        <% group_attrs = group_attributes(filter) %>
        <% if toggle_group?(filter) %>
          <%# Hidden input to ensure the parameter is sent even when nothing is checked %>
          <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />

          <div class="join" <%= tag.attributes(group_attrs) %>>
            <% filter[:collection].each do |label, value| %>
              <%
                current_values = Array.wrap(filter[:value] || filter[:default]).map(&:to_s)
                is_checked = current_values.include?(value.to_s)
              %>
              <input type="checkbox"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= tag.attributes(auto_submit_attributes(filter)) %>
                     <%= "checked" if is_checked %> />
            <% end %>
          </div>
        <% elsif radio_group?(filter) %>
          <div class="join" <%= tag.attributes(group_attrs) %>>
            <% filter[:collection].each do |label, value| %>
              <% current_value = (filter[:value] || filter[:default]).to_s %>
              <input type="radio"
                     name="<%= filter_field_name(filter) %>"
                     value="<%= value %>"
                     class="btn btn-sm join-item btn-outline border-base-content/20 checked:!bg-primary/10 checked:!text-primary checked:!border-primary"
                     aria-label="<%= label %>"
                     <%= tag.attributes(auto_submit_attributes(filter)) %>
                     <%= "checked" if current_value == value.to_s %> />
            <% end %>
          </div>
        <% elsif boolean?(filter) %>
          <%# `h-8` — the height of a `-sm` control — because it is the only filter with no
              caption above it, and the row aligns to the bottom (`items-end`): with no height
              of its own the switch rested on another filter's caption line instead of on the
              controls' line. %>
          <label class="flex h-8 items-center gap-2 cursor-pointer px-1">
            <input type="hidden" name="<%= filter_field_name(filter) %>" value="" />
            <%# The `<label>` wrapping the switch names it with the `<span>`'s text.
                With no caption there is no text: there the name goes as an `aria-label` on
                the input, and the `<span>` is not painted — it printed the word "false" (#1155). %>
            <input type="checkbox"
                   name="<%= filter_field_name(filter) %>"
                   value="true"
                   class="toggle toggle-sm toggle-primary"
                   <%= tag.attributes({ "aria-label": aria_label_for(filter) }.compact) %>
                   <%= "checked" if (filter[:value] || filter[:default]).to_s == "true" %> />
            <% if captioned?(filter) %>
              <span class="text-sm whitespace-nowrap"><%= filter_caption(filter) %></span>
            <% end %>
          </label>
        <% elsif number_range?(filter) %>
          <% names = number_range_field_names(filter) %>
          <% values = number_range_values(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%# `join-item` goes on the CONTROL, not on the div wrapping it: daisyUI uses it to
                clip the borders of the element it joins, and placed on a layout container it
                took the border off both inputs — they looked frameless until focused.
                The one joined to the icon is the Min input, same as in the search box above. %>
            <div class="flex items-center gap-1" <%= tag.attributes(group_attrs) %>>
              <input type="number"
                     name="<%= names[:min] %>"
                     value="<%= values[:min] %>"
                     placeholder="<%= filter[:placeholder_min] || t('.placeholder_min') %>"
                     class="input input-bordered input-sm w-20 <%= 'join-item rounded-l-none border-l-0' if filter[:icon] %>"
                     step="<%= filter[:step] || 'any' %>" />
              <span class="text-base-content/40 text-xs">–</span>
              <input type="number"
                     name="<%= names[:max] %>"
                     value="<%= values[:max] %>"
                     placeholder="<%= filter[:placeholder_max] || t('.placeholder_max') %>"
                     class="input input-bordered input-sm w-20"
                     step="<%= filter[:step] || 'any' %>" />
            </div>
          </div>
        <% elsif presets?(filter) %>
          <%# One param, two controls: the hidden field is the ONLY one with a `name`, and
              `time-period-field` writes into it either the select's token or the picker's
              range, depending on which one the user touched. Two inputs with the same name
              would send the param twice and the server would keep the last one, which is not
              necessarily the one on screen.

              The controller is the same one `f.time_period_group` uses, with the
              "Personalizado…" sentinel passed as a value: there an empty value means custom
              because the widget filters nothing; here an empty value has to mean "no filter". %>
          <div class="flex items-end gap-1"
               data-controller="time-period-field"
               data-time-period-field-custom-value="<%= Bali::DateRangePresets::CUSTOM %>"
               data-time-period-field-date-input-container-class-value="flatpickr">
            <input type="hidden"
                   name="<%= filter_field_name(filter) %>"
                   value="<%= preset_current_value(filter) %>"
                   data-time-period-field-target="input" />

            <div class="<%= 'join' if filter[:icon] %>">
              <%= icon_addon(filter[:icon]) %>

              <%# `tag.select` and not `select_tag`/`f.select`: both emit a `name` and this
                  control submits nothing — the hidden field above is the one that travels. %>
              <%= tag.select(
                    options_for_select(preset_options(filter), preset_select_value(filter)),
                    id: filter_control_id(filter),
                    "aria-label": (preset_select_accessible_name(filter) unless captioned?(filter)),
                    class: "select select-bordered select-sm w-full bg-none max-sm:pr-2 #{'join-item rounded-l-none border-l-0 max-sm:w-16 max-sm:px-1' if filter[:icon]}",
                    data: {
                      "time-period-field-target": "select",
                      action: "time-period-field#toggleDateInput time-period-field#setInputValue"
                    }
                  ) %>
            </div>

            <%# `name: nil` leaves the input with no `name` attribute, i.e. out of the submit.
                The initial `hidden` goes on the WRAPPER (`.flatpickr`), which is what the
                controller hides: with `alt_input` the real input is already hidden and what is
                seen is the alt input flatpickr creates beside it, inside that same wrapper. %>
            <%= f.date_field(
                  filter_field_name(filter),
                  name: nil,
                  id: "#{filter_control_id(filter)}-custom",
                  value: preset_custom_value(filter),
                  mode: "range",
                  placeholder: filter[:placeholder] || filter_caption(filter),
                  # The picker is a SECOND control of the same group and never has a
                  # `<label for>` — the caption points at the select — so its `aria-label` is
                  # always emitted. It came out with the string "false" under `label: false`
                  # (#1155), and later with the select's fallback ("Cualquier fecha"), which
                  # is the opposite of what the user opens this field to say.
                  "aria-label": preset_picker_accessible_name(filter),
                  alt_input_class: "input input-bordered input-sm w-full",
                  wrapper_options: {
                    class: class_names("flatpickr", "hidden" => preset_select_value(filter) != Bali::DateRangePresets::CUSTOM)
                  },
                  data: {
                    "time-period-field-target": "dateInput",
                    action: "time-period-field#setInputValue"
                  }
                ) %>
          </div>
        <% elsif date_filter?(filter) %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%# Explicit id so the caption's `for` reaches it: off a Ransack param
                name Rails would derive `q[released_at_gteq]`, brackets and all. %>
            <%= f.date_field(
                  filter_field_name(filter),
                  id: filter_control_id(filter),
                  value: filter[:value] || filter[:default],
                  placeholder: filter[:placeholder] || filter_caption(filter),
                  # With a caption the JS already solves it: `datepicker#forwardAccessibleName`
                  # copies the `label[for]` onto the altInput flatpickr creates beside it. With
                  # no caption there was nothing to copy and the altInput came out unnamed (#1155).
                  "aria-label": aria_label_for(filter),
                  alt_input_class: "input input-bordered input-sm w-full #{'join-item rounded-l-none border-l-0 max-sm:w-24 max-sm:px-1' if filter[:icon]}",
                  wrapper_options: { class: "flatpickr #{'grow' if filter[:icon]}" },
                  **({ mode: "range" } if date_range?(filter))
                ) %>
          </div>
        <% elsif slim_select?(filter) %>
          <%= f.slim_select_field(
                filter_field_name(filter),
                filter[:collection],
                include_blank: filter[:blank],
                selected: (filter[:value] || filter[:default]),
                size: :sm,
                content_width: SLIM_SELECT_CONTENT_WIDTH,
                # `icon_addon` and not the bare icon: the addon drops straight into a `join`,
                # and a 16px <span> does not stretch under `align-items: stretch`, so this
                # icon floated at mid-height while the other five filters, which do use the
                # helper, lined up with their control.
                addon_left: icon_addon(filter[:icon]),
                html: { id: filter_control_id(filter), class: "w-full #{'max-sm:w-16' if filter[:icon]}",
                        select_class: ('max-sm:w-16' if filter[:icon]), **slim_select_aria(filter) }
              ) %>
        <% else %>
          <div class="<%= 'join' if filter[:icon] %>">
            <%= icon_addon(filter[:icon]) %>

            <%= f.select(
              filter_field_name(filter),
              options_for_select(
                filter[:collection],
                filter[:value] || filter[:default]
              ),
              { include_blank: filter[:blank] },
              id: filter_control_id(filter),
              "aria-label": aria_label_for(filter),
              class: "select select-bordered select-sm w-full bg-none max-sm:pr-2 #{'join-item rounded-l-none border-l-0 max-sm:w-16 max-sm:px-1' if filter[:icon]}",
              **auto_submit_attributes(filter)
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="flex gap-2 items-center shrink-0">
      <%= render Bali::Button::Component.new(
        name: apply_button_text,
        type: :submit,
        variant: :primary,
        size: :sm,
        icon: 'search',
        responsive: true
      ) %>

      <% if show_clear? %>
        <%= render Bali::Link::Component.new(
          name: clear_button_text,
          href: clear_href,
          variant: :ghost,
          size: :sm,
          icon: 'x',
          responsive: true
        ) %>
      <% end %>

      <%# Persistence toggle (bookmark icon). Inside a DataTable it arrives off: the toolbar
          paints the bookmark as a control of its own, outside this form. %>
      <% if persistence_toggle? %>
        <%= render Bali::Filters::PersistenceToggle::Component.new(
              storage_id: storage_id, enabled: persist_enabled?) %>
      <% end %>
    </div>
  </div>
<% end %>
