<%# The canonical DataTable composition WITHOUT the page layer. `index_page/complete`
    renders this very same body inside a Bali::IndexPage — the two must not drift. %>
<%= render partial: 'bali/data_table/previews/canonical_index',
           locals: {
             url: request.path,
             filter_form: filter_form,
             pagy: pagy,
             movies: movies,
             display_mode: display_mode
           } %>
