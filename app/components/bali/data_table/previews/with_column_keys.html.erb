<%# The `id:` is stable on purpose: column persistence is ON here, under the key
    `bali:columns:keyed-demo`, which cypress/e2e/data-table-column-memory.cy.js seeds. %>
<% columns = [
     { key: :name, label: 'Name', cell: ->(record) { record[:name] } },
     ({ key: :region, label: 'Region', cell: ->(record) { record[:amount] > 1000 ? 'North' : 'South' } } if insert_region),
     { key: :status, label: 'Status', cell: ->(record) { record[:status].capitalize } },
     { key: :amount, label: 'Amount', cell: ->(record) { "$#{number_with_delimiter(record[:amount])}" } },
     { key: :created_at, label: 'Created At', cell: ->(record) { record[:created_at] } }
   ].compact %>
<%= render Bali::DataTable::Component.new(url: request.path, filter_form: filter_form,
                                          id: 'keyed-demo') do |c| %>
  <% c.with_filters_panel(available_attributes: filter_attributes) %>
  <% c.with_saved_views(url: '/preview/saved_views') %>

  <% c.with_column_selector do |cs| %>
    <% columns.each_with_index do |column, index| %>
      <% cs.with_column(index: index, label: column[:label], key: column[:key]) %>
    <% end %>
  <% end %>

  <% c.with_table do %>
    <%= render Bali::Table::Component.new do |ct| %>
      <%= ct.with_headers(columns.map { |column| { name: column[:label] } }) %>
      <% records.each do |record| %>
        <%= ct.with_row do %>
          <% columns.each do |column| %>
            <td><%= column[:cell].call(record) %></td>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
