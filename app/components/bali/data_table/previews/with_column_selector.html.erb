<%# The column selector over a GROUPED table: the composition where hiding a column used to
    delete the wrong cell (#1144). The group band and the empty state are the two rows that do
    NOT carry one cell per column, so the Nth `td` of those rows is not column N; the selector
    leaves them alone and hides only what really is a column.

    `persist: false` in all three: the preview shows the state just served and not the columns
    another visit left stored in localStorage.

    Explicit `id:` on each `Bali::Table` —besides the DataTable's—: without it the row ids and
    the band button's `aria-controls` hang off a random prefix. With three tables on the page,
    copying the example with no id is copying the defect. %>
<div class="p-4 space-y-8">
  <div>
    <h2 class="text-lg font-semibold">Grouped listing</h2>
    <p class="text-sm text-base-content/60">
      Uncheck "Initiative" in the Columns menu: the bands keep their row — including the
      folded "Proyecto asignado", with the button that unfolds it. Uncheck "Leader" and the
      totals row hides ITS cell, not the one next to it.
    </p>
  </div>

  <%= render Bali::DataTable::Component.new(url: request.path, id: 'grouped-columns') do |dt| %>
    <% dt.with_column_selector(persist: false) do |cs| %>
      <% cs.with_column(index: 0, label: 'Initiative') %>
      <% cs.with_column(index: 1, label: 'Area') %>
      <% cs.with_column(index: 2, label: 'Leader') %>
      <% cs.with_column(index: 3, label: 'Quadrant') %>
    <% end %>

    <% dt.with_table do %>
      <%= render Bali::Table::Component.new(id: 'grouped-initiatives',
                                            collapsible_groups: true,
                                            collapsed_groups: %w[in_project],
                                            group_label: ->(value) { stages.fetch(value) }) do |t| %>
        <%= t.with_headers(headers) %>
        <% records.each do |record| %>
          <%= t.with_row(group: record[:stage]) do %>
            <td class="font-medium"><%= record[:title] %></td>
            <td class="text-base-content/70"><%= record[:area] %></td>
            <td class="text-base-content/70"><%= record[:leader] %></td>
            <td><%= record[:quadrant] %></td>
          <% end %>
        <% end %>

        <%# The totals row is the OTHER row with `colspan`, and it lives in the `tfoot`,
            which the selector walks separately. The first cell spans two columns, so from
            here on the Nth cell is not column N either: the "Leader" summary is the SECOND
            cell of the row. The numbers come from the same `records` the table renders —
            nothing that can drift. %>
        <% t.with_footer do %>
          <td colspan="2" class="font-semibold"><%= records.count %> iniciativas</td>
          <td class="text-base-content/70"><%= records.pluck(:leader).uniq.count %> líderes</td>
          <td class="text-base-content/70"><%= records.pluck(:quadrant).uniq.count %> cuadrantes</td>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div>
    <h2 class="text-lg font-semibold">Grouped and selectable</h2>
    <p class="text-sm text-base-content/60">
      The composition the host apps actually ship (gobierno-corporativo): the band carries TWO
      cells — the group select-all in its own cell, then the band itself — so the index that
      lands on the band is 1, not 0.
    </p>
  </div>

  <%= render Bali::DataTable::Component.new(url: request.path, id: 'selectable-columns') do |dt| %>
    <%# With `selectable:` index 0 is the SELECTION COLUMN: the selector counts `thead th`
        and the select-all is the first one. The data columns start at 1. %>
    <% dt.with_column_selector(persist: false) do |cs| %>
      <% cs.with_column(index: 1, label: 'Initiative') %>
      <% cs.with_column(index: 2, label: 'Area') %>
      <% cs.with_column(index: 3, label: 'Leader') %>
      <% cs.with_column(index: 4, label: 'Quadrant') %>
    <% end %>

    <% dt.with_bulk_actions do |bulk| %>
      <% bulk.with_action(label: 'Archive', href: '/initiatives/bulk_archive', variant: :info) %>
    <% end %>

    <% dt.with_table do %>
      <%= render Bali::Table::Component.new(id: 'selectable-initiatives', selectable: true,
                                            collapsible_groups: true,
                                            collapsed_groups: %w[in_project],
                                            group_label: ->(value) { stages.fetch(value) }) do |t| %>
        <%= t.with_headers(headers) %>
        <% records.each_with_index do |record, index| %>
          <%= t.with_row(group: record[:stage], record_id: index + 1, select_label: record[:title]) do %>
            <td class="font-medium"><%= record[:title] %></td>
            <td class="text-base-content/70"><%= record[:area] %></td>
            <td class="text-base-content/70"><%= record[:leader] %></td>
            <td><%= record[:quadrant] %></td>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div>
    <h2 class="text-lg font-semibold">The same selector with no results</h2>
    <p class="text-sm text-base-content/60">
      The empty state is a single cell spanning the whole table, on a row that carries no
      class of its own: hiding a column used to delete the message.
    </p>
  </div>

  <%= render Bali::DataTable::Component.new(url: request.path, id: 'empty-columns') do |dt| %>
    <% dt.with_column_selector(persist: false) do |cs| %>
      <% cs.with_column(index: 0, label: 'Initiative') %>
      <% cs.with_column(index: 1, label: 'Area') %>
      <% cs.with_column(index: 2, label: 'Leader') %>
      <% cs.with_column(index: 3, label: 'Quadrant') %>
    <% end %>

    <% dt.with_table do %>
      <%= render Bali::Table::Component.new(id: 'empty-initiatives') do |t| %>
        <%= t.with_headers(headers) %>
      <% end %>
    <% end %>
  <% end %>
</div>
