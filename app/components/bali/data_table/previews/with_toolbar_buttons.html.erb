<%= render Bali::DataTable::Component.new(url: request.path, id: 'toolbar-demo') do |c| %>
  <%# Filters with search %>
  <% c.with_filters_panel(
       available_attributes: filter_attributes,
       search: {
         fields: [:name],
         placeholder: 'Search products...'
       }
     ) %>

  <%# Column selector - declarative API %>
  <% c.with_column_selector do |cs| %>
    <% cs.with_column(index: 0, label: 'Name') %>
    <% cs.with_column(index: 1, label: 'Status') %>
    <% cs.with_column(index: 2, label: 'Amount') %>
    <% cs.with_column(index: 3, label: 'Created At') %>
  <% end %>

  <%# Host buttons: arbitrary content, last in the survival order (collapses into the ⋯
      first). A button placed here must have an idempotent connect(): below the breakpoint the
      overflow controller MOVES it, and moving a node fires disconnect + connect. %>
  <% c.with_toolbar_button do %>
    <%= render Bali::Button::Component.new(name: 'Import', variant: :ghost, size: :sm,
                                           icon: 'upload', responsive: false) %>
  <% end %>

  <% c.with_table do %>
    <%# No `id:`: the listing's identity lives in the DataTable (`#toolbar-demo table`). %>
    <%= render Bali::Table::Component.new do |ct| %>
      <%= ct.with_headers(headers) %>
      <% records.each do |record| %>
        <%= ct.with_row do %>
          <td><%= record[:name] %></td>
          <td>
            <%= render Bali::Tag::Component.new(
                  text: record[:status].capitalize,
                  color: { 'active' => :success, 'pending' => :warning }[record[:status]],
                  size: :sm
                ) %>
          </td>
          <td class="text-right font-mono">$<%= number_with_delimiter(record[:amount]) %></td>
          <td class="text-sm text-base-content/70"><%= record[:created_at] %></td>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
