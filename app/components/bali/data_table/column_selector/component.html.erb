<%# No `dropdown-end`: the control lives in the LEFT group of the toolbar, and anchored to
    the right edge of its trigger the panel opened outside the row it belongs to. %>
<div class="dropdown"
     data-controller="column-selector"
     data-column-selector-table-value="<%= table_selector %>"
     data-column-selector-storage-key-value="<%= persist? ? columns_storage_key : '' %>"
     data-column-selector-server-state-value="<%= server_state? %>">
  <%# Explicit aria-label: the visible label lives in a `hidden sm:inline` span, so until the
      JS moves the control into the ⋯ the button is an icon with no accessible name. %>
  <%# `aria-haspopup`/`aria-expanded`: the panel is opened by daisyUI's `:focus-within`, not by
      JS, so without this the button announced neither that it opens a popover nor whether it
      is open. `syncPopoverAria` keeps it up to date from the controller. %>
  <button type="button" tabindex="0" class="btn btn-outline btn-sm gap-2" aria-label="<%= button_label %>"
          aria-haspopup="true" aria-expanded="false">
    <%= render Bali::Icon::Component.new(button_icon, class: 'w-4 h-4') %>
    <span class="toolbar-control-label hidden sm:inline"><%= button_label %></span>
  </button>
  <ul tabindex="0" class="dropdown-content z-[var(--bali-z-dropdown)] menu p-2 shadow-lg bg-base-100 rounded-box w-52 border border-base-200">
    <li class="menu-title"><%= menu_title %></li>
    <% columns.each do |column| %>
      <li>
        <label class="label cursor-pointer justify-start gap-3">
          <input type="checkbox"
                 <%= 'checked' if column.visible %>
                 class="checkbox checkbox-sm checkbox-primary"
                 data-action="column-selector#toggle"
                 data-column-index="<%= column.index %>" />
          <span class="label-text"><%= column.label %></span>
        </label>
      </li>
    <% end %>
  </ul>
</div>
