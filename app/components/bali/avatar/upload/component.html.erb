<%= tag.div class: 'inline-flex flex-col items-center gap-1', data: { controller: 'avatar' } do %>
  <%= tag.div class: 'relative' do %>
    <%= render Bali::Avatar::Component.new(**avatar_options) do |avatar| %>
      <% avatar.with_picture(image_url: @src || '', data: { avatar_target: 'output' }) %>
    <% end %>

    <%= tag.div class: button_classes do %>
      <%= tag.label class: label_classes do %>
        <%= raw_file_field %>
        <%= render Bali::Icon::Component.new('camera') %>
      <% end %>
    <% end %>
  <% end %>
  <%= error_message %>
<% end %>
