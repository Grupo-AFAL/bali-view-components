<%# THE HERO is not a narrower card, it is a different one: no header, and the
    whole tile is one link — but ONLY when there is somewhere to go. A nil
    `view_all_path` is a legitimate state on every pattern, and `href="#"` would
    make the card look clickable while doing nothing.

    NOTHING inside here may be focusable. A `small` tile supports exactly one tap
    target, which is why the trend renders as text and never as a control.

    Handled as its own branch rather than a third arm of the layout below,
    because the captures there build the headline, the context AND the detail
    eagerly — including a whole `Bali::Chart` — and a hero shows none of them. %>
<% if hero? %>
  <% hero_content = capture do %>
    <%= headline %>
    <div class="stat-title mt-1 whitespace-normal text-sm leading-tight"><%= short_title %></div>
    <%= hero_footer %>
  <% end %>
  <% if view_all_path.present? %>
    <%= link_to view_all_path, class: 'stat flex-1 place-content-center p-0 text-center' do %>
      <%= hero_content %>
    <% end %>
  <% else %>
    <div class="stat flex-1 place-content-center p-0 text-center"><%= hero_content %></div>
  <% end %>

<% else %>
  <%# EVERY OTHER SIZE. The headline stays — that is the whole point of the
      ladder — and the canvas decides how much sits beside and beneath it. %>
  <% context_region = capture do %>
    <%# `min-w-0` as well as `min-h-0`: a flex item's default `min-width:auto`
        refuses to shrink below its content, and a responsive canvas measures its
        parent — so without this the chart pushes through the card's right edge
        instead of fitting inside it. %>
    <% if context? %>
      <div class="<%= context_classes %>"><%= context %></div>
    <% end %>
  <% end %>

  <%# The wrapper carries the hook class and the flex sizing; whatever is inside
      just fills. Hiding the list directly cannot work — daisyUI's `.list` sets
      `display` from `@layer utilities`, which beats anything Bali puts in
      `@layer components` regardless of specificity. %>
  <% detail_region = capture do %>
    <div class="bali-widget-detail flex min-h-0 flex-1 flex-col overflow-hidden">
      <% if detail_content.present? %>
        <%= detail_content %>
      <% elsif empty_state? %>
        <p class="flex-1 place-content-center text-center text-sm text-base-content/40">
          <%= empty_message %>
        </p>
      <% end %>
    </div>
  <% end %>

  <%= render Bali::PageHeader::Component.new do |c| %>
    <% c.with_title(title, tag: :h5) %>

    <%# `Bali::Link` rather than a bare `link_to`: its base class is already
        `link inline-flex items-center gap-1` and `icon_right` puts the chevron
        after the label. %>
    <% if view_all_link? %>
      <%= render Bali::Link::Component.new(
            name: t('bali_view.widgets.view_all', count: count),
            href: view_all_path,
            class: 'text-sm text-base-content/60 hover:text-primary no-underline') do |c| %>
        <% c.with_icon_right('chevron-right', class: 'w-3 h-3') %>
      <% end %>
    <% end %>
  <% end %>

  <% if stacked? %>
    <%# LARGE: fact, then chart, then breakdown. %>
    <div class="flex min-h-0 flex-1 flex-col gap-2">
      <%= headline %>
      <%= context_region %>
      <%= detail_region if detail? %>
    </div>
  <% else %>
    <%# MEDIUM: fact on the left, chart or breakdown on the right. There is room
        for the headline and ONE of them, and the chart wins — a widget with a
        series is saying its movement is the context worth showing. %>
    <div class="flex min-h-0 flex-1 items-center gap-4">
      <div class="shrink-0"><%= headline %></div>
      <%= context_region %>
      <%= detail_region if detail? %>
    </div>
  <% end %>
<% end %>
