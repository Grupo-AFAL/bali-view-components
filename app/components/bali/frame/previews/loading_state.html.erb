<%# [busy] forced by hand to see the placeholder without a backend answering the
    src. Live, Turbo sets and clears [busy] on its own. %>
<div class="frame-loader">
  <div class="frame-loading">
    <div class="flex items-center justify-center gap-2 py-6 text-sm text-base-content/60">
      <span class="loading loading-spinner loading-sm"></span> Loading…
    </div>
  </div>
  <turbo-frame id="frame-preview-busy" busy>
    <div class="p-4">This content is hidden while the frame is [busy].</div>
  </turbo-frame>
</div>
