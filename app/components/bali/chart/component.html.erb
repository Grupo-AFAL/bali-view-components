<% if render_card? %>
  <div class="<%= card_classes %>">
    <div class="card-body">
      <% if title %>
        <h3 class="card-title text-base font-semibold text-base-content"><%= title %></h3>
      <% end %>
      <%= tag.div(class: container_classes, **container_options) do %>
        <%= tag.canvas(**canvas_attributes) do %>
          <span class="loading loading-spinner loading-md text-primary"></span>
        <% end %>
      <% end %>
      <% if data_table? %>
        <div class="chart-fallback-table"><%= data_table %></div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="<%= wrapper_classes %>">
    <% if title %>
      <h3 class="text-base font-semibold text-base-content mb-3"><%= title %></h3>
    <% end %>
    <%= tag.div(class: container_classes, **container_options) do %>
      <%= tag.canvas(**canvas_attributes) do %>
        <span class="loading loading-spinner loading-md text-primary"></span>
      <% end %>
    <% end %>
    <% if data_table? %>
      <div class="chart-fallback-table"><%= data_table %></div>
    <% end %>
  </div>
<% end %>
