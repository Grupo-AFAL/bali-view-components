<div class='mb-6'>
  <p class='title'>Line Chart Multi Axis</p>

  <%= render Bali::Chart::Component.new(
      type: 'line', data: {
        labels: ['Jan', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul'],
        datasets: [
          {
            label: 'Dataset 1',
            data: 7.times.map { |_| [Random.rand(-100..100), Random.rand(-100..100)]},
            tension: 0,
             yAxisID: 'y',
          }, {
            label: 'Dataset 2',
            data: 7.times.map { |_| [Random.rand(-100..100), Random.rand(-100..100)]},
            tension: 0,
            yAxisID: 'y1',
          }
        ]
      },
      options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        stacked: false,
        plugins: {
          title: {
            display: true,
            text: 'Chart.js Line Chart'
          }
        },
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',

            grid: {
              drawOnChartArea: false
            }
          }
        }
      }
  ) %>
</div>

