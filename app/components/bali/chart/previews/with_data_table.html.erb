<%
  labels = Bali::Chart::Preview::WEEKLY_DATA[:labels]
  datasets = Bali::Chart::Preview::WEEKLY_DATA[:datasets]
%>

<%= render Bali::Chart::Component.new(
      data: Bali::Chart::Preview::WEEKLY_DATA,
      type: :bar,
      title: 'Weekly Sales Report',
      legend: true,
      card_style: :default
    ) do |c| %>
  <% c.with_data_table do %>
    <table>
      <caption>Weekly sales and returns</caption>
      <thead>
        <tr>
          <th scope="col">Day</th>
          <% datasets.each do |dataset| %>
            <th scope="col"><%= dataset[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% labels.each_with_index do |label, index| %>
          <tr>
            <th scope="row"><%= label %></th>
            <% datasets.each do |dataset| %>
              <td><%= dataset[:data][index] %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<p class="text-sm text-base-content/70 mt-4">
  The table above is in the DOM, visually hidden. Open the accessibility tree to
  see it: the canvas is one <code>img</code> named "Weekly Sales Report", and the
  table beside it is where the numbers live. It is also the chart's no-JS
  fallback — disable JavaScript and the table takes the graph's place instead of
  a container-height hole (#1067).
</p>
