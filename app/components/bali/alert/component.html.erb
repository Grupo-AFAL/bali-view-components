<%# The body is a <div>, not a <span>: a list or a paragraph inside a <span> is
    block-in-inline, invalid HTML the browser paints anyway (#1120). The alert is a
    grid and its column a flex column, so the wrapper's own display never reached
    the layout — a <div> draws the same for a one-liner and takes any content. %>
<%= tag.div(role: role, **options) do %>
  <% if icon? %>
    <%= render Bali::Icon::Component.new(icon_name, size: :small) %>
  <% end %>
  <% if title.present? || header? %>
    <div class="flex flex-col gap-1">
      <% if title.present? %>
        <span class="font-bold"><%= title %></span>
      <% elsif header? %>
        <%= header %>
      <% end %>
      <div><%= content %></div>
    </div>
  <% else %>
    <div><%= content %></div>
  <% end %>
  <% if closable? %>
    <%= render close_button %>
  <% end %>
<% end %>
