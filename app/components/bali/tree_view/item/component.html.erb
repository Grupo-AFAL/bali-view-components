<%= tag.li(**wrapper_options) do %>
  <div class="<%= item_classes %>">
    <% if items? %>
      <%= tag.button(**caret_options) do %>
        <%= render Bali::Icon::Component.new('chevron-right', size: :small) %>
      <% end %>
    <% else %>
      <span class="<%= caret_classes %>" aria-hidden="true"></span>
    <% end %>
    <%= link_to name, path, title: name, class: 'flex-1 truncate hover:underline' %>
  </div>

  <% if items? %>
    <%= tag.ul(id: children_id, class: children_classes, data: children_data) do %>
      <% items.each do |item| %>
        <%= item %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
