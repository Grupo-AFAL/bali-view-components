<%# The popover's frame (#1512). Its links leave the frame (`target="_top"` on the frame), and the
    stream below hands the icon the numbers this request just computed. %>
<%= tag.turbo_frame(id: Bali::Topbar::Inbox::Component::POPOVER_FRAME_ID, target: "_top") do %>
  <%= turbo_stream.update Bali::Topbar::Inbox::Component::BADGE_FRAME_ID do %>
    <%= render Bali::Topbar::Inbox::Badge::Component.new(badge: @badge) %>
  <% end %>

  <div class="bali-inbox-popover-header">
    <span class="font-semibold"><%= t("bali_view.inbox.title") %></span>
    <%= link_to url_for(action: :show), class: "btn btn-ghost btn-xs btn-square",
                title: t("bali_view.inbox.expand"), aria: { label: t("bali_view.inbox.expand") } do %>
      <%= render Bali::Icon::Component.new("maximize-2", class: "size-4") %>
    <% end %>
  </div>

  <%= render Bali::Tabs::Component.new(style: :border, size: :sm, class: "bali-inbox-popover-tabs-live") do |tabs| %>
    <% tabs.with_tab(title: t("bali_view.inbox.tabs.pending"), count: @badge.pending, active: true) do %>
      <%= render "popover_pending" %>
    <% end %>
    <% tabs.with_tab(title: [ t("bali_view.inbox.tabs.notices"), (t("bali_view.inbox.tabs.unread", count: @badge.unread) if @badge.unread?) ].compact.join(" · "),
                     src: url_for(action: :popover, tab: "notices")) do %>
      <div class="flex flex-col gap-3 p-4">
        <%= render Bali::Skeleton::Component.new(variant: :text, lines: 2) %>
        <%= render Bali::Skeleton::Component.new(variant: :text, lines: 2) %>
      </div>
    <% end %>
  <% end %>
<% end %>
