<div class="flex flex-wrap items-center gap-2">
  <% if item.href.present? %>
    <%= render Bali::Link::Component.new(name: t("bali_view.inbox.detail.open"), href: inbox_open_item_url(item),
                                         variant: :primary, data: { turbo_prefetch: "false", turbo_frame: "_top" }) %>
  <% end %>
  <%= render Bali::Clipboard::Component.new(class: "max-w-xs") do |clipboard| %>
    <%# Its left corners are square for the source it sits beside, hidden here. `square:` because
        the text comes as a block, which the trigger does not see when it guesses icon-only. %>
    <% clipboard.with_trigger(square: false, class: "rounded-l-lg whitespace-nowrap",
                              "aria-label": t("bali_view.inbox.detail.copy")) do %>
      <%= render Bali::Icon::Component.new("link", class: "size-4") %>
      <span><%= t("bali_view.inbox.detail.copy") %></span>
    <% end %>
    <% clipboard.with_success_content do %>
      <%= render Bali::Icon::Component.new("check", class: "size-4") %>
      <span><%= t("bali_view.inbox.detail.copied") %></span>
    <% end %>
    <%# sr-only, not hidden: the controller copies its innerText, which a display:none node does not have. %>
    <% clipboard.with_source(url_for(action: :item, kind: item.kind, gid: item.gid, only_path: false), class: "sr-only") %>
  <% end %>
</div>
