<% if @items.empty? %>
  <div class="p-6">
    <%= render Bali::EmptyState::Component.new(title: t("bali_view.inbox.empty.title"), icon: "circle-check") do |empty| %>
      <% if @badge.unread? %>
        <% empty.with_cta do %>
          <%= render Bali::Link::Component.new(name: t("bali_view.inbox.empty.notices", count: @badge.unread),
                                               href: url_for(action: :show, tab: "notices"), variant: :link) %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <% @items.group_by(&:band).each do |band, items| %>
    <section aria-labelledby="bali-inbox-band-<%= band %>">
      <h3 id="bali-inbox-band-<%= band %>" class="<%= class_names("px-4 pt-3 pb-1 text-xs font-semibold", inbox_band_color(band)) %>">
        <%= inbox_band_label(band) %> · <%= items.size %>
      </h3>
      <% items.each do |item| %>
        <% fresh = inbox_fresh?(item, @fresh) %>
        <%= link_to inbox_open_item_url(item),
              class: class_names("bali-inbox-popover-row relative flex items-start gap-3 px-4 py-2.5 hover:bg-base-200", "is-fresh": fresh),
              data: { turbo_prefetch: "false" } do %>
          <%# _notice_row's unread dot, for the notice folded into this item. In the row's left padding:
              beside the icon it would take 20px from the title at 390px. %>
          <% if fresh %>
            <span class="bali-inbox-popover-dot absolute left-1 top-[1.375rem] size-2 rounded-full bg-primary" aria-hidden="true"></span>
          <% end %>
          <span class="flex size-8 shrink-0 items-center justify-center rounded-field bg-base-200" aria-hidden="true">
            <%= render Bali::Icon::Component.new(inbox_item_icon(item), class: "size-4") %>
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="text-sm font-semibold leading-snug wrap-break-word"><%= item.title %></span>
            <% if fresh %><span class="sr-only">, <%= t("bali_view.inbox.fresh") %></span><% end %>
            <span class="text-xs text-base-content/70">
              <%= inbox_kind_label(item.kind) %> · <%= inbox_module_label(item.module_key) %>
            </span>
          </span>
          <%# The Spanish due text for two months overdue is 191px at text-xs. Uncapped, it left a
              title 77px and four lines at 390px wide; capped, the title gets 138px and two. %>
          <span class="flex max-w-[40%] shrink-0 flex-col items-end gap-1 text-right">
            <span class="text-xs <%= item.overdue? ? "text-error" : "text-base-content/70" %>"><%= inbox_due_text(item) %></span>
          </span>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <div class="flex items-center justify-between border-t border-base-300 px-4 py-3 text-sm">
    <span class="text-base-content/70"><%= t("bali_view.inbox.footer.pending", count: @badge.pending, number: inbox_count(@badge.pending)) %></span>
    <%= render Bali::Link::Component.new(name: t("bali_view.inbox.footer.see_all"), href: url_for(action: :show), variant: :link) %>
  </div>
<% end %>
